# ---------------------------------------------------------------------------------------------------

def apply_stop_session(env, tx, data):
    state = read_state(env) or {'main_user': data.get('main_user') or MAIN_USER, 'release': 'releases/none'}
    return Session(env, tx.journal, state).stop_logic(data.get('root'), data.get('host'))


# What a session writes to keep Guest from Bluetooth and a few system services while it runs (native-pads.py). The
# session removes its own at a stop; one that a hard restart wiped out cannot. Its name carries the session's id.
BUS_POLICY_DIR = '/etc/dbus-1/system.d'
BUS_POLICY_NAME = re.compile(r'dosplex-[a-f0-9]{32}-guest-no-bluez\.conf')
# One policy for one account that only denies: every release wrote that, in changing words.
BUS_POLICY_TEXT = re.compile(
    r'\s*<!DOCTYPE busconfig [^>]*>\s*(?:<!--.*?-->\s*)*<busconfig>\s*<policy user="[a-z_][a-z0-9_-]{0,31}">\s*'
    r'(?:(?:<deny [^<>]*/>|<!--.*?-->)\s*)+</policy>\s*</busconfig>\s*', re.S)


def apply_remove_bus_policies(env, tx, data):
    """Uninstall, after the session is stopped: remove the policy files that sessions left on the system bus, so
    that the Guest account, if it stays, is an ordinary account again. Only a file with DosPlex's name that is
    exactly such a policy goes; anything else stays. Idempotent."""
    folder = env.path(BUS_POLICY_DIR)
    removed = []
    if folder.is_dir() and not os.path.islink(folder):
        for entry in sorted(folder.iterdir()):
            if not BUS_POLICY_NAME.fullmatch(entry.name):
                continue
            try:
                info = os.lstat(entry)
                if not stat.S_ISREG(info.st_mode) or info.st_size > 4096 or \
                        not BUS_POLICY_TEXT.fullmatch(entry.read_text()):
                    continue
            except (OSError, UnicodeDecodeError):
                continue
            env.allow_write(entry)
            if env.unlink(entry):
                removed.append(entry.name)
    if removed:
        try:
            env.run(BUS_RELOAD, check=False, timeout=10)
        except DosplexError:
            pass                # the files are gone; the bus reads its configuration again at the next start
    return {'removed': removed}


def apply_remove_state(env, tx, data):
    env.unlink(env.var / 'state.json')
    if env.var.is_dir():
        for entry in sorted(env.var.glob('.state.json.new-*')):
            env.unlink(entry)
    # The controllers' owners and numbers (CONTROLLERS_DIR): its files go, never a folder inside it, and the folder
    # itself only when that emptied it.
    controllers = env.var / 'controllers'
    if controllers.is_dir() and not os.path.islink(controllers):
        for entry in sorted(controllers.iterdir()):
            if not entry.is_dir() or os.path.islink(entry):
                env.unlink(entry)
        with contextlib.suppress(OSError):
            os.rmdir(controllers)
    return {}


def apply_remove_display_record(env, tx, data):
    env.unlink(env.var / 'display-mode.json')
    return {}


def apply_remove_cli(env, tx, data):
    bin_dir = env.opt / 'bin'
    if bin_dir.is_dir():
        for entry in sorted(bin_dir.iterdir()):
            if entry.name in ('dosplex', PREVIOUS_CLI) or entry.name.startswith(STAGED_CLI_PREFIXES):
                env.unlink(entry)
    return {}


def apply_remove_current(env, tx, data):
    link = env.opt / 'current'
    if os.path.islink(link):
        env.unlink(link)
    elif lexists(link):
        raise DosplexError('%s is not a symlink; it is left in place' % link)
    if env.opt.is_dir():
        for entry in sorted(env.opt.glob('.current.new-*')):
            env.unlink(entry)
    return {}


def apply_remove_release(env, tx, data):
    if not VERSION_RE.fullmatch(data['version']):
        raise DosplexError('refusing to remove a release named %r' % data['version'])
    env.rmtree(env.opt / 'releases' / data['version'])
    return {}


def apply_remove_staging(env, tx, data):
    releases = env.opt / 'releases'
    if releases.is_dir():
        for entry in sorted(releases.iterdir()):
            if entry.name.startswith(STAGING_PREFIX):
                env.rmtree(entry)
    return {}


def apply_remove_opt(env, tx, data):
    cleanup_opt(env)
    left = sorted(p.name for p in env.opt.iterdir()) if env.opt.is_dir() else []
    return {'left_in_place': left}


def apply_guest_exit(env, tx, data):
    """Keep Guest (the default) or, after an interactive confirmation, remove the account and its home."""
    if data['action'] == 'none':
        return {'action': 'none'}
    fact = {key: data.get(key) for key in ('user', 'uid', 'gid', 'home', 'origin')}
    if data['action'] == 'keep':
        entry = user_entry(env, GUEST_USER)
        before = data.get('home_mode_before')
        if (data.get('origin', '').startswith('adopted') and before is not None and entry is not None
                and entry.uid == data['uid'] and entry.home == data['home']):
            home = env.path(entry.home)
            env.allow_write(home)
            try:
                if stat.S_IMODE(os.lstat(home).st_mode) == 0o700:
                    os.chmod(home, before)
            except OSError:
                pass
        return dict(fact, action='kept')
    if data.get('confirmed_home') != data['home']:
        raise DosplexError('removing Guest was not confirmed')
    entry = user_entry(env, GUEST_USER)
    if entry is not None:
        if entry.uid != data['uid'] or entry.home != data['home']:
            raise DosplexError('the guest account is not the one that was confirmed; nothing was removed')
        wait_for_guest_to_leave(env, entry.uid)
        remove_guest_account(env, entry)
    else:
        remove_guest_home(env, data['home'], data['uid'])
    return dict(fact, action='removed')


UNINSTALL_APPLY = {
    'remove-autostart': apply_remove_autostart, 'remove-entry': apply_remove_entry, 'stop-session': apply_stop_session,
    'remove-bus-policies': apply_remove_bus_policies, 'remove-state': apply_remove_state,
    'remove-display-record': apply_remove_display_record, 'remove-cli': apply_remove_cli,
    'remove-current': apply_remove_current, 'guest': apply_guest_exit, 'remove-release': apply_remove_release,
    'restore-guest-group': apply_restore_guest_group, 'remove-staging': apply_remove_staging,
    'remove-opt': apply_remove_opt,
}


def guest_fact(journal, state):
    """What DosPlex knows about Guest, from the installed state or else from the journal history."""
    if state and state.get('guest'):
        return state['guest']
    return journal.history() if journal is not None else None


def build_uninstall_plan(env, state, fact, remove_guest, confirmed_home):
    plan = []
    if state is not None:
        plan.append({'step': 'remove-autostart', 'data': {}})     # first: a restart in the middle must not start DosPlex
        plan.append({'step': 'remove-entry', 'data': {}})         # and nobody may start it from Steam's library meanwhile
        plan.append({'step': 'stop-session', 'data': {
            'root': (state.get('trial') or {}).get('root'), 'host': state.get('session'),
            'main_user': state.get('main_user')}})
        plan.append({'step': 'remove-bus-policies', 'data': {}})  # after the stop: what crashed sessions left behind
        plan.append({'step': 'remove-display-record', 'data': {}})
        plan.append({'step': 'remove-state', 'data': {}})
    guest_steps = []
    if fact:
        data = dict(fact, action='remove' if remove_guest else 'keep', confirmed_home=confirmed_home)
        guest_steps.append({'step': 'guest', 'data': data})
        if not remove_guest:        # an account that is going away needs nothing put back
            for group in fact.get('stripped_groups') or []:
                guest_steps.append({'step': 'restore-guest-group:' + group,
                                    'data': {'user': GUEST_USER, 'uid': fact['uid'], 'group': group}})
    if remove_guest:
        # Guest goes while the program is still installed: when it cannot be removed, `repair` has to exist.
        plan += guest_steps
    plan += [{'step': 'remove-cli', 'data': {}}, {'step': 'remove-current', 'data': {}}]
    if not remove_guest:
        plan += guest_steps
    releases = env.opt / 'releases'
    versions = sorted(e.name for e in releases.iterdir() if VERSION_RE.fullmatch(e.name)) if releases.is_dir() else []
    plan += [{'step': 'remove-release:' + v, 'data': {'version': v}} for v in versions]
    plan += [{'step': 'remove-staging', 'data': {}}, {'step': 'remove-opt', 'data': {}}]
    return plan


def worker_uninstall(env, opts):
    journal = Journal.open(env, lock=True)
    if journal is None:
        raise DosplexError('there is no DosPlex journal; nothing to uninstall')
    with journal:
        journal.require_clean()
        state = read_state(env)
        fact = guest_fact(journal, state)
        remove = bool(opts.get('remove_guest'))
        plan = build_uninstall_plan(env, state, fact, remove, opts.get('confirmed_home'))
        tx = journal.begin('uninstall', remove_guest=remove, confirmed_home=opts.get('confirmed_home'), plan=plan)
        try:
            complete_plan(env, tx, UNINSTALL_APPLY)
        except BaseException as error:
            if isinstance(error, GuestRunning):
                # The program is still installed at this point, so the command named here exists.
                message = ('uninstall stopped: %s To finish the uninstall now and keep Guest, run: sudo dosplex repair'
                           % error)
            else:
                message = 'uninstall stopped (%s). Run: sudo dosplex repair' % error
            tx.error(message)
            raise DosplexError(message) from error
        guest = tx.steps().get('guest', {}).get('result', {})
        clear = finish_uninstall(env, tx, guest)
        tx.end('complete', guest=guest, clear_var=clear)
    return 0


STEAM_SETTING_MARKERS = ('native-external-resolution', 'resolution-native-*')


def has_steam_setting_marker(env, account):
    """Whether the start of a side switched on a Steam setting for this account (see dosplex-steam-resolution-default.py)."""
    folder = env.path(account.home) / '.local/share/dosplex'
    try:
        return any(True for pattern in STEAM_SETTING_MARKERS for _ in folder.glob(pattern))
    except OSError:
        return False


def uninstall_leftovers(env, tx, guest):
    """What an uninstall leaves on the machine, one sentence or two each. Only reads; whatever cannot be read is
    left out, so this never fails an uninstall."""
    lines = []
    steps = {item['step']: item['data'] for item in tx.plan}
    main = user_entry(env, steps.get('stop-session', {}).get('main_user') or MAIN_USER)
    with contextlib.suppress(Exception):
        if main is not None and steam_library_has_dosplex(env, main):
            lines.append("Steam's library still lists DosPlex. Remove it in Steam: Library, Non-Steam, DosPlex, Manage, "
                         "Remove non-Steam game from your library.")
    with contextlib.suppress(Exception):
        if lexists(env.path(GAME_STORE_ROOT)):
            lines.append('The shared library folder %s stays. It holds no games and you may delete it.' % GAME_STORE_ROOT)
    with contextlib.suppress(Exception):
        accounts = [main] if main is not None else []
        if guest.get('action') == 'kept':
            accounts.append(user_entry(env, GUEST_USER))
        if any(has_steam_setting_marker(env, account) for account in accounts if account is not None):
            lines.append('Two Steam settings that DosPlex switched on stay as they are: Maximum Game Resolution (Native) '
                         'and Enable Native Resolution on External Displays. Change them in Steam if you want.')
    return lines


def perf_recordings(env):
    """Whether /var/lib/dosplex/perf holds recordings: the player's own files, which an uninstall never deletes."""
    perf = env.var / 'perf'
    try:
        return perf.is_dir() and not perf.is_symlink() and any(True for _ in perf.iterdir())
    except OSError:
        return False


def finish_uninstall(env, tx, guest):
    """The closing notes of an uninstall. Returns whether the command that ran it then clears /var/lib/dosplex.

    That folder holds the journal this very transaction is written to, and the command reads the notes back from
    it, so it cannot go before the transaction has ended: the command does it afterwards (clear_dosplex_folder).
    A kept Guest keeps it: the journal is the record that DosPlex created Guest."""
    tx.note('DosPlex is uninstalled.')
    left = tx.steps().get('remove-opt', {}).get('result', {}).get('left_in_place')
    if left:
        tx.note('Left in /opt/dosplex because dosplex did not put it there: %s' % ', '.join(left))
    back = [name.split(':', 1)[1] for name, step in tx.steps().items()
            if name.startswith('restore-guest-group:') and step['status'] == 'done' and step['result'].get('restored')]
    if back:
        tx.note('Guest was put back into the groups it was taken out of: %s.' % ', '.join(back))
    action = guest.get('action')
    if action == 'kept' and guest.get('origin') == 'adopted-foreign':
        tx.note("Guest's account and home were left as they were: %s (DosPlex did not create them)" % guest['home'])
    elif action == 'kept':
        tx.note("Guest's account and home were kept: %s" % guest['home'])
        # The installed program is gone when this is read: the one of a release does it.
        tx.note('To remove them later, take the dosplex program out of a release archive as for an install and run: '
                'sudo ./dosplex-VERSION/dosplex uninstall --remove-guest')
    elif action == 'removed':
        tx.note("Guest's account and home were removed: %s" % guest['home'])
    for line in uninstall_leftovers(env, tx, guest):
        tx.note(line)
    if action == 'kept' and guest.get('origin') != 'adopted-foreign':
        tx.note("DosPlex's settings and its record that it created Guest stay in /var/lib/dosplex. They go away when "
                "you remove Guest.")
        return False
    if action == 'kept':
        tx.note("DosPlex's settings and its record of what it changed stay in /var/lib/dosplex; nothing uses them now, "
                "delete the folder if you like.")
        return False
    if perf_recordings(env):
        tx.note('Your performance recordings stay in /var/lib/dosplex/perf. The rest of that folder is removed.')
    return True


def clear_dosplex_folder(env, created):
    """After an uninstall that ended and was printed: remove /var/lib/dosplex but a non-empty perf/. Never fails."""
    if created is None or created.outcome != 'complete' or not created.records[-1].get('clear_var'):
        return
    try:
        journal = Journal.open(env, lock=True)
        if journal is None:
            return
        with journal:
            if journal.interrupted() is not None:
                return
            keep = 'perf' if perf_recordings(env) else None
            for entry in sorted(env.var.iterdir()):
                if entry.name != keep:
                    env.rmtree(entry)
        env.rmdir_if_empty(env.var)
    except (OSError, DosplexError) as error:
        say('Could not remove /var/lib/dosplex (%s). Delete the folder if you like.' % error)


# ---------------------------------------------------------------------------------------------------
# repair: complete or roll back what a crash left open
# ---------------------------------------------------------------------------------------------------

def worker_repair(env, opts):
    journal = Journal.open(env, lock=True)
    if journal is None:
        say('Nothing to repair.')
        return 0
    with journal:
        interrupted = journal.interrupted()
        if interrupted is None:
            say('Nothing to repair.')
            return 0
        tx = journal.reopen(interrupted)
        if not tx.records:
            print('Repairing the empty journal file %s.' % tx.name, flush=True)
            tx.end('rolled-back', note='empty journal file', repaired=True)
            return 0
        tx.note('Repairing the interrupted %s (%s).' % (tx.op, tx.name))
        handler = {'install': repair_install, 'update': repair_update, 'rollback': repair_rollback,
                   'uninstall': repair_uninstall, 'start': repair_start, 'stop': repair_stop,
                   'library': repair_library, 'autostart': repair_autostart, 'entry': repair_entry}.get(tx.op)
        if handler is None:
            raise DosplexError('do not know how to repair a %s' % tx.op)
        try:
            handler(env, journal, tx)
        except BaseException as error:
            if not tx.ended:
                tx.error('repair stopped: %s' % error)
            raise
        warn_if_release_changed(env, tx)
    return 0


def repair_release_change(env, tx, apply_table, undo_table):
    """An interrupted install, update or rollback: finish it once its commit record is on disk, else undo it.

    If finishing fails, it is undone as well, so that the device ends up whole in either case.
    """
    what = tx.op
    if tx.committed:
        tx.append('repair', action='roll-forward')
        try:
            complete_plan(env, tx, apply_table)
            tx.note('The %s was completed.' % what)
            try:
                running = what != 'install' and trial_status(env, read_state(env))['alive']
            except DosplexError:
                running = False
            if running:
                tx.note('DosPlex keeps running the release it started with. Use %s now with: sudo dosplex stop, then '
                        'sudo dosplex start' % ('the new release' if what == 'update' else 'the earlier release'))
            tx.end('complete', repaired=True)
            return
        except BaseException as error:
            tx.note('The %s could not be completed (%s); rolling it back.' % (what, error))
    else:
        tx.append('repair', action='rollback')
    rollback(env, tx, undo_table)
    cleanup_opt(env)
    tx.note('The %s was rolled back; the device is as it was before.' % what)
    tx.end('rolled-back', repaired=True)


def repair_install(env, journal, tx):
    repair_release_change(env, tx, INSTALL_APPLY, INSTALL_UNDO)


def repair_update(env, journal, tx):
    repair_release_change(env, tx, UPDATE_APPLY, UPDATE_UNDO)


def repair_rollback(env, journal, tx):
    repair_release_change(env, tx, ROLLBACK_APPLY, ROLLBACK_UNDO)


def repair_uninstall(env, journal, tx):
    tx.append('repair', action='roll-forward')
    skipped = None
    for item in tx.plan:
        step = item['step']
        if step == 'guest' and item['data'].get('action') == 'remove' and tx.status(step) not in ('done', 'skipped'):
            tx.skip(step, 'removing Guest needs a fresh confirmation')
    complete_plan(env, tx, UNINSTALL_APPLY)
    guest = tx.steps().get('guest', {}).get('result', {})
    for item in tx.plan:
        if item['step'] == 'guest' and tx.status('guest') == 'skipped':
            skipped = dict(item['data'], action='kept')
            guest = {key: skipped.get(key) for key in ('user', 'uid', 'gid', 'home', 'origin')}
            guest['action'] = 'kept'
    if skipped:
        tx.note('Guest was not removed: removing it needs a new confirmation.')
    clear = finish_uninstall(env, tx, guest)
    tx.end('complete', guest=guest, repaired=True, clear_var=clear)


def repair_start(env, journal, tx):
    state = read_state(env)
    if state is None:
        raise DosplexError('DosPlex is not installed; cannot repair a start')
    tx.append('repair', action='rollback')
    session = Session(env, journal, state)
    session.tx = tx
    session.rollback_start(tx)
    tx.note('The interrupted start was undone; Steam is back to normal.')
    tx.end('rolled-back', repaired=True)


def repair_stop(env, journal, tx):
    state = read_state(env)
    if state is None:
        raise DosplexError('DosPlex is not installed; cannot repair a stop')
    tx.append('repair', action='roll-forward')
    session = Session(env, journal, state)
    session.tx = tx
    apply = lambda data: session.stop_logic(data['root'], data['host'])
    status = tx.status('stop-session')
    if status == 'intent':
        tx.redo('stop-session', apply)
    elif status != 'done':
        tx.run('stop-session', {'root': tx.begin.get('root'), 'host': state.get('session')}, apply)
    tx.note('The interrupted stop was finished.')
    tx.end('complete', repaired=True)


def warn_if_release_changed(env, tx):
    try:
        state = read_state(env)
        if state:
            verify_directory(env.opt / state['release'], state['manifest_sha256'], installed_uid=env.trusted_uid)
    except DosplexError as error:
        tx.note('Warning: the installed release no longer matches its manifest (%s). Reinstall it.' % error)


