def installed_program(env):
    installed = env.opt / 'bin' / 'dosplex'
    return installed if installed.is_file() else own_path()


def launch_worker(env, op, options):
    """Run `op` as a transient system service, so that an ssh logout cannot kill it, and wait for it.

    Returns (the new journal file or None, the systemd-run result)."""
    program = installed_program(env)
    if program is None:
        raise DosplexError('cannot find the dosplex program to run in the background')
    # The background service cannot tell anyone that another operation holds the journal, so say it here.
    busy = Journal.open(env, lock=True)
    if busy is not None:
        busy.close()
    journal = Journal.open(env)
    before = set(journal.names()) if journal is not None else set()
    if journal is not None:
        journal.close()
    unit = 'dosplex-%s-%s' % (op, uuid.uuid4().hex[:8])
    command = ['systemd-run', '--quiet', '--collect', '--wait', '--expand-environment=no', '--unit=' + unit,
               '--property=RuntimeMaxSec=1500', '--description=DosPlex ' + op, '--', env.python, str(program),
               '--sysroot', str(env.sysroot),
               '_worker', op, json.dumps(options, sort_keys=True)]
    proc = env.run(command, check=False, timeout=1800)
    journal = Journal.open(env)
    created = None
    if journal is not None:
        with journal:
            fresh = sorted(set(journal.names()) - before)
            created = journal.load(fresh[-1]) if fresh else None
    return created, proc


def finish_worker(env, op, created, proc):
    for line in created.notes() if created is not None else ():
        say(line)
    if created is not None and created.outcome == 'complete':
        if op == 'uninstall':
            clear_dosplex_folder(env, created)
        return 0
    if created is not None and created.ended:
        raise DosplexError('%s did not finish: %s' % (op, created.records[-1].get('error') or created.outcome))
    if created is not None and created.errors():
        raise DosplexError(created.errors()[-1])
    detail = (proc.stderr or '').strip().splitlines()
    raise DosplexError('%s did not finish%s. See: sudo dosplex status, and journalctl -u dosplex-%s-*' % (
        op, ' (' + detail[-1] + ')' if detail else '', op))


def cmd_version(env, args):
    say('dosplex %s' % CLI_VERSION)
    try:
        state = read_state(env)
    except DosplexError as error:
        say('release: unknown (%s)' % error)
        return 1
    if state:
        say('release %s (manifest %s)' % (state['version'], state['manifest_sha256']))
    else:
        say('release: not installed')
    return 0


def cmd_status(env, args):
    info = collect_status(env)
    say(json.dumps(info, indent=2, sort_keys=True) if args.json else format_status(info))
    return 0


def cmd_preflight(env, args):
    manifest, hids = None, None
    if args.bundle or args.release:
        if args.bundle and args.release:
            raise UsageError('give either a BUNDLE directory or --release ARCHIVE, not both')
        if args.bundle and not args.manifest:
            raise UsageError('give the approved manifest digest with --manifest')
        if args.signature and not args.release:
            raise UsageError('--signature goes with --release')
        verified, _ = load_installable(args)
        manifest = verified.manifest
    else:
        state = read_state(env)
        if state:
            manifest = verify_directory(env.opt / state['release'], state['manifest_sha256'],
                                        installed_uid=env.trusted_uid).manifest
    hids = requested_hids(env, args.main_hid, args.guest_hid)
    report = preflight(env, manifest, op='check', user=args.main_user, hids=hids, sample_seconds=args.sample_seconds)
    if manifest is not None:
        missing = missing_required(manifest)
        report.add('bundle', 'fail' if missing else 'ok',
                   missing_message(missing) if missing else 'version %s, commit %s' % (manifest.version, manifest.commit[:9]))
    receivers = list_receivers(env)
    if receivers:
        report.add('receivers', 'info', ', '.join(receivers))
    refused = bool(report.failures()) or (bool(report.untested()) and not args.allow_untested)
    if args.json:
        say(json.dumps(dict(report.as_json(), refused=refused), indent=2, sort_keys=True))
    else:
        say(report.text())
        if report.untested() and manifest is None:
            say('No manifest was given, so there is no tested set to compare with.')
        say('Result: %s' % ('refused' if refused else 'ready'))
    return RefusedError.exit_code if refused else 0


def check_current(env, state):
    """/opt/dosplex/current has to name the release the state says is installed."""
    if current_version(env) != state['version']:
        raise DosplexError('/opt/dosplex/current does not point at release %s, which is the one installed. '
                          'Install it again.' % state['version'])


def start_layout(args):
    """(layout, boot) a start asks for. --boot is what the boot unit runs: Main alone on the full screen."""
    boot = bool(getattr(args, 'boot', False))
    layout = getattr(args, 'layout', None)
    if boot and layout not in (None, 'single'):
        raise UsageError('--boot starts with Main alone on the full screen, so --layout %s does not go with it' % layout)
    return ('single' if boot else layout or 'vertical'), boot


def boot_in_desktop_mode(env):
    """True when the device is in Desktop mode: a start at boot then leaves it alone (it never changes the mode)."""
    state = read_state(env)
    account = user_entry(env, state['main_user']) if state else None
    return account is not None and host_mode(env, account) == 'desktop'


def wait_for_display(env, seconds=None, poll=BOOT_DISPLAY_POLL_SECONDS, sleep=None, clock=None):
    """A start at boot waits for a connected display: a TV that is still waking up shows none for a while (CLI-04).

    Returns whether one is connected when it stops looking; the preflight then says what is wrong if none is, and the
    boot start ends without changing anything, so stock Steam stays as it is. `sleep` and `clock` are for tests."""
    sleep, clock = sleep or time.sleep, clock or time.monotonic
    if seconds is None:
        seconds = BOOT_DISPLAY_SECONDS
        if not env.real and os.environ.get('DOSPLEX_TEST_DISPLAY_SECONDS'):
            seconds = float(os.environ['DOSPLEX_TEST_DISPLAY_SECONDS'])
    deadline = clock() + seconds
    while not any(d['status'] == 'connected' for d in connected_displays(env)):
        if clock() >= deadline:
            return False
        sleep(poll)
    return True


def plan_start(env, args):
    """Everything `start` checks before it launches the background service; prints nothing.

    Returns (worker options, status of the trial), and (None, status) when DosPlex already runs."""
    env.require_root()
    args.output_mode = check_output_mode(args.output_mode)
    boot = bool(getattr(args, 'boot', False))
    journal = Journal.open(env)
    if journal is not None:
        with journal:
            tx = journal.interrupted()
            own = boot and tx is not None and tx.op == 'start' and bool(tx.begin.get('boot'))
            if not own:
                journal.require_clean()
    else:
        tx, own = None, False
    if own:
        # A start at boot that was cut short (a shutdown during its wait, say) is cleared by the steps `repair` runs
        # for it, so that the next boot is not refused until somebody opens a terminal (CLI-02).
        say('An earlier start at boot was interrupted (%s). Undoing it first.' % tx.name)
        launch_worker(env, 'repair', {})
        journal = Journal.open(env)
        with journal:
            journal.require_clean()
    state = read_state(env)
    if state is None:
        raise NotInstalled('DosPlex is not installed. Run: sudo dosplex install BUNDLE --manifest SHA256%s'
                          % (' (it replaces the DuplOS install that is on this device)'
                             if lexists(env.path(LEGACY_OPT)) or lexists(env.path(LEGACY_VAR)) else ''))
    check_current(env, state)
    verified = verify_directory(env.opt / state['release'], state['manifest_sha256'], installed_uid=env.trusted_uid)
    layout, boot = start_layout(args)
    requested = requested_hids(env, args.main_hid, args.guest_hid)
    # A start needs no controller. Remembered slots count only while they still name a receiver slot.
    hids, notes = usable_hids(env, state, requested)
    probe = trial_status(env, state)
    if probe['alive']:
        return None, probe
    target = output_target(env)
    if target['kind'] == 'builtin':
        check_panel_mode(target, args.output_mode)
    if boot:
        wait_for_display(env)
    report = preflight(env, verified.manifest, op='start', user=state['main_user'], hids=hids, sample_seconds=0)
    unattended = boot or bool(getattr(args, 'unattended', False))
    start_acceptance(report, state, bool(args.allow_untested), unattended)
    for note in notes:
        say(note)
    options = {'hids': hids, 'remember': requested is not None, 'layout': layout, 'boot': boot,
               'unattended': unattended,
               'allow_untested': bool(args.allow_untested),
               'output_mode': list(args.output_mode) if args.output_mode else None,
               'sample_seconds': args.sample_seconds, 'keep_on_failure': bool(getattr(args, 'keep_on_failure', False))}
    return options, probe


def running_version(root):
    """The release name of the session that runs under this trial root, as its own bundle states it, or None."""
    try:
        with open(Path(root) / 'bundle' / 'share' / 'dosplex' / 'VERSION', encoding='utf-8') as source:
            name = source.read(200).strip()
    except (OSError, ValueError):
        return None
    return name if name and '\n' not in name else None


def say_already_running(env, probe):
    say('DosPlex is already running (%s).' % probe['root'])
    running = running_version(probe['root'])
    installed = (read_state(env) or {}).get('version')
    if running and installed and running != installed:
        # An install over a session that runs (seen on the Steam Machine): the session goes on with what it
        # was started with, and nothing said so.
        say('It still runs %s, the release it was started with. To use %s: sudo %s stop, then sudo %s start'
            % (running, installed, env.opt / 'bin' / 'dosplex', env.opt / 'bin' / 'dosplex'))


def start_client(env, args):
    if getattr(args, 'boot', False) and boot_in_desktop_mode(env):
        say('DosPlex does not start at boot in Desktop mode; Steam is left as it is.')
        return 0
    options, probe = plan_start(env, args)
    if options is None:
        say_already_running(env, probe)
        return 0
    say('Starting DosPlex. This takes up to %s; it keeps going if you close this terminal.'
        % ('five minutes' if options['boot'] else 'two minutes'))
    created, proc = launch_worker(env, 'start', options)
    return finish_worker(env, 'start', created, proc)


def cmd_start(env, args):
    return start_client(env, args)


def cmd_stop(env, args):
    env.require_root()
    journal = Journal.open(env)
    if journal is not None:
        with journal:
            journal.require_clean()
    if read_state(env) is None:
        say('DosPlex is not installed.')
        return 0
    created, proc = launch_worker(env, 'stop', {})
    if created is None and proc.returncode == 0:
        say('DosPlex is not running.')
        return 0
    return finish_worker(env, 'stop', created, proc)


def cmd_repair(env, args):
    env.require_root()
    journal = Journal.open(env)
    if journal is None:
        say('Nothing to repair.')
        return 0
    with journal:
        pending = journal.interrupted()
        known = len(pending.records) if pending is not None else 0
    if pending is None:
        say('Nothing to repair.')
        return 0
    _, proc = launch_worker(env, 'repair', {})
    journal = Journal.open(env)
    with journal:
        reloaded = journal.load(pending.name)
        for line in reloaded.notes(known):
            say(line)
        left = journal.interrupted()
    if left is None and reloaded.op == 'uninstall':
        clear_dosplex_folder(env, reloaded)
    if left is not None:
        reasons = reloaded.errors(known) or (proc.stderr or '').strip().splitlines()
        raise DosplexError('the interrupted %s (%s) is still open%s' % (
            left.op, left.name, ': ' + reasons[-1] if reasons else '; see: journalctl -u dosplex-repair-*'))
    return 0


def confirm_remove_guest(env, home):
    path = str(env.path(home))
    if not env.interactive():
        raise DosplexError('removing Guest asks you to type its path, so it needs a terminal. '
                          'Run it in a terminal, not from a script.')
    say("This permanently deletes Guest's home directory and everything in it,")
    say("including Guest's Steam library and saves:")
    say('    %s' % path)
    say('Type that path to confirm, or anything else to cancel:')
    reply = (sys.stdin.readline() if not sys.stdin.isatty() else input('> ')).strip()
    if reply != path:
        raise DosplexError('Not confirmed. Nothing was removed.')
    return home


def cmd_uninstall(env, args):
    env.require_root()
    if args.yes and not args.remove_guest:
        raise UsageError('--yes only goes with --remove-guest')
    if args.yes and env.real:
        raise UsageError('--yes is for tests only: removing Guest always asks you to type its path')
    journal = Journal.open(env)
    try:
        if journal is not None:
            journal.require_clean()
        state = read_state(env)
        fact = guest_fact(journal, state)
    finally:
        if journal is not None:
            journal.close()
    if state is not None and state.get('game_store') and library_store_gone(env, state['game_store']):
        # `library off`, then a start of DosPlex that gave the last game back: only the units and the entry are left.
        with Journal.open(env, lock=True) as locked:
            locked.require_clean()
            finish_library_leave(env, locked, state['game_store'])
        state = read_state(env)
    if state is not None and state.get('game_store'):
        raise RefusedError('the shared game library is on (%s). Turn it off first: sudo dosplex library off, restart '
                           'the machine, then uninstall. (That gives every shared game back to its account first.)'
                           % state['game_store'])
    confirmed = None
    if args.remove_guest:
        if not fact:
            raise DosplexError('There is no Guest that DosPlex created or adopted, so --remove-guest has nothing to remove.')
        if fact.get('origin') == 'adopted-foreign':
            raise DosplexError('Guest was already on this device before DosPlex (DosPlex adopted it), so DosPlex will '
                              'not remove it. Remove the account yourself if you want it gone.')
        confirmed = fact['home'] if args.yes else confirm_remove_guest(env, fact['home'])
    if state is None and not (args.remove_guest and fact):
        say('DosPlex is not installed.')
        return 0
    say('Uninstalling DosPlex.')
    created, proc = launch_worker(env, 'uninstall', {'remove_guest': bool(args.remove_guest), 'confirmed_home': confirmed})
    return finish_worker(env, 'uninstall', created, proc)


def check_install_source(args):
    """A bundle directory is approved by its manifest digest, a release archive by its signature."""
    if args.release:
        if args.bundle is not None:
            raise UsageError('give either a BUNDLE directory or --release ARCHIVE, not both')
    else:
        if args.bundle is None:
            raise UsageError('give the BUNDLE directory (with --manifest) or --release ARCHIVE')
        if not args.manifest:
            raise UsageError('give the approved manifest digest with --manifest')
        if args.signature:
            raise UsageError('--signature goes with --release')


def load_installable(args):
    """Verify what `install` and `preflight` were pointed at. Returns (Verified, release or None).

    `release` is (the dosplex program the release ships, Signed) for a signed release archive.
    """
    if not args.release:
        return verify_directory(args.bundle, args.manifest), None
    verified, program_bytes, signed = load_release_file(args.release, args.signature)
    if args.manifest and args.manifest != verified.manifest.sha256:
        raise VerifyError('the release is signed and its manifest is %s, which is not the digest you gave'
                          % verified.manifest.sha256)
    return verified, (program_bytes, signed)


def say_verified(verified, release):
    manifest = verified.manifest
    if release is None:
        say('Verified %d files against manifest %s (version %s).'
            % (len(verified.files), manifest.sha256[:12], manifest.version))
    else:
        say('Verified the signature of release %s (key %s, sequence %d) and %d files against manifest %s.'
            % (manifest.version, release[1].key_id, manifest.release['sequence'], len(verified.files),
               manifest.sha256[:12]))


def cmd_install(env, args):
    env.require_root()
    args.output_mode = check_output_mode(args.output_mode)
    check_install_source(args)
    program = own_path()
    if program is None or not program.is_file():
        raise DosplexError('cannot find the dosplex program file to install')
    hids = requested_hids(env, args.main_hid, args.guest_hid)
    # The state and journal directories first: if they are not root's, nothing else is worth doing.
    reader = Journal.open(env)
    legacy = None
    try:
        if reader is not None:
            reader.require_clean()
        read_state(env)
        verified, release = load_installable(args)
        manifest = verified.manifest
        missing = missing_required(manifest)
        if missing:
            raise VerifyError(missing_message(missing) + ' Nothing was changed.')
        say_verified(verified, release)
        report = preflight(env, manifest, op='install', user=args.main_user, hids=hids,
                           sample_seconds=args.sample_seconds, need_bytes=verified.total_bytes())
        say(report.short_text())
        report.enforce(args.allow_untested)
        legacy = inspect_legacy(env)
        plan = plan_install(env, reader, verified, args, report, program, release,
                            inherited=legacy['inherit'] if legacy else None)
    finally:
        if reader is not None:
            reader.close()
    strip = plan['guest'].get('strip_groups') or []
    if strip:
        say('Guest is in the %s group%s, which an older installer left behind. --adopt-guest-strip-groups removes '
            'exactly %s, one journaled step each:'
            % (', '.join(strip), 's' if len(strip) > 1 else '', 'these memberships' if len(strip) > 1 else 'this membership'))
        for group in strip:
            say('    gpasswd -d %s %s' % (GUEST_USER, group))
        say('Uninstall puts them back unless it removes Guest.')
    if legacy:
        say('Found an install under the old name, DuplOS%s. It is replaced: DosPlex takes over its settings and data, '
            'and the old program and releases are removed.' % (' ' + legacy['version'] if legacy['version'] else ''))
        retire_legacy_session(env, legacy)
    journal = Journal.open(env, create=True, lock=True)
    with journal:
        journal.require_clean()
        run_install(env, journal, verified, args, report, plan)
    say('Installed DosPlex %s in %s.' % (manifest.version, env.opt / 'releases' / manifest.version))
    ensure_library_units(env)
    ensure_autostart_unit(env)
    ensure_entry(env)
    if legacy:
        record_migration(env, legacy, finish_legacy(env, legacy))
    started = False
    if args.start:
        started = True
        try:
            start_client(env, args)
        except DosplexError as error:
            raise DosplexError('DosPlex is installed, but starting it failed: %s. After fixing that run: sudo %s start'
                              % (error, env.opt / 'bin' / 'dosplex')) from error
    else:
        probe = trial_status(env, read_state(env))
        if probe['alive']:
            started = True
            say_already_running(env, probe)
    if not started:
        say_how_to_start(env)
    return 0


def say_how_to_start(env):
    """After an install that did not start DosPlex: the ways to start it. The library entry and the desktop icon are
    named only when they are there; the terminal command always works."""
    ways = []
    state = read_state(env) or {}
    try:
        files = entry_files(env, state) if state.get('entry') else None
        if files is not None and entry_facts(env, state)['present']:
            if steam_library_has_dosplex(env, files['account']):
                ways.append("from Steam's library: Library, Non-Steam, DosPlex")
            launcher = env.path(files['account'].home) / ENTRY_LAUNCHER
            if launcher.is_file() and not launcher.is_symlink():
                ways.append('from the DosPlex icon on the desktop')
    except (DosplexError, OSError):
        ways = []
    ways.append('in a terminal: sudo %s start' % (env.opt / 'bin' / 'dosplex'))
    # Only what the person can do now (the owner, after his own install: say that DosPlex can be started and how,
    # and nothing about what it does not do by itself; they are looking at that).
    say('You can start DosPlex:')
    for way in ways:
        say('  %s' % way)


def cmd_worker(env, args):
    env.require_root()
    options = json.loads(args.options)
    if args.op == 'start':
        journal = Journal.open(env, lock=True)
        if journal is None:
            raise DosplexError('DosPlex is not installed')
        with journal:
            journal.require_clean()
            state = read_state(env)
            if state is None:
                raise DosplexError('DosPlex is not installed')
            return Session(env, journal, state).start(options)
    if args.op == 'stop':
        journal = Journal.open(env, lock=True)
        if journal is None:
            raise DosplexError('DosPlex is not installed')
        with journal:
            journal.require_clean()
            state = read_state(env)
            if state is None:
                raise DosplexError('DosPlex is not installed')
            return Session(env, journal, state).stop()
    if args.op == 'uninstall':
        return worker_uninstall(env, options)
    if args.op == 'repair':
        return worker_repair(env, options)
    raise UsageError('unknown worker %s' % args.op)


# ---------------------------------------------------------------------------------------------------
# The shared game library: `dosplex library on|off|slot|share|status`. The store itself is made and kept by
# the tool a release ships (bin/dosplex-game-store.py); this program turns it on (a journaled operation with
# a boot unit that runs the slot), asks it to share games and to leave, and shows what it says.
# ---------------------------------------------------------------------------------------------------

GAME_STORE_ROOT = str(Path('/home') / 'dosplex-library')
GAME_STORE_TOOL = 'bin/dosplex-game-store.py'
GAME_STORE_VERBS = ('on', 'off', 'slot', 'share', 'status', 'forget', 'release', 'arrive', 'eject')
LIBRARY_UNIT = 'dosplex-game-library.service'
LIBRARY_UNIT_DIR = '/etc/systemd/system'
LIBRARY_WANTS_DIR = LIBRARY_UNIT_DIR + '/multi-user.target.wants'
LIBRARY_PROGRAM = '/opt/dosplex/bin/dosplex'
# The boot unit. ExecStart is the slot (before the display manager starts any Steam). ExecStop runs at shutdown while the
# local filesystems are still mounted, after what is ordered after this unit (the display manager and the compositor,
# and so the sessions and their Steam) has stopped: it unmounts every account's overlays on every disk and stashes the
# manifests of shared games, so that a Steam without DosPlex finds none (`library release`).
LIBRARY_UNIT_TEXT = '''[Unit]
Description=DosPlex shared game library
After=local-fs.target
Before=display-manager.service dosplex-compositor.service
ConditionPathExists=%(program)s

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%(program)s library slot
ExecStop=%(program)s library release
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
''' % {'program': LIBRARY_PROGRAM}
# What earlier releases wrote: replaced at the next update or `library on`, never seen as somebody else's file.
# The first is this release's text in the spelling of 0.1.0-alpha.5, the second the unit before it had an ExecStop.
LIBRARY_UNIT_TEXT_EARLIER = tuple(earlier_name(text) for text in (LIBRARY_UNIT_TEXT, '''[Unit]
Description=DosPlex shared game library
After=local-fs.target
Before=display-manager.service
ConditionPathExists=%(program)s

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%(program)s library slot
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
''' % {'program': LIBRARY_PROGRAM}))
LIBRARY_LINK_TARGET = '../' + LIBRARY_UNIT
# A disk that appears or goes. A udev rule starts one instance of the template per block device; the instance waits for
# SteamOS to mount the device, then mounts the shared games into the accounts' libraries there (a Steam that runs too) or,
# when the device is gone, detaches what is left of it (`library arrive`). The rule is a file of our own in /etc; udev reads
# a changed rules directory by itself on its next event, so nothing is reloaded.
DISK_SERVICE = 'dosplex-game-library-disk@.service'
DISK_RULE = '90-dosplex-game-library.rules'
DISK_RULES_DIR = '/etc/udev/rules.d'
DISK_SERVICE_TEXT = '''[Unit]
Description=DosPlex shared game library: the mounts of %%I
After=dosplex-game-library.service
ConditionPathExists=%(program)s

[Service]
Type=oneshot
ExecStart=%(program)s library arrive %%I
TimeoutStartSec=300
''' % {'program': LIBRARY_PROGRAM}
DISK_RULE_TEXT = '''# DosPlex shared game library: a disk that appears or goes gets its shared games mounted or released.
SUBSYSTEM=="block", ACTION=="add|remove", KERNEL=="sd*|mmcblk*|nvme*|vd*", ENV{DEVTYPE}=="partition|disk", \\
    RUN+="/usr/bin/systemctl --no-block start dosplex-game-library-disk@%k.service"
'''
# The automatic sharing: a timer that runs `library share --new` in the background while the library is on.
AUTO_SERVICE = 'dosplex-game-library-auto.service'
AUTO_TIMER = 'dosplex-game-library-auto.timer'
AUTO_TIMER_WANTS_DIR = LIBRARY_UNIT_DIR + '/timers.target.wants'
AUTO_SERVICE_TEXT = '''[Unit]
Description=DosPlex shared game library: check new games for sharing
ConditionPathExists=%(program)s

[Service]
Type=oneshot
ExecStart=%(program)s library share --new
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
TimeoutStartSec=infinity
''' % {'program': LIBRARY_PROGRAM}
AUTO_TIMER_TEXT = '''[Unit]
Description=DosPlex shared game library: check new games every ten minutes

[Timer]
OnBootSec=3min
OnUnitInactiveSec=10min

[Install]
WantedBy=timers.target
'''
AUTO_LINK_TARGET = '../' + AUTO_TIMER


def game_store_tool(env, state):
    return env.opt / state['release'] / GAME_STORE_TOOL


def store_error(proc):
    lines = [line for line in (proc.stderr or '').strip().splitlines() if line.strip()]
    text = lines[-1].strip() if lines else 'it exited with status %d' % proc.returncode
    return re.sub(r'^dosplex-game-store(\.py)?: ', '', text)


def store_argv(env, tool, verb, *args):
    if not Path(tool).is_file():
        raise DosplexError('this release has no shared game library tool (%s)' % GAME_STORE_TOOL)
    return [str(a) for a in (env.python, tool, verb, *args)]


def store_call(env, tool, verb, *args, timeout=120):
    """Run one verb of the release's store tool as root. A failure becomes the tool's own one-line message."""
    proc = env.run(store_argv(env, tool, verb, *args), check=False, timeout=timeout)
    if proc.returncode:
        raise DosplexError(store_error(proc))
    return proc


def store_json(proc, what):
    try:
        value = json.loads(proc.stdout)
    except ValueError:
        raise DosplexError('the shared game library tool gave no readable answer for %s' % what) from None
    if not isinstance(value, dict):
        raise DosplexError('the shared game library tool gave an unexpected answer for %s' % what)
    return value


def library_paths(env):
    """The unit file, its enable link and the directory of the link."""
    unit_dir, wants = env.path(LIBRARY_UNIT_DIR), env.path(LIBRARY_WANTS_DIR)
    return unit_dir / LIBRARY_UNIT, wants / LIBRARY_UNIT, wants


def disk_paths(env):
    """The template unit of a disk that appears or goes, the udev rule that starts it and the rules directory."""
    rules = env.path(DISK_RULES_DIR)
    return env.path(LIBRARY_UNIT_DIR) / DISK_SERVICE, rules / DISK_RULE, rules


def library_writable(env):
    paths = library_paths(env) + disk_paths(env)
    for path in paths:
        env.allow_write(path)
    return library_paths(env)


def disk_facts(env):
    """What of the disk units is on disk. A file there that is not the one DosPlex writes is refused."""
    service, rule, rules = disk_paths(env)
    facts = {'service_existed': lexists(service), 'rule_existed': lexists(rule), 'rules_existed': lexists(rules),
             'udev_existed': lexists(rules.parent)}
    for path, text, name in ((service, DISK_SERVICE_TEXT, LIBRARY_UNIT_DIR + '/' + DISK_SERVICE),
                             (rule, DISK_RULE_TEXT, DISK_RULES_DIR + '/' + DISK_RULE)):
        if lexists(path) and (os.path.islink(path) or not path.is_file()
                              or not written_by_dosplex(path.read_text(), text)):
            raise RefusedError('%s is already there and is not the one DosPlex writes; look at it first' % name)
    return facts


def boot_unit_facts(env):
    """What of the boot unit is on disk: its text when it is DosPlex's (this release's or an earlier one's), and a
    refusal when the file or the link is not DosPlex's."""
    unit, link, wants = library_paths(env)
    facts = {'text': LIBRARY_UNIT_TEXT, 'unit_existed': lexists(unit), 'link_existed': lexists(link),
             'wants_existed': lexists(wants), 'previous': None, 'current': False}
    if facts['unit_existed']:
        known = (LIBRARY_UNIT_TEXT,) + LIBRARY_UNIT_TEXT_EARLIER
        text = unit.read_text() if (not os.path.islink(unit) and unit.is_file()) else None
        if text not in known:
            raise RefusedError('%s is already there and is not the one DosPlex writes; look at it first'
                               % (LIBRARY_UNIT_DIR + '/' + LIBRARY_UNIT))
        facts['previous'] = text
        facts['current'] = text == LIBRARY_UNIT_TEXT
    if facts['link_existed'] and (not os.path.islink(link) or os.readlink(link) != LIBRARY_LINK_TARGET):
        raise RefusedError('%s is already there and is not the link DosPlex makes; look at it first'
                           % (LIBRARY_WANTS_DIR + '/' + LIBRARY_UNIT))
    facts['disk'] = disk_facts(env)
    return facts


def library_reload(env, check=True):
    env.run(['systemctl', 'daemon-reload'], check=check, timeout=60)


def apply_library_store(env, tx, data):
    proc = store_call(env, data['tool'], 'on', '--root', env.path(data['place']),
                      '--user', data['main_user'], '--user', data['guest_user'])
    store_json(proc, 'on')
    return {'created': data['created']}


def undo_library_store(env, tx, data, result):
    """Take the config away only when this operation made it: the store is told to leave and the slot does it."""
    place = env.path(data['place'])
    if not data['created'] or not (place / 'config.json').exists():
        return {'left': False}
    try:
        store_call(env, data['tool'], 'off', '--root', place)
        proc = store_call(env, data['tool'], 'slot', '--root', place, timeout=250)
        return {'left': bool(store_json(proc, 'slot').get('left'))}
    except DosplexError as error:
        tx.note('The shared game library in %s is marked as leaving but that could not be finished now (%s). Finish it '
                'with: sudo dosplex library on, sudo dosplex library off, then restart the machine.'
                % (data['place'], error))
        return {'left': False, 'error': str(error)}


def apply_library_unit(env, tx, data):
    unit, link, wants = library_writable(env)
    service, rule, rules = disk_paths(env)
    env.ensure_dir(wants)
    env.write_file(unit, data['text'].encode(), 0o644)
    env.replace_symlink(link, LIBRARY_LINK_TARGET)
    if data.get('disk') is not None:
        if not lexists(rules.parent):           # (every system has /etc/udev; only a bare sysroot does not)
            env.allow_write(rules.parent)
            env.ensure_dir(rules.parent)
        env.ensure_dir(rules)
        env.write_file(service, DISK_SERVICE_TEXT.encode(), 0o644)
        env.write_file(rule, DISK_RULE_TEXT.encode(), 0o644)
    library_reload(env)
    return {}


def undo_library_unit(env, tx, data, result):
    unit, link, wants = library_writable(env)
    service, rule, rules = disk_paths(env)
    disk = data.get('disk')
    if disk is not None:
        if not disk['rule_existed']:
            env.unlink(rule)
        if not disk['service_existed']:
            env.unlink(service)
        if not disk['rules_existed']:
            env.rmdir_if_empty(rules)
        if not disk['udev_existed']:
            env.allow_write(rules.parent)
            env.rmdir_if_empty(rules.parent)
    if not data['link_existed']:
        env.unlink(link)
    if data.get('previous') is not None:
        env.write_file(unit, data['previous'].encode(), 0o644)      # an earlier release's unit comes back as it was
    elif not data['unit_existed']:
        env.unlink(unit)
    if not data['wants_existed']:
        env.rmdir_if_empty(wants)
    library_reload(env, check=False)
    return {}


def apply_library_state(env, tx, data):
    write_state(env, dict(data['previous_state'], game_store=data['place']))
    return {}


def apply_library_unit_remove(env, tx, data):
