                'unit-remove': undo_library_unit_remove, 'state-remove': undo_state,
                'auto': undo_library_auto, 'auto-remove': undo_library_auto_remove, 'auto-state': undo_state}


def repair_library(env, journal, tx):
    """An interrupted `library on` or the end of the shared game library: finish it once its commit record is on
    disk, else undo it."""
    if tx.committed:
        tx.append('repair', action='roll-forward')
        try:
            complete_plan(env, tx, LIBRARY_APPLY)
            tx.note('The shared game library change was completed.')
            tx.end('complete', repaired=True)
            return
        except BaseException as error:
            tx.note('The shared game library change could not be completed (%s); rolling it back.' % error)
    else:
        tx.append('repair', action='rollback')
    rollback(env, tx, LIBRARY_UNDO)
    tx.note('The shared game library change was rolled back; the device is as it was before.')
    tx.end('rolled-back', repaired=True)


def library_state(env):
    state = read_state(env)
    if state is None:
        raise NotInstalled('DosPlex is not installed. Run: sudo dosplex install BUNDLE --manifest SHA256')
    return state


def require_library_on(state, what):
    if not state.get('game_store'):
        raise RefusedError('the shared game library is not on, so there is nothing to %s. Turn it on with: '
                           'sudo dosplex library on' % what)
    return state['game_store']


def check_store_place(text):
    if '\0' in text or not os.path.isabs(text) or '..' in text.split('/') or os.path.normpath(text) in ('/', '//'):
        raise UsageError('%r is not a plain absolute path for the shared game library' % text)
    return os.path.normpath(text)


def library_on(env, args):
    env.require_root()
    place = check_store_place(args.root or GAME_STORE_ROOT)
    journal = Journal.open(env, lock=True)
    if journal is None:
        raise NotInstalled('DosPlex is not installed. Run: sudo dosplex install BUNDLE --manifest SHA256')
    with journal:
        journal.require_clean()
        state = library_state(env)
        if state.get('game_store') and library_store_gone(env, state['game_store']):
            finish_library_leave(env, journal, state['game_store'])
            state = library_state(env)
        if state.get('game_store'):
            raise RefusedError('the shared game library is already on (%s)' % state['game_store'])
        if not getattr(args, 'experimental', False):
            # ADR-026: the shared game library stays in the program, off, and is turned on knowingly.
            raise RefusedError('the shared game library is experimental in this release: it moves installed games '
                               'into one store that both accounts play from. To turn it on: sudo dosplex library on '
                               '--experimental')
        check_current(env, state)
        tool = game_store_tool(env, state)
        if not tool.is_file():
            raise RefusedError('the installed release (%s) has no shared game library. Update DosPlex first: '
                               'sudo dosplex update' % state['version'])
        boot = boot_unit_facts(env)
        auto = auto_facts(env)
        created = not (env.path(place) / 'config.json').exists()
        tx = journal.begin('library', action='on', place=place)
        plan = [
            {'step': 'store', 'data': {'tool': str(tool), 'place': place, 'main_user': state['main_user'],
                                       'guest_user': GUEST_USER, 'created': created}},
            {'step': 'unit', 'data': boot},
            {'step': 'auto', 'data': auto},
            {'step': 'state', 'data': {'place': place, 'previous_state': state}},
        ]
        try:
            tx.commit(plan)
            complete_plan(env, tx, LIBRARY_APPLY)
            tx.end('complete', place=place)
        except BaseException as error:
            abort(env, tx, LIBRARY_UNDO, error, 'library on')
            raise
    say('The shared game library is on (%s).' % place)
    say('Games are shared automatically: new and updated games are checked in the background, the first check starts '
        'in a few minutes, and they reach both accounts at the next start of DosPlex or restart of the machine.')
    say('To do it right away: sudo dosplex library share --all')
    return 0


def library_slot_summary(report):
    """One plain sentence about what the slot did, from the tool's report: the main store and every disk's."""
    disks = report.get('disks') if isinstance(report.get('disks'), dict) else {}
    stores = [report] + [item for item in disks.values() if isinstance(item, dict)]

    def count(section, key):
        total = 0
        for store in stores:
            value = (store.get(section) or {}).get(key) if isinstance(store.get(section), dict) else None
            total += len(value) if isinstance(value, (list, dict)) else 0
        return total
    parts = []
    for number, text in ((count('commit', 'committed'), '%d moved into the store'),
                         (count('commit', 'dropped'), '%d not taken (changed since it was checked)'),
                         (count('commit', 'removed'), '%d removed (uninstalled by every account)'),
                         (count('commit', 'warnings'), '%d to finish at the next start'),
                         (count('restore', 'restored'), '%d given back'),
                         (count('restore', 'kept'), '%d could not be given back and stay shared')):
        if number:
            parts.append(text % number)
    for key in ('busy', 'failed'):
        names = sorted({name for store in stores for name in (store.get(key) or [])})
        if names:
            parts.append('%s: %s' % ('in use, nothing changed' if key == 'busy' else 'not mounted', ', '.join(names)))
    moved = sum(item.get('moved', 0) for store in stores for item in (store.get('migrate') or {}).values()
                if isinstance(item, dict)) if all(isinstance(store.get('migrate') or {}, dict) for store in stores) else 0
    if moved:
        parts.append('%d items of the earlier private layers moved into the libraries' % moved)
    for store in stores:
        for key in ('commit_error', 'restore_error', 'prepare_error', 'config_error', 'unlist_error', 'migrate_error'):
            if store.get(key):
                parts.append(str(store[key]))
    away = sorted(root for root, item in disks.items() if isinstance(item, dict) and item.get('absent'))
    if away:
        parts.append('not connected: %s' % ', '.join(disk_name(root) for root in away))
    lists = report.get('lists') if isinstance(report.get('lists'), dict) else {}
    if lists.get('asked'):
        parts.append('asked Steam for the file lists of %d games' % lists['asked'])
    if lists.get('returned'):
        parts.append('%d games still wait for their file lists (Steam was offline)' % lists['returned'])
    return ', '.join(parts) or 'mounted, nothing to do'


def disk_name(root):
    """How a disk store is named to the owner: the mount point of its disk."""
    root = str(root)
    tail = '/dosplex-library/disk'
    return root[:-len(tail)] if root.endswith(tail) else root


def booting(uptime='/proc/uptime', limit=180):
    """Whether the machine started less than three minutes ago: drives may still be on their way."""
    try:
        with open(uptime) as stream:
            return float(stream.read().split()[0]) < limit
    except (OSError, ValueError, IndexError):
        return False


def library_store_gone(env, place):
    """The store gave its last game back and took its own config away, and its folder is still here: only the units and
    the entry in the state are left of the library. The start of DosPlex runs the store's slot itself, so this is
    how a library looks that finished leaving there. A place that is not there at all (a disk that is not connected)
    is not that."""
    root = env.path(place)
    try:
        return (root / 'sides').is_dir() and not lexists(root / 'config.json')
    except OSError:
        return False


def library_store_mode(env, place):
    """'on', 'leaving', 'gone' (see library_store_gone) or None when the store's config cannot be read."""
    if library_store_gone(env, place):
        return 'gone'
    try:
        with open(env.path(place) / 'config.json', encoding='utf-8') as stream:
            mode = json.load(stream).get('mode')
    except (OSError, ValueError, AttributeError):
        return None
    return mode if mode in ('on', 'leaving') else None


def finish_library_leave(env, journal, place):
    """Inside the journal's lock: take the library's units and its entry in the state away."""
    state = library_state(env)
    unit, link, wants = library_paths(env)
    service, rule, _rules = disk_paths(env)
    tx = journal.begin('library', action='leave', place=place)
    plan = [
        {'step': 'unit-remove', 'data': {'text': LIBRARY_UNIT_TEXT, 'unit_existed': lexists(unit),
                                         'link_existed': lexists(link), 'disk_service_existed': lexists(service),
                                         'disk_rule_existed': lexists(rule)}},
        {'step': 'auto-remove', 'data': auto_facts(env)},
        {'step': 'state-remove', 'data': {'previous_state': state}},
    ]
    try:
        tx.commit(plan)
        complete_plan(env, tx, LIBRARY_APPLY)
        tx.end('complete', place=place)
    except BaseException as error:
        abort(env, tx, LIBRARY_UNDO, error, 'library slot')
        raise


def library_slot(env, args):
    env.require_root()
    state = read_state(env)
    if state is None or not state.get('game_store'):
        return 0
    place = state['game_store']
    try:
        env.run(['systemctl', 'stop', AUTO_SERVICE], check=False, timeout=60)
    except DosplexError:
        pass
    try:
        # At boot SteamOS mounts cards and USB drives a moment after the system is up: a listed disk gets time.
        wait = ['--wait', '20'] if booting(env.path('/proc/uptime')) else []
        proc = store_call(env, game_store_tool(env, state), 'slot', '--root', env.path(place), *wait, timeout=270)
    except DosplexError as error:
        if 'steam' in str(error).lower():
            raise DosplexError('the shared game library cannot change while a Steam is running (%s). Stop DosPlex and '
                               'the Steam of both accounts first, or let the restart of the machine do it.'
                               % error) from None
        raise
    report = store_json(proc, 'slot')
    # The start of DosPlex runs the store's slot too. When that one gave the last game back, the store answers here
    # only that it has no config: the units and the entry in the state are still to be taken away.
    gone = 'config' in report and report['config'] is None and library_store_gone(env, place)
    if not gone:
        say('Shared game library: %s.' % library_slot_summary(report))
    if report.get('stopped_sharing'):
        say('A running check of games was stopped; it starts again by itself.')
    if report.get('left') is not True and not gone:
        return 0
    journal = Journal.open(env, lock=True)
    if journal is None:
        raise NotInstalled('DosPlex is not installed')
    with journal:
        journal.require_clean()
        if gone and (library_state(env).get('game_store') != place or not library_store_gone(env, place)):
            return 0
        finish_library_leave(env, journal, place)
    say('The shared game library is off. Every shared game is back with the account that shared it.')
    return 0


def library_off(env, args):
    env.require_root()
    state = library_state(env)
    place = require_library_on(state, 'turn off')
    store_call(env, game_store_tool(env, state), 'off', '--root', env.path(place))
    say('The shared game library is leaving. Every shared game goes back to the account that shared it at the next '
        'restart of the machine (or the next start of DosPlex).')
    say('Check with: sudo dosplex library status. It shows when it is done.')
    return 0


def describe_game(item):
    if isinstance(item, dict):
        name = item.get('name')
        return '%s%s' % (item.get('appid', '?'), ' (%s)' % name if name else '')
    return str(item)


def library_share(env, args):
    env.require_root()
    state = library_state(env)
    place = require_library_on(state, 'share a game into')
    if args.new:
        return library_share_new(env, state, place, args)
    if bool(args.appid) == bool(args.all):
        raise UsageError('name the games to share (APPID ...) or give --all')
    if not all(re.fullmatch(r'[0-9]{1,10}', appid) for appid in args.appid):
        raise UsageError('an APPID is the number Steam gives a game, for example 620')
    user = args.user or state['main_user']
    if user not in (state['main_user'], GUEST_USER):
        raise UsageError('--user is %s or %s, not %s' % (state['main_user'], GUEST_USER, user))
    selection = ['--all'] if args.all else [a for appid in args.appid for a in ('--app', appid)]
    argv = store_argv(env, game_store_tool(env, state), 'share', '--root', env.path(place), '--user', user, *selection)
    check_command(env, argv)
    say('Checking the games of %s. This reads every file and can take a while.' % user)
    try:
        proc = subprocess.run(argv, stdout=subprocess.PIPE, stderr=None, text=True,
                              env=dict(os.environ, LC_ALL='C', PYTHONDONTWRITEBYTECODE='1'))
    except FileNotFoundError:
        raise CommandMissing('%s is not installed' % argv[0]) from None
    try:
        report = json.loads(proc.stdout)
        if not isinstance(report, dict):
            raise ValueError
    except ValueError:
        raise DosplexError('the shared game library tool could not share anything' if proc.returncode
                           else 'the shared game library tool gave no readable answer') from None
    shared, refused = report.get('shared') or [], report.get('refused') or []
    if shared:
        say('Queued for sharing: %s.' % ', '.join(describe_game(item) for item in shared))
        say('The games move at the next start of DosPlex or restart of the machine.')
    for item in refused:
        say('Not shared: %s: %s' % (describe_game(item), item.get('reason') if isinstance(item, dict) else item))
    for line in describe_disks_refused(report):
        say(line)
    if not shared and not refused:
        say('Nothing was shared.')
    return proc.returncode


def describe_disks_refused(summary):
    lines = []
    for item in summary.get('disks_refused') or []:
        if isinstance(item, dict):
            lines.append('The games in %s cannot be shared: %s' % (item.get('library') or 'a library on another disk',
                                                                    item.get('reason')))
    return lines


def library_share_new(env, state, place, args):
    """`library share --new`: what the automatic check runs. Quiet, one line per account."""
    if args.appid or args.all:
        raise UsageError('--new takes no APPID and no --all')
    user = args.user
    if user is not None and user not in (state['main_user'], GUEST_USER):
        raise UsageError('--user is %s or %s, not %s' % (state['main_user'], GUEST_USER, user))
    argv = store_argv(env, game_store_tool(env, state), 'share', '--root', env.path(place), '--new',
                      *(['--user', user] if user else []))
    check_command(env, argv)
    try:
        proc = subprocess.run(argv, stdout=subprocess.PIPE, stderr=None, text=True,
                              env=dict(os.environ, LC_ALL='C', PYTHONDONTWRITEBYTECODE='1'))
    except FileNotFoundError:
        raise CommandMissing('%s is not installed' % argv[0]) from None
    if proc.returncode < 0:
        # Ended by a signal: a start of DosPlex, a restart or a share somebody asked for went first.
        say('The check of games was stopped; it starts again by itself.')
        return 0
    try:
        report = json.loads(proc.stdout)
        users = report['users']
        if not isinstance(users, dict):
            raise ValueError
    except (ValueError, KeyError, TypeError):
        raise DosplexError('the shared game library tool could not check for new games' if proc.returncode
                           else 'the shared game library tool gave no readable answer') from None
    lines = []
    for name, summary in sorted(users.items()):
        summary = summary if isinstance(summary, dict) else {}
        parts = []
        if summary.get('shared'):
            parts.append('Queued for sharing: %s.' % ', '.join(describe_game(item) for item in summary['shared']))
        for item in summary.get('refused') or []:
            parts.append('Not shared: %s: %s.' % (describe_game(item), item.get('reason') if isinstance(item, dict) else item))
        parts += [line + '.' for line in describe_disks_refused(summary)]
        lines.append('%s: %s' % (name, ' '.join(parts) or 'Nothing new to share.'))
    for line in lines or ['Nothing new to share.']:
        say(line)
    return proc.returncode


def library_auto(env, args):
    """`library auto on|off`: the timer that checks new games, with its two units, as one journaled operation."""
    env.require_root()
    journal = Journal.open(env, lock=True)
    if journal is None:
        raise NotInstalled('DosPlex is not installed. Run: sudo dosplex install BUNDLE --manifest SHA256')
    wanted = args.mode == 'on'
    with journal:
        journal.require_clean()
        state = library_state(env)
        place = require_library_on(state, 'change automatic sharing of')
        check_current(env, state)
        facts = auto_facts(env)
        present = facts['service_existed'] and facts['timer_existed'] and facts['link_existed']
        if wanted == (state.get('game_store_auto') is not False) and wanted == present:
            say('Automatic sharing is already %s.' % args.mode)
            return 0
        tx = journal.begin('library', action='auto-' + args.mode, place=place)
        plan = [{'step': 'auto' if wanted else 'auto-remove', 'data': facts},
                {'step': 'auto-state', 'data': {'previous_state': state, 'auto': wanted}}]
        try:
            tx.commit(plan)
            complete_plan(env, tx, LIBRARY_APPLY)
            tx.end('complete', place=place)
        except BaseException as error:
            abort(env, tx, LIBRARY_UNDO, error, 'library auto')
            raise
    if wanted:
        say('Automatic sharing is on: new games are checked every ten minutes.')
    else:
        say('Automatic sharing is off. A check that was running was stopped. Share with: sudo dosplex library share APPID')
    return 0


def ensure_library_units(env):
    """After an install or an update: a library that was turned on by an earlier release has no automatic sharing
    units yet, an older boot unit (no stop step) and no units for a disk that appears or goes. Write what is missing or
    out of date and start the timer. A problem is said, never fatal."""
    try:
        journal = Journal.open(env, lock=True)
        if journal is None:
            return
        with journal:
            journal.require_clean()
            state = read_state(env)
            if not state or not state.get('game_store'):
                return
            auto_off = state.get('game_store_auto') is False
            facts = None if auto_off else auto_facts(env)
            try:
                boot = boot_unit_facts(env)
            except RefusedError:
                return
            disk = boot['disk']
            units_ok = boot['current'] and boot['link_existed'] and disk['service_existed'] and disk['rule_existed']
            auto_ok = auto_off or (facts['service_existed'] and facts['timer_existed'] and facts['link_existed'])
            if units_ok and auto_ok:
                return
            tx = journal.begin('library', action='units', place=state['game_store'])
            plan = []
            if not units_ok:
                plan.append({'step': 'unit', 'data': boot})
            if not auto_off:
                plan.append({'step': 'auto', 'data': facts})
            try:
                tx.commit(plan)
                complete_plan(env, tx, LIBRARY_APPLY)
                tx.end('complete', place=state['game_store'])
            except BaseException as error:
                abort(env, tx, LIBRARY_UNDO, error, 'library units')
                raise
        if not units_ok:
            say('The boot unit and the disk units of the shared game library are up to date: the library is released at '
                'shutdown, and a card that is put in or pulled out is handled.')
        if not auto_ok:
            say('Automatic sharing of the shared game library is on: new games are checked every ten minutes.')
    except DosplexError as error:
        say('The units of the shared game library could not be set up: %s. Try: sudo dosplex library auto on' % error)


def _entries(value):
    """(key, item) pairs of a list or a dict the tool reports."""
    if isinstance(value, dict):
        return list(value.items())
    return [(None, item) for item in value or []]


def format_library_status(report, place):
    mode = (report.get('config') or {}).get('mode')
    leaving = 'leaving (it finishes at the next restart of the machine or start of DosPlex)'
    lines = ['Shared game library: %s (%s)' % ({'on': 'on', 'leaving': leaving}.get(mode, 'off'), place)]
    for key, side in _entries(report.get('sides')):
        lines += side_lines(key, side, '  ')
    apps = _entries(report.get('apps'))
    lines.append('  Stored games: %s' % (len(apps) or 'none'))
    for key, app in apps:
        app = app if isinstance(app, dict) else {}
        lines.append('    %s (%s), shared by %s' % (app.get('name') or '?', app.get('appid', key), app.get('shared_by') or '?'))
    def waiting(store, indent):
        pending = _entries(store.get('pending'))
        if pending:
            lines.append('%sWaiting for the next start of DosPlex or restart of the machine: %s' % (indent, ', '.join(
                str(item.get('appid', key) if isinstance(item, dict) else (key if key is not None else item))
                for key, item in pending)))
    waiting(report, '  ')
    lines += last_slot_lines(report.get('last_slot'))
    lines += last_event_lines(report.get('events'))
    lines += unshared_lines(report.get('unshared'))
    for disk in report.get('disks') or []:
        if not isinstance(disk, dict):
            continue
        name = disk.get('mount') or disk_name(disk.get('root', '?'))
        if not disk.get('present'):
            lines.append('  Disk %s: not connected (%s). Its games come back when it is. If it is gone for good: '
                         'sudo dosplex library forget %s' % (name, disk.get('reason') or '?', name))
            continue
        sides = [side for _key, side in _entries(disk.get('sides')) if isinstance(side, dict)]
        ready = bool(sides) and all(side.get('mounted') for side in sides)
        apps = _entries(disk.get('apps'))
        lines.append('  Disk %s: %s, stored games: %s' % (
            name, 'shown in the library of every account' if ready else 'not shown in the library of every account yet',
            len(apps) or 'none'))
        for key, side in _entries(disk.get('sides')):
            lines += side_lines(key, side, '    ')
        for key, app in apps:
            app = app if isinstance(app, dict) else {}
            lines.append('    %s (%s), shared by %s' % (app.get('name') or '?', app.get('appid', key), app.get('shared_by') or '?'))
        waiting(disk, '    ')
    return '\n'.join(lines)


def side_lines(key, side, indent):
    """What one account has of the store on one drive: its own library there, whether the store is shown in it, and
    what is set aside for it (the earlier private layer, manifests that wait in the stash, items kept as conflicts)."""
    side = side if isinstance(side, dict) else {}
    name = key or side.get('user', '?')
    library = side.get('library')
    if not library:
        return ['%s%s: no Steam library on this drive' % (indent, name)]
    stash = side.get('stash') if isinstance(side.get('stash'), dict) else {}
    line = '%s%s: its library %s, shared games %s' % (
        indent, name, library, 'shown in it' if side.get('mounted') else 'not shown in it yet')
    if side.get('steam_running'):
        line += ', Steam is running'
        if side.get('mounted'):
            line += ' (it may show the shared games only after it looks at its library again, for example after a restart)'
    if stash.get('entries'):
        names = [str(item) for item in side.get('stashed') or []]
        line += ', %d manifests of shared games are set aside until it is shown again' % stash['entries']
        if names:
            line += ' (%s%s)' % (', '.join(names[:5]), ' and %d more' % (stash['entries'] - 5) if stash['entries'] > 5 else '')
        if side.get('steam_running'):
            line += '; they are put back at the next start of DosPlex or restart of the machine'
    if side.get('earlier_layer'):
        line += ', its earlier private layer is still to be moved into the library'
    lines = [line]
    kept = [str(item) for item in side.get('conflicts') or []]
    if kept:
        lines.append('%s  kept aside because the library had them already (nothing was overwritten): %s'
                     % (indent, ', '.join(kept[:5]) + (' and %d more' % (len(kept) - 5) if len(kept) > 5 else '')))
    return lines


def unshared_lines(unshared):
    """The installed games that are not shared and cannot be yet, grouped by reason; at most five names a reason."""
    lines = []
    for user, games in sorted(unshared.items()) if isinstance(unshared, dict) else []:
        reasons = {}
        for game in games if isinstance(games, list) else []:
            if isinstance(game, dict):
                reasons.setdefault(re.sub(r'\(\d+ of \d+ ', '(', str(game.get('reason'))), []).append(
                    str(game.get('name') or game.get('appid', '?')))
        for reason, names in sorted(reasons.items(), key=lambda item: -len(item[1])):
            shown = ', '.join(names[:5]) + (' and %d more' % (len(names) - 5) if len(names) > 5 else '')
            lines.append('  Not shared, %s, %d: %s. Each %s' % (user, len(names), shown, reason))
    return lines


def last_event_lines(events):
    """What the last shutdown (release or eject) and the last card that appeared or went did, from the tool's report."""
    lines = []
    for key, words in (('release', 'At the last shutdown or eject'), ('arrive', 'At the last disk that appeared or went')):
        kept = events.get(key) if isinstance(events, dict) else None
        if not isinstance(kept, dict) or not isinstance(kept.get('report'), dict):
            continue
        report = kept['report']
        what = ('ejected %s' % report['ejected']) if report.get('ejected') else library_events_summary(report)
        lines.append('  %s (%s): %s' % (words, kept.get('utc', '?'), what))
    return lines


def last_slot_lines(kept):
    """What went wrong for single games at the last start or restart, from the report the store keeps."""
    if not isinstance(kept, dict) or not isinstance(kept.get('report'), dict):
        return []
    report = kept['report']
    disks = report.get('disks') if isinstance(report.get('disks'), dict) else {}
    lines = []
    for store in [report] + [item for item in disks.values() if isinstance(item, dict)]:
        for section, key, words in (('commit', 'dropped', 'not taken'), ('restore', 'kept', 'not given back')):
            for item in ((store.get(section) or {}).get(key) or []) if isinstance(store.get(section), dict) else []:
                if isinstance(item, dict):
                    lines.append('    %s %s: %s' % (item.get('appid', '?'), words, item.get('reason')))
        for item in ((store.get('commit') or {}).get('warnings') or []) if isinstance(store.get('commit'), dict) else []:
            lines.append('    %s' % item)
        for key in ('commit_error', 'restore_error', 'prepare_error', 'lists_error', 'migrate_error'):
            if store.get(key):
                lines.append('    %s' % store[key])
        for name, reason in sorted((store.get('no_library') or {}).items()) if isinstance(store.get('no_library'), dict) else []:
            lines.append('    %s: %s' % (name, reason))
        for name, item in sorted((store.get('migrate') or {}).items()) if isinstance(store.get('migrate'), dict) else []:
            if isinstance(item, dict) and item.get('error'):
                lines.append('    %s: its earlier private layer was not moved into its library: %s' % (name, item['error']))
            elif isinstance(item, dict) and item.get('conflicts'):
                lines.append('    %s: %d items of its earlier layer were kept aside, not overwritten: %s' % (
                    name, len(item['conflicts']), ', '.join(str(entry) for entry in item['conflicts'][:5])))
    if not lines:
        return []
    return ['  At the last start or restart (%s):' % kept.get('utc', '?')] + lines


def library_status(env, args):
    env.require_root()
    state = library_state(env)
    place = state.get('game_store')
    if not place:
        say(json.dumps({'config': None}) if args.json else
            'Shared game library: off. Turn it on with: sudo dosplex library on')
        return 0
    proc = store_call(env, game_store_tool(env, state), 'status', '--root', env.path(place))
    report = store_json(proc, 'status')
    if args.json:
        say(proc.stdout.strip())
    else:
        say(format_library_status(report, place))
        say('Automatic sharing: ' + ('on (new games are checked every ten minutes)'
                                     if state.get('game_store_auto') is not False
                                     else 'off (share with: sudo dosplex library share APPID)'))
    return 0


def library_events_summary(report):
    """One plain line about what a release, an arrival or an eject did, from the tool's report."""
    parts = []
    stores = report.get('stores') if isinstance(report.get('stores'), dict) else {}
    disks = report.get('disks') if isinstance(report.get('disks'), dict) else {}
    accounts = [item for store in list(stores.values()) + list(disks.values()) if isinstance(store, dict)
                for item in store.values() if isinstance(item, dict)]
    mounted = sum(1 for item in accounts if item.get('done'))
    unmounted = sum(1 for item in accounts if item.get('unmounted'))
    stashed = sum(len(item['stashed']) for item in accounts if isinstance(item.get('stashed'), list))
    if mounted:
        parts.append('%d libraries mounted' % mounted)
    if unmounted:
        parts.append('%d libraries released' % unmounted)
    if stashed:
        parts.append('%d manifests set aside' % stashed)
    waiting = sorted({str(item['stash_waits']) for item in accounts if item.get('stash_waits')})
    if waiting:
        parts.append('manifests stay until that Steam is closed (%s)' % '; '.join(waiting))
    errors = sorted({str(item['error']) for item in accounts if item.get('error')})
    if errors:
        parts.append('not done: %s' % '; '.join(errors))
    for key in ('disks_error', 'not_mounted'):
        if report.get(key):
            parts.append(str(report[key]))
    return ', '.join(parts) or 'nothing to do'


def library_release(env, args):
    """`library release`: what the boot unit's stop step runs at shutdown. Every account's overlays on every disk come
    off and the manifests of shared games are set aside, so that a Steam without DosPlex finds none. A Steam that still
    runs is given 30 seconds to end first. Safe to run twice."""
    env.require_root()
    state = read_state(env)
    if state is None or not state.get('game_store'):
        return 0
    place = state['game_store']
    proc = store_call(env, game_store_tool(env, state), 'release', '--root', env.path(place), '--wait', '30', timeout=270)
    say('Shared game library released: %s.' % library_events_summary(store_json(proc, 'release')))
    return 0


def library_arrive(env, args):
    """`library arrive [DEVICE]`: a disk appeared or went (the udev rule starts this through the template unit). Waits for
    SteamOS to mount a device that holds a filesystem, then makes the mounts of every disk right."""
    env.require_root()
    state = read_state(env)
    if state is None or not state.get('game_store'):
        return 0
    device = args.device
    if device is not None and not re.fullmatch(r'[A-Za-z0-9._-]{1,32}', device):
        raise UsageError('%r is not the kernel name of a device (for example sdb1)' % device)
    extra = ['--device', device, '--wait', '60'] if device else []
    proc = store_call(env, game_store_tool(env, state), 'arrive', '--root', env.path(state['game_store']), *extra, timeout=300)
    say('Shared game library, disk %s: %s.' % (device or 'check', library_events_summary(store_json(proc, 'arrive'))))
    return 0


def check_eject_place(text):
    if '\0' in text or not os.path.isabs(text) or '..' in text.split('/') or os.path.normpath(text) in ('/', '//'):
        raise UsageError('%r is not the plain absolute path of a disk (see: sudo dosplex library status)' % text)
    return os.path.normpath(text)


def eject_disk(env, mount):
    """Ask the store tool to release the disk and have udisks unmount it. Returns (the place, the tool's answer)."""
    state = library_state(env)
    place = require_library_on(state, 'eject a disk of')
    mount = check_eject_place(mount)
    proc = store_call(env, game_store_tool(env, state), 'eject', '--root', env.path(place), '--mount', mount, timeout=170)
    return mount, store_json(proc, 'eject')


def library_eject(env, args):
    """`library eject MOUNT`: the DosPlex-side eject of a card that holds a store. Steam's own eject of such a card fails
    ("target is busy") because DosPlex's overlays and binds hold it; this releases them first, then asks udisks to
    unmount it as Steam would."""
    env.require_root()
    mount, report = eject_disk(env, args.mount)
    if report.get('already'):
        say('%s is not mounted; nothing to eject.' % mount)
        return 0
    say('%s is ejected; it is safe to pull out.' % mount)
    waiting = sorted(name for name, item in (report.get('released') or {}).items()
                     if isinstance(item, dict) and item.get('stash_waits'))
    if waiting:
        say('The Steam of %s was running, so its manifests of shared games stay on the card until that Steam is closed '
            'and DosPlex is next started or the machine restarted. Stock Steam on another machine may offer to download '
            'those games again.' % ', '.join(waiting))
    return 0


def library_forget(env, args):
    """`library forget DISK`: a disk with shared games that will not come back is taken off the list."""
    env.require_root()
    state = library_state(env)
    place = require_library_on(state, 'forget a disk of')
    text = args.disk
    if '\0' in text or not os.path.isabs(text) or '..' in text.split('/'):
        raise UsageError('%r is not the plain absolute path of a disk (see: sudo dosplex library status)' % text)
    mount = disk_name(os.path.normpath(text))
    root = mount.rstrip('/') + '/dosplex-library/disk'
    try:
        store_call(env, game_store_tool(env, state), 'forget', '--root', env.path(place), '--disk', root)
    except DosplexError as error:
        if 'steam' in str(error).lower():
            raise DosplexError('a disk can only be forgotten while no Steam is running (%s). Stop DosPlex and the '
                               'Steam of both accounts first.' % error) from None
        raise
    say('The disk %s is forgotten. The games that were shared on it are not in any account\'s library any more; '
        'what is on the disk was not touched.' % mount)
    return 0


LIBRARY_ACTIONS = {'on': library_on, 'off': library_off, 'slot': library_slot, 'share': library_share,
                   'forget': library_forget, 'release': library_release, 'arrive': library_arrive,
                   'eject': library_eject,
                   'status': library_status, 'auto': library_auto}


def cmd_library(env, args):
    return LIBRARY_ACTIONS[args.action](env, args)


# ---------------------------------------------------------------------------------------------------
# control: the versioned interface that user interfaces use instead of ad-hoc commands
#
#   dosplex control ACTION [ARGUMENT...] [--json]
#
# One JSON object on stdout, {"api", "ok", "code", "message", "data"}; a stable exit status per code. The actions
# are an allow-list with typed, validated arguments; nothing is run through a shell and anything else is
# `bad-request`. The schema and the codes are documented in docs/control-interface.md and pinned by tests.
# ---------------------------------------------------------------------------------------------------

CONTROL_API = 1
# code -> exit status. `ok` and `accepted` are the only successes.
CONTROL_CODES = {'ok': 0, 'accepted': 0, 'failed': 1, 'bad-request': 2, 'refused': 3, 'not-installed': 3,
                 'interrupted': 4, 'busy': 5, 'already-running': 6, 'not-running': 7, 'timeout': 8,
                 'not-found': 9, 'permission-denied': 10, 'unavailable': 11}
CONTROL_SUCCESS = ('ok', 'accepted')
LAYOUT_NUMBERS = {'single': 1, 'vertical': 2, 'horizontal': 3, 'guest': 4}
ASSIGN_TARGETS = ('main', 'guest', 'unassigned')
OPERATION_ID_RE = re.compile(r'[0-9a-f]{32}')
CONTROLLER_ID_RE = re.compile(r'[0-9a-f]{32}')
OPERATIONS = 'operations'
OPERATIONS_KEPT = 20
WAIT_DEFAULT_SECONDS = 120.0
WAIT_MAX_SECONDS = 1800.0
INVENTORY_MAX_AGE = 5.0                 # the compositor ignores a controller list older than this
CONTROL_SOCKET = 'control.sock'


class ControlError(DosplexError):
    def __init__(self, code, message, data=None):
        super().__init__(message)
        self.error_code, self.data = code, data or {}


def shown(text, limit=48):
    """An argument as it may be repeated in a message: printable ASCII, short."""
    text = str(text)
    clipped = ''.join(c if ' ' <= c < '\x7f' else '?' for c in text[:limit])
    return clipped + ('...' if len(text) > limit else '')


# --- reading what root and the compositor wrote -----------------------------------------------------

def read_trusted_json(env, directory_fd, name, limit=65536):
    """A JSON object from a regular file that root owns and nobody else can change; None if it is not there
    or is not trustworthy. Never follows a symlink."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory_fd)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o022
                or info.st_size > limit):
            return None
        value = json.loads(os.read(fd, limit + 1))
    except (OSError, ValueError):
        return None
    finally:
        os.close(fd)
    return value if isinstance(value, dict) else None


def open_root_dir(env, path):
    """Open a directory without following symlinks; it must belong to root and be closed to others."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return None
    info = os.fstat(fd)
    if info.st_uid != env.trusted_uid or info.st_mode & 0o022:
        os.close(fd)
        return None
    return fd


def trial_root_of(env, state):
    """The root of the trial that dosplex started, or None."""
    trial = (state or {}).get('trial')
    if not trial:
        return None
    root = Path(trial['root'])
    return root if root.parent == env.path('/run') and TRIAL_RE.fullmatch(root.name) and root.is_dir() else None


def list_receiver_records(env):
    found = []
    for path in sorted(env.path('/sys/class/hidraw').glob('hidraw*')):
        try:
            uevent = (path / 'device/uevent').read_text()
        except OSError:
            continue
        match = re.search(r'^HID_ID=0003:0000([0-9A-F]{4}):0000([0-9A-F]{4})$', uevent, re.M)
        if match and match.group(1) == '28DE':
            found.append({'node': '/dev/' + path.name, 'vendor': '28de', 'product': match.group(2).lower()})
    return found


def list_receivers(env):
    return ['%(node)s (%(vendor)s:%(product)s)' % record for record in list_receiver_records(env)]


def read_inventory(env, root):
    """(freshness, {id: row}) of the controller list the brokers publish in the runtime directory.

    freshness is 'fresh' (published in the last 5 s, like the compositor demands), 'stale' or 'missing'."""
    rows, newest = {}, None
    runtime = open_root_dir(env, root / 'runtime')
    if runtime is None:
        return 'missing', rows
    try:
        for name in ('controllers.json', 'controllers-native.json'):       # native rows replace generic ones
            record = read_trusted_json(env, runtime, name)
            if record is None:
                continue
            devices = record.get('devices')
            updated = record.get('updated')
            if not isinstance(devices, list) or len(devices) > 32 or not isinstance(updated, (int, float)):
                continue
            newest = updated if newest is None else max(newest, updated)
            if time.time() - updated > INVENTORY_MAX_AGE:
                continue
            for row in devices:
                if isinstance(row, dict) and isinstance(row.get('id'), str) and CONTROLLER_ID_RE.fullmatch(row['id']):
                    rows[row['id']] = row
    finally:
        os.close(runtime)
    if newest is None:
        return 'missing', rows
    return ('fresh' if rows or time.time() - newest <= INVENTORY_MAX_AGE else 'stale'), rows


CONTROLLERS_DIR = 'controllers'


def controller_directory(env):
    """Where each controller's owner and number are kept: /var/lib/dosplex/controllers, root's and closed to others.
    The session's routing service, the compositor (DOSPLEX_CONTROLLER_DIRECTORY) and this program read the same place."""
    return env.var / CONTROLLERS_DIR


def ensure_controller_directory(env):
    """Make the controller directory before a session starts: the compositor writes an assignment there as soon as a
    player moves a controller, and with no controller connected nothing else would have made it yet."""
    path = controller_directory(env)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o022:
        raise RefusedError('%s must be a folder of root that others cannot write' % path)


def read_preferences(env, root):
    """({id: saved record}, assignments record) from the controller directory (CONTROLLERS_DIR: the owners outlive
    a session, so they are not below the trial's root)."""
    directory = open_root_dir(env, controller_directory(env))
    if directory is None:
        return {}, {}
    try:
        records = {}
        for name in sorted(os.listdir(directory))[:64]:
            match = re.fullmatch(r'([0-9a-f]{32})\.json', name)
            record = read_trusted_json(env, directory, name, 16384) if match else None
            if record is not None and record.get('target') in ASSIGN_TARGETS and len(records) < 32:
                records[match.group(1)] = record
        batch = read_trusted_json(env, directory, 'assignments.json', 16384) or {}
    finally:
        os.close(directory)
    return records, batch


def requested_side(record, batch, key):
    assignments = batch.get('assignments')
    confirmed = assignments.get(key) if isinstance(assignments, dict) else None
    return confirmed if confirmed in ASSIGN_TARGETS else record.get('target')


def collect_devices(env, state):
    """The data of `devices`; also the controllers of `status`."""
    root = trial_root_of(env, state)
    slots = (state or {}).get('controllers') or {}
    receivers = [dict(record, role='main' if record['node'] == slots.get('main') else
                      'guest' if record['node'] == slots.get('guest') else None)
                 for record in list_receiver_records(env)]
    data = {'running': False, 'inventory': 'not-running', 'receivers': receivers, 'controllers': []}
    if root is None:
        return data
    data['running'] = bool(trial_status(env, state)['alive'])
    freshness, rows = read_inventory(env, root)
    records, batch = read_preferences(env, root)
    data['inventory'] = freshness
    controllers = []
    for key in sorted(set(records) | set(rows)):
        record = records.get(key, {})
        row = rows.get(key, {})
        wanted = requested_side(record, batch, key) or 'unassigned'
        connected = bool(row.get('connected')) if freshness == 'fresh' else False
        side = row.get('target') if connected and row.get('target') in ASSIGN_TARGETS else wanted
        name = row.get('name') if isinstance(row.get('name'), str) else record.get('name')
        controllers.append({'id': key, 'name': str(name or 'Controller')[:120], 'side': side, 'requested_side': wanted,
                            'connected': connected, 'active': connected and bool(row.get('active')),
                            'routing_error': 'not-routed' if connected and side != wanted else None})
    data['controllers'] = sorted(controllers, key=lambda c: (c['name'], c['id']))
    return data


# --- operations: start and stop take up to two minutes, so they run in the background -------------------

class Operations:
    """Records under /var/lib/dosplex/operations (root-only, mode 0700), one file per operation."""

    def __init__(self, env, fd):
        self.env, self.fd = env, fd

    @classmethod
    def open(cls, env, create=True):
        base = _open_checked_dir(env, env.var, 0o755, create=False)
        if base is None:
            return None
        os.close(base)
        env.check_write(env.var / OPERATIONS / 'x')
        fd = _open_checked_dir(env, env.var / OPERATIONS, 0o700, create=create, exact_mode=True)
        return cls(env, fd) if fd is not None else None

    def close(self):
        os.close(self.fd)

    @contextlib.contextmanager
    def lock(self):
        lock_fd = os.open('.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=self.fd)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(lock_fd)

    def names(self):
        return sorted(n for n in os.listdir(self.fd) if re.fullmatch(r'[0-9a-f]{32}\.json', n))

    def read(self, op_id):
        record = read_trusted_json(self.env, self.fd, op_id + '.json', MAX_JOURNAL_FILE)
        return record if record is not None and record.get('id') == op_id else None

    def write(self, record):
        name = record['id'] + '.json'
        temporary = '.%s.new-%s' % (name, uuid.uuid4().hex[:8])
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=self.fd)
        try:
            view = memoryview((json.dumps(record, sort_keys=True) + '\n').encode())
            while view:
                view = view[os.write(fd, view):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(temporary, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        os.fsync(self.fd)

    def prune(self):
        """Keep the newest few finished records."""
        finished = []
        for name in self.names():
            record = self.read(name[:-5])
            if record is not None and record.get('state') in ('succeeded', 'failed'):
                finished.append((record.get('created_utc') or '', name))
        for _, name in sorted(finished)[:-OPERATIONS_KEPT]:
            with contextlib.suppress(OSError):
                os.unlink(name, dir_fd=self.fd)


def unit_alive(env, unit):
    """True/False for a transient unit, None when systemctl cannot tell."""
    if not unit or not DOSPLEX_UNIT.fullmatch(unit) or not env.which('systemctl'):
        return None
    proc = env.run(['systemctl', 'is-active', unit], check=False, timeout=15)
    return proc.stdout.strip() in ('active', 'activating', 'reloading')


def fresh_transaction(env, record):
    """The journal transaction an operation started, or None."""
    journal = Journal.open(env)
    if journal is None:
        return None
    with journal:
        fresh = [n for n in journal.names() if n not in record.get('journal_before', [])
                 and TX_RE.fullmatch(n).group(2) == record['action']]
        return journal.load(fresh[-1]) if fresh else None


def reconcile(env, ops, record):
    """A record that says queued/running while its service is gone becomes failed (or interrupted)."""
    if record.get('state') not in ('queued', 'running'):
        return record
    if unit_alive(env, record.get('unit')) is not False:
        return record
    with ops.lock():
        current = ops.read(record['id']) or record
        if current.get('state') in ('queued', 'running'):
            tx = fresh_transaction(env, current)
            interrupted = tx is not None and not tx.ended
            current.update(state='failed', code='interrupted' if interrupted else 'failed', finished_utc=utc_now(),
                           message='The background service ended without a result.' +
                           (' The operation was interrupted; run: sudo dosplex repair' if interrupted else ''))
            ops.write(current)
        return current


def operation_view(env, record):
    """The public form of an operation record (the schema is documented and pinned by tests)."""
    steps, notes = [], []
    tx = fresh_transaction(env, record)
    if tx is not None:
        steps = [{'step': name, 'status': entry['status']} for name, entry in tx.steps().items()]
        notes = tx.notes()
    return {'id': record['id'], 'action': record['action'], 'state': record['state'], 'code': record.get('code'),
            'message': record.get('message'), 'created_utc': record.get('created_utc'),
            'started_utc': record.get('started_utc'), 'finished_utc': record.get('finished_utc'),
            'steps': steps, 'notes': notes}


def active_operations(env, ops):
    found = []
    for name in ops.names():
        record = ops.read(name[:-5])
        if record is not None:
            record = reconcile(env, ops, record)
            if record.get('state') in ('queued', 'running'):
                found.append(record)
    return found


def begin_operation(env, action, plan):
    """Check, create the record and launch the runner in the background. `plan()` raises a ControlError to
    refuse and returns the options the runner needs. Returns the 'accepted' answer."""
    ops = Operations.open(env)
    if ops is None:
        raise NotInstalled('DosPlex is not installed.')
    try:
        with ops.lock():
            busy = active_operations(env, ops)
            if busy:
                raise ControlError('busy', 'Another operation is running (%s %s).' % (busy[0]['action'], busy[0]['id']),
                                   {'operation': operation_view(env, busy[0])})
            probe = Journal.open(env, lock=True)       # a command line `dosplex start` holds the journal
            if probe is not None:
                probe.close()
            options = plan()
            program = installed_program(env)
            if program is None:
                raise DosplexError('cannot find the dosplex program to run in the background')
            journal = Journal.open(env)
            before = journal.names() if journal is not None else []
            if journal is not None:
                journal.close()
            op_id = uuid.uuid4().hex
            unit = 'dosplex-control-%s-%s' % (action, op_id[:8])
            record = {'api': CONTROL_API, 'id': op_id, 'action': action, 'state': 'queued', 'code': None, 'message': None,
                      'created_utc': utc_now(), 'started_utc': None, 'finished_utc': None, 'unit': unit,
                      'options': options, 'journal_before': before}
            ops.write(record)
            command = ['systemd-run', '--quiet', '--collect', '--service-type=exec', '--expand-environment=no',
                       '--unit=' + unit, '--property=RuntimeMaxSec=1500', '--description=DosPlex control ' + action,
                       '--', env.python, str(program), '--sysroot', str(env.sysroot), '_control_op', op_id]
            failure = None
            try:
                proc = env.run(command, check=False, timeout=60)
                if proc.returncode:
                    failure = (proc.stderr.strip().splitlines() or ['systemd-run failed'])[-1]
            except DosplexError as error:
                failure = str(error)
            if failure:
                record.update(state='failed', code='failed', finished_utc=utc_now(),
                              message='The background service did not start: ' + failure)
                ops.write(record)
                raise ControlError('failed', record['message'], {'operation': operation_view(env, record)})
            ops.prune()
        return 'accepted', 'The %s was started in the background.' % action, {'operation': operation_view(env, record)}
    finally:
        ops.close()


def cmd_control_op(env, args):
    """The background runner of one operation (a transient service started by `control start|stop`)."""
    env.require_root()
    if not OPERATION_ID_RE.fullmatch(args.op_id):
        raise UsageError('not an operation id')
    ops = Operations.open(env, create=False)
    if ops is None:
        raise DosplexError('there is no operations directory')
    try:
        with ops.lock():
            record = ops.read(args.op_id)
            if record is None or record.get('state') != 'queued' or record.get('action') not in ('start', 'stop'):
                raise DosplexError('operation %s is not waiting to run' % args.op_id)
            record.update(state='running', started_utc=utc_now())
            ops.write(record)
        code, message = 'ok', None
        try:
            journal = Journal.open(env, lock=True)
            if journal is None:
                raise NotInstalled('DosPlex is not installed')
            with journal:
                journal.require_clean()
                state = read_state(env)
                if state is None:
                    raise NotInstalled('DosPlex is not installed')
                session = Session(env, journal, state)
                if record['action'] == 'start':
                    session.start(record['options'])
                else:
                    session.stop()
        except DosplexError as error:
            code, message = error.error_code, str(error)
        except Exception as error:
            code, message = 'failed', '%s: %s' % (type(error).__name__, error)
        if message is None:
            tx = fresh_transaction(env, record)
            notes = tx.notes() if tx is not None else []
            message = notes[-1] if notes else 'The %s finished.' % record['action']
        with ops.lock():
            record = ops.read(args.op_id) or record
            record.update(state='succeeded' if code == 'ok' else 'failed', code=code, message=hint(message),
                          finished_utc=utc_now())
            ops.write(record)
        return 0 if code == 'ok' else 1
    finally:
        ops.close()


# --- the actions ------------------------------------------------------------------------------------

def control_status(env):
    env.require_root()
    info = collect_status(env)
    state = read_state(env)
    data = {'program_version': CLI_VERSION, 'installed': info['installed'], 'version': info.get('version'),
            'commit': info.get('commit'), 'interrupted': info.get('interrupted'), 'in_progress': info.get('in_progress'),
            'running': False, 'layout': None,
            'brightness': None, 'sides': [], 'controllers': [], 'warnings': [],
            'update': {'checked': False, 'available': None, 'latest': None, 'previous_version': info.get('previous')},
            'operation': None}
    ops = Operations.open(env, create=False)
    if ops is not None:
        try:
            active = active_operations(env, ops)
        finally:
            ops.close()
        if active:
            view = operation_view(env, active[0])
            data['operation'] = {key: view[key] for key in ('id', 'action', 'state')}
    trial = info.get('trial')
    if info['installed'] and trial and trial['alive']:
        data['running'] = True
        root = Path(trial['root'])
        runtime = open_root_dir(env, root / 'runtime')
        if runtime is not None:
            try:
                compositor_state = read_trusted_json(env, runtime, 'state.json') or {}
            finally:
                os.close(runtime)
            layout = compositor_state.get('layout')
            data['layout'] = layout if layout in LAYOUT_NUMBERS else None
            brightness = compositor_state.get('brightness')
            if isinstance(brightness, int) and not isinstance(brightness, bool) and 1 <= brightness <= 100:
                data['brightness'] = brightness
        for name, side in trial['sides'].items():
            session = {}
            directory = open_root_dir(env, root / 'sides' / side['side'])
            if directory is not None:
                try:
                    session = read_trusted_json(env, directory, 'session.json') or {}
                finally:
                    os.close(directory)
            data['sides'].append({'name': name.lower(), 'side': side['side'], 'owner': side['owner'],
                                  'lifecycle': side['lifecycle'],
                                  'mode': session.get('mode') if session.get('mode') in ('gaming', 'desktop') else None})
        data['controllers'] = [{k: c[k] for k in ('id', 'name', 'side', 'connected', 'routing_error')}
                               for c in collect_devices(env, state)['controllers']]
        if trial.get('compositor_active') is False:
            data['warnings'].append('compositor-inactive')
        if trial.get('sleep_guard_active') is False:
            data['warnings'].append('sleep-guard-inactive')
    message = ('DosPlex %s is %s.' % (info['version'], 'running' if data['running'] else 'not running')
               if info['installed'] else 'DosPlex is not installed.')
    return 'ok', message, data


def require_clean_journal(env):
    journal = Journal.open(env)
    if journal is not None:
        with journal:
            journal.require_clean()


def control_start(env):
    env.require_root()
    # Nobody is at a terminal: Steam's own update of its client does not stop this start (see start_acceptance).
    args = argparse.Namespace(output_mode=None, main_hid=None, guest_hid=None, allow_untested=False,
                              sample_seconds=SAMPLE_SECONDS, keep_on_failure=False, unattended=True)

    def plan():
        options, probe = plan_start(env, args)
        if options is None:
            raise ControlError('already-running', 'DosPlex is already running.', {'root': probe['root']})
        return options
    return begin_operation(env, 'start', plan)


def control_stop(env):
    env.require_root()

    def plan():
        require_clean_journal(env)
        state = read_state(env)
        if state is None:
            raise NotInstalled('DosPlex is not installed.')
        session = Session(env, None, state)
        display = Display(env, session.account).record()
        leftover = bool(display and display.get('phase') not in (None, 'restored'))
        if session.trial_alive() is None and not state.get('trial') and not leftover:
            raise ControlError('not-running', 'DosPlex is not running.')
        return {}
    return begin_operation(env, 'stop', plan)


def lookup_operation(env, op_id):
    ops = Operations.open(env, create=False)
    try:
        record = ops.read(op_id) if ops is not None else None
        if record is None:
            raise ControlError('not-found', 'No operation %s.' % op_id)
        return reconcile(env, ops, record)
    finally:
        if ops is not None:
            ops.close()


def control_operation(env, op_id):
    env.require_root()
    record = lookup_operation(env, op_id)
    return 'ok', 'Operation %s is %s.' % (op_id, record['state']), {'operation': operation_view(env, record)}


def control_wait(env, op_id, timeout):
    env.require_root()
    deadline = time.monotonic() + timeout
    while True:
        record = lookup_operation(env, op_id)
        if record['state'] in ('succeeded', 'failed'):
            code = 'ok' if record['state'] == 'succeeded' else (record.get('code') if record.get('code') in CONTROL_CODES else 'failed')
            return code, record.get('message') or 'The operation finished.', {'operation': operation_view(env, record)}
        left = deadline - time.monotonic()
        if left <= 0:
            raise ControlError('timeout', 'The operation is still %s after %g seconds.' % (record['state'], timeout),
                               {'operation': operation_view(env, record), 'timeout_seconds': timeout})
        time.sleep(min(0.5, left))


def control_devices(env):
    env.require_root()
    data = collect_devices(env, read_state(env))
    return 'ok', '%d controller(s), %d receiver slot(s).' % (len(data['controllers']), len(data['receivers'])), data


def require_running(env):
    """The trial root of a running DosPlex, or the matching control error."""
    state = read_state(env)
    if state is None:
        raise NotInstalled('DosPlex is not installed.')
    require_clean_journal(env)
    root = trial_root_of(env, state)
    if root is None or not trial_status(env, state)['alive']:
        raise ControlError('not-running', 'DosPlex is not running.')
    return root


def control_compositor(env, body):
    """One request on the compositor's control socket, after checking the socket is the root-only one; (status, value)."""
    return compositor_request(env, require_running(env), body)


def compositor_request(env, root, body):
    """The same for the session at `root`, whatever the journal says of it: a stop that is under way asks through this."""
    runtime = open_root_dir(env, root / 'runtime')
    if runtime is None:
        raise ControlError('unavailable', 'The compositor runtime directory is not available.')
    try:
        try:
            info = os.stat(CONTROL_SOCKET, dir_fd=runtime, follow_symlinks=False)
        except FileNotFoundError:
            raise ControlError('unavailable', 'The compositor has no control socket (is it an older build?).') from None
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o077:
            raise ControlError('unavailable', 'The compositor control socket is not a root-only socket; not using it.')
        return control_socket_request(runtime, body)
    finally:
        os.close(runtime)


def control_layout(env, layout):
    env.require_root()
    status, value = control_compositor(env, bytes([1, 1, LAYOUT_NUMBERS[layout], 0]))
    if status != 0:
        raise ControlError('permission-denied' if status == 2 else 'failed',
                           'The compositor refused the layout request (status %d).' % status)
    if value != LAYOUT_NUMBERS[layout]:
        raise ControlError('failed', 'The compositor did not switch to %s.' % layout)
    return 'ok', 'The layout is %s.' % layout, {'layout': layout}


def control_brightness(env, percent):
    """Set the built-in screen's brightness; the compositor raises 0 to its 5 % floor and answers with the percent in effect."""
    env.require_root()
    status, value = control_compositor(env, bytes([1, 2, percent, 0]))
    if status == 4:
        raise ControlError('unavailable', 'This machine has no built-in screen brightness to set.')
    if status != 0 or not 1 <= value <= 100:
        raise ControlError('permission-denied' if status == 2 else 'failed',
                           'The compositor refused the brightness request (status %d).' % status)
    return 'ok', 'The screen brightness is %d %%.' % value, {'brightness': value}


def control_socket_request(runtime_fd, body):
    """One fixed request on the compositor's SOCK_SEQPACKET control socket; returns (status, value)."""
    import socket
    # The path through /proc/self/fd keeps the socket name short and pinned to the directory we checked.
    path = '/proc/self/fd/%d/%s' % (runtime_fd, CONTROL_SOCKET)
    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as sock:
        sock.settimeout(5)
        try:
            sock.connect(path)
            sock.send(b'DPXC' + body)
            reply = sock.recv(64)
        except OSError as error:
            raise ControlError('unavailable', 'The compositor did not answer on its control socket (%s).'
                               % (error.strerror or error)) from None
    if len(reply) != 8 or reply[:4] != b'DPXR' or reply[4] != 1:
        raise ControlError('failed', 'The compositor sent a reply this program does not understand.')
    return reply[5], reply[6]


def control_assign(env, controller, target):
    env.require_root()
    root = require_running(env)
    directory = open_root_dir(env, controller_directory(env))
    if directory is None:
        raise ControlError('unavailable', 'The controller preferences are not available.')
    try:
        record = read_trusted_json(env, directory, controller + '.json', 16384)
        if record is None or record.get('target') not in ASSIGN_TARGETS:
            raise ControlError('not-found', 'No controller %s is known.' % controller)
        batch = read_trusted_json(env, directory, 'assignments.json', 16384)
        if batch is None:
            try:
                os.stat('assignments.json', dir_fd=directory, follow_symlinks=False)
            except FileNotFoundError:
                batch = {}
            else:
                raise ControlError('failed', 'assignments.json is not a trustworthy file; not changing it.')
        assignments = batch.setdefault('assignments', {})
        if (not isinstance(assignments, dict) or len(assignments) > 32
                or (controller not in assignments and len(assignments) >= 32)):
            raise ControlError('failed', 'assignments.json is not in the expected shape.')
        previous = requested_side(record, batch, controller)
        if previous != target or 'preview' in batch or 'handoff' in batch:
            assignments[controller] = target
            batch.pop('preview', None)         # what the Devices tab writes: one confirmed owner, no lease
            batch.pop('handoff', None)
            data = (json.dumps(batch) + '\n').encode()
            if len(data) >= 16384:
                raise ControlError('failed', 'assignments.json would grow too large.')
            fd = os.open('assignments.request', os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=directory)
            try:
                view = memoryview(data)
                while view:
                    view = view[os.write(fd, view):]
                os.fsync(fd)
            except BaseException:
                os.unlink('assignments.request', dir_fd=directory)
                raise
            finally:
                os.close(fd)
            os.rename('assignments.request', 'assignments.json', src_dir_fd=directory, dst_dir_fd=directory)
            os.fsync(directory)
    finally:
        os.close(directory)
    applied = None                  # the broker applies the request on its next look; report what it shows
    seconds = 3.0
    if not env.real and os.environ.get('DOSPLEX_TEST_ASSIGN_SECONDS'):
        seconds = float(os.environ['DOSPLEX_TEST_ASSIGN_SECONDS'])
    deadline = time.monotonic() + seconds
    while True:
        row = read_inventory(env, root)[1].get(controller)
        if row is None or not row.get('connected'):
            break
        applied = row.get('target') == target
        if applied or time.monotonic() >= deadline:
            break
        time.sleep(0.1)
    return 'ok', 'Controller %s is requested for %s.' % (controller, target), {
        'id': controller, 'side': target, 'previous_side': previous, 'applied': applied}


def control_forget(env, controller):
    """Ask the routing service to forget a controller that is off or asleep: its number is free again and its row
    leaves the Devices tab. The request is a file `<id>.forget` in the controller directory, which the service (the one
    process that changes a record, under the lock of the numbering) carries out on its next look. A gamepad's record
    goes. A Steam Controller is a slot of the session's receiver and keeps a record, which then says that it waits
    for its first owner: the controller that next wakes on the slot comes back as a new one."""
    env.require_root()
    root = require_running(env)
    directory = open_root_dir(env, controller_directory(env))
    if directory is None:
        raise ControlError('unavailable', 'The controller preferences are not available.')
    try:
        record = read_trusted_json(env, directory, controller + '.json', 16384)
        if record is None or record.get('target') not in ASSIGN_TARGETS:
            raise ControlError('not-found', 'No controller %s is known.' % controller)
        freshness, rows = read_inventory(env, root)
        if freshness != 'fresh':
            raise ControlError('unavailable', 'The routing service is not publishing the controllers.')
        if (rows.get(controller) or {}).get('connected'):
            raise ControlError('refused', 'Controller %s is connected. Turn it off or unplug it first.' % controller)
        slot = record.get('backend') == 'native'
        if slot and controller not in rows:
            raise ControlError('refused', 'Controller %s is on a receiver that is not plugged in.' % controller)
        if slot and record.get('first') == 'pending':
            raise ControlError('refused', 'Controller %s already waits for its first owner.' % controller)
        request = controller + '.forget'
        try:
            os.close(os.open(request, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600,
                             dir_fd=directory))
        except FileExistsError:
            pass                     # (asked already: wait for it like for this one)
        seconds = 3.0
        if not env.real and os.environ.get('DOSPLEX_TEST_ASSIGN_SECONDS'):
            seconds = float(os.environ['DOSPLEX_TEST_ASSIGN_SECONDS'])
        deadline = time.monotonic() + seconds
        while True:
            try:
                os.stat(controller + '.json', dir_fd=directory, follow_symlinks=False)
            except FileNotFoundError:
                break
            if slot:
                # The slot keeps its record; the service has done it when the record waits for its first owner.
                now = read_trusted_json(env, directory, controller + '.json', 16384)
                if isinstance(now, dict) and now.get('first') == 'pending':
                    break
            if time.monotonic() >= deadline:
                try:
                    os.unlink(request, dir_fd=directory)      # (it must not fire later, when the user forgot it)
                except FileNotFoundError:
                    pass
                raise ControlError('unavailable', 'The routing service did not remove controller %s.' % controller)
            time.sleep(0.1)
    finally:
        os.close(directory)
    return 'ok', 'Controller %s is forgotten.' % controller, {'id': controller, 'name': str(record.get('name', ''))[:120]}


def control_eject(env, mount):
    """Eject a card that holds shared games: the store tool releases every account's overlays and binds on it, then has
    udisks unmount it (what Steam's own eject does, which fails while DosPlex's mounts hold the card)."""
    env.require_root()
    try:
        place, report = eject_disk(env, mount)
    except UsageError as error:
        raise ControlError('bad-request', str(error)) from None
    except RefusedError as error:
        raise ControlError('refused', str(error)) from None
    except DosplexError as error:
        text = str(error)
        if 'no disk with a shared game store' in text:
            raise ControlError('not-found', text) from None
        if 'was not ejected' in text:
            raise ControlError('refused', text) from None
        raise ControlError('failed', text) from None
    waiting = sorted(name for name, item in (report.get('released') or {}).items()
                     if isinstance(item, dict) and item.get('stash_waits'))
    data = {'mount': place, 'device': report.get('device'), 'already': bool(report.get('already')),
            'manifests_wait': waiting}
    if report.get('already'):
        return 'ok', '%s is not mounted; nothing to eject.' % place, data
    return 'ok', '%s is ejected; it is safe to pull out.' % place, data


CONTROL_ACTIONS = ('status', 'start', 'stop', 'layout', 'brightness', 'devices', 'assign', 'forget', 'eject', 'operation', 'wait')


def parse_control(words):
    """The action and its typed arguments, or a bad-request error. `--json` is accepted anywhere."""
    words = [w for w in words if w != '--json']
    if not words:
        raise ControlError('bad-request', 'No action given. Actions: ' + ', '.join(CONTROL_ACTIONS) + '.')
    action, rest = words[0], words[1:]
    if action not in CONTROL_ACTIONS:
        raise ControlError('bad-request', 'Unknown action %s. Actions: %s.' % (shown(action), ', '.join(CONTROL_ACTIONS)))

    def positional(count, what):
        if len(rest) != count:
            raise ControlError('bad-request', '%s takes %s.' % (action, what))
        return rest

    if action in ('status', 'start', 'stop', 'devices'):
        positional(0, 'no arguments')
        return action, {}
    if action == 'layout':
        (layout,) = positional(1, 'one argument: vertical, horizontal, single or guest')
        if layout not in LAYOUT_NUMBERS:
            raise ControlError('bad-request', 'Unknown layout %s. Use vertical, horizontal, single or guest.' % shown(layout))
        return action, {'layout': layout}
    if action == 'brightness':
        (percent,) = positional(1, 'one argument: a percentage from 0 to 100')
        if not re.fullmatch(r'[0-9]{1,3}', percent) or int(percent) > 100:
            raise ControlError('bad-request', '%s is not a percentage from 0 to 100.' % shown(percent))
        return action, {'percent': int(percent)}
    if action == 'assign':
        controller, target = positional(2, 'two arguments: a controller id and main, guest or unassigned')
        if not CONTROLLER_ID_RE.fullmatch(controller):
            raise ControlError('bad-request', '%s is not a controller id (32 lowercase hex digits).' % shown(controller))
        if target not in ASSIGN_TARGETS:
            raise ControlError('bad-request', 'Unknown target %s. Use main, guest or unassigned.' % shown(target))
        return action, {'controller': controller, 'target': target}
    if action == 'forget':
        (controller,) = positional(1, 'one argument: a controller id')
        if not CONTROLLER_ID_RE.fullmatch(controller):
            raise ControlError('bad-request', '%s is not a controller id (32 lowercase hex digits).' % shown(controller))
        return action, {'controller': controller}
    if action == 'eject':
        (mount,) = positional(1, 'one argument: where the card is mounted')
        if (not re.fullmatch(r'/[ -~]{1,200}', mount) or '..' in mount.split('/') or '//' in mount
                or os.path.normpath(mount) != mount.rstrip('/') or mount == '/'):
            raise ControlError('bad-request', '%s is not the plain absolute path of a mounted card.' % shown(mount))
        return action, {'mount': mount}
    if action == 'operation':
        (op_id,) = positional(1, 'one argument: an operation id')
        if not OPERATION_ID_RE.fullmatch(op_id):
            raise ControlError('bad-request', '%s is not an operation id (32 lowercase hex digits).' % shown(op_id))
        return action, {'op_id': op_id}
    value = None                               # wait ID [--timeout SECONDS]
    if len(rest) == 3 and rest[1] == '--timeout':
        rest, value = rest[:1], rest[2]
    elif len(rest) == 2 and rest[1].startswith('--timeout='):
        rest, value = rest[:1], rest[1].split('=', 1)[1]
    if len(rest) != 1:
        raise ControlError('bad-request', 'wait takes an operation id and optionally --timeout SECONDS.')
    if not OPERATION_ID_RE.fullmatch(rest[0]):
        raise ControlError('bad-request', '%s is not an operation id (32 lowercase hex digits).' % shown(rest[0]))
    timeout = WAIT_DEFAULT_SECONDS
    if value is not None:
        if not re.fullmatch(r'[0-9]{1,4}(\.[0-9]{1,3})?', value) or not 0 <= float(value) <= WAIT_MAX_SECONDS:
            raise ControlError('bad-request', '--timeout takes a number of seconds from 0 to %d.' % WAIT_MAX_SECONDS)
        timeout = float(value)
    return action, {'op_id': rest[0], 'timeout': timeout}


CONTROL_HANDLERS = {'status': control_status, 'start': control_start, 'stop': control_stop, 'layout': control_layout,
                    'brightness': control_brightness, 'devices': control_devices, 'assign': control_assign, 'forget': control_forget,
                    'eject': control_eject, 'operation': control_operation,
                    'wait': control_wait}


def run_control(sysroot, words):
    """Run one control action and print exactly one JSON object. Never raises, never prints anything else on stdout."""
    code, message, data = 'failed', 'The request failed.', {}
    try:
        action, params = parse_control(words)
        env = Env(sysroot)
        os.umask(0o022)
        installed = env.opt / 'bin' / 'dosplex'
        PROGRAM['name'] = str(installed) if installed.is_file() else 'dosplex'
        with contextlib.redirect_stdout(sys.stderr):
            code, message, data = CONTROL_HANDLERS[action](env, **params)
    except ControlError as error:
        code, message, data = error.error_code, str(error), error.data
    except DosplexError as error:
        code, message = error.error_code, hint(str(error))
    except KeyboardInterrupt:
        code, message = 'failed', 'interrupted'
    except Exception as error:
        if os.environ.get('DOSPLEX_DEBUG') == '1':
            raise
        if isinstance(error, subprocess.TimeoutExpired):
            code, message = 'failed', hint(plain_error(error))
        else:
            code, message = 'failed', 'unexpected %s: %s' % (type(error).__name__, hint(str(error)))
    if code not in CONTROL_CODES:
        code = 'failed'
    print(json.dumps({'api': CONTROL_API, 'ok': code in CONTROL_SUCCESS, 'code': code, 'message': message,
                      'data': data}, sort_keys=True), flush=True)
    return CONTROL_CODES[code]


