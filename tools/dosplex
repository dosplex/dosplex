class Check:
    def __init__(self, name, status, detail):
        self.name, self.status, self.detail = name, status, detail


class Report:
    TAGS = {'ok': 'ok', 'info': 'info', 'warn': 'warn', 'fail': 'FAIL', 'untested': 'UNTESTED',
            'unknown': 'UNKNOWN'}

    def __init__(self):
        self.checks = []
        self.observed = {}

    def add(self, name, status, detail):
        self.checks.append(Check(name, status, detail))

    def failures(self):
        return [c for c in self.checks if c.status == 'fail']

    def untested(self):
        return [c for c in self.checks if c.status in ('untested', 'unknown')]

    def enforce(self, allow_untested):
        failures = self.failures()
        if failures:
            raise RefusedError('preflight failed: ' + '; '.join('%s: %s' % (c.name, c.detail) for c in failures))
        if self.untested() and not allow_untested:
            raise RefusedError('this device is not in the tested set (%s). Nothing was changed. '
                               'Use --allow-untested to continue at your own risk.'
                               % '; '.join('%s: %s' % (c.name, c.detail) for c in self.untested()))

    def text(self):
        lines = ['Preflight']
        for check in self.checks:
            lines.append('  [%-8s] %-14s %s' % (self.TAGS[check.status], check.name, check.detail))
        return '\n'.join(lines)

    def short_text(self):
        """The report as `install` prints it: one line for the checks that passed, then every other check in full."""
        passed = sum(1 for c in self.checks if c.status == 'ok')
        lines = ['Precheck: %d check%s passed.' % (passed, '' if passed == 1 else 's')]
        for check in self.checks:
            if check.status != 'ok':
                lines.append('  [%-8s] %-14s %s' % (self.TAGS[check.status], check.name, check.detail))
        return '\n'.join(lines)

    def as_json(self):
        return {'checks': [{'name': c.name, 'status': c.status, 'detail': c.detail} for c in self.checks],
                'observed': self.observed,
                'refused': bool(self.failures()), 'untested': bool(self.untested())}


def start_acceptance(report, state, allow_untested, unattended):
    """Apply the tested set to a start; raises RefusedError as `report.enforce` does. Returns warnings.

    What was accepted at install (--allow-untested) stays accepted while the observed versions are the ones that were
    seen then. An unattended start is looser in one way only: Steam updates its own client, and a start that nobody
    can answer must survive that. Unattended are the start at boot (CLI-01) and the start through the control
    interface, which is what the entry in Steam's library and a user interface ask for: the person holds a
    controller and has no terminal to say --allow-untested in. The Steam client being untested does not stop such
    a start, and the warning goes to `dosplex status`. A different SteamOS or Gamescope version still refuses,
    unless it is the one accepted at install. A start typed by hand keeps the strict rule: the person is there to
    say --allow-untested.
    """
    accepted = state.get('untested_observed')
    if allow_untested or (accepted is not None and accepted == report.observed):
        report.enforce(True)
        return []
    if not unattended or report.failures():
        report.enforce(False)
        return []
    warnings, blocking = [], []
    installed_untested = state.get('untested') or []
    for check in report.untested():
        key = {'os': 'steamos', 'gamescope': 'gamescope'}.get(check.name)
        if check.name == 'steam-client':
            warnings.append('%s. DosPlex started anyway, because Steam updates itself; the tested set lists '
                            'the client versions it was checked with.' % check.detail)
        elif key and check.name in installed_untested and accepted is not None and accepted.get(key) == report.observed.get(key):
            continue            # accepted at install, and still the version that was accepted
        else:
            blocking.append(check)
    if blocking:
        report.enforce(False)
    report.enforce(True)
    return warnings


def _gate(report, name, label, observed, tested, matches):
    if observed is None:
        report.add(name, 'unknown', '%s could not be read' % label)
    elif tested is None:
        report.add(name, 'info', '%s %s (no manifest, so no tested set to compare with)' % (label, observed))
    elif matches:
        report.add(name, 'ok', '%s %s is in the tested set' % (label, observed))
    else:
        report.add(name, 'untested', '%s %s is not in the tested set' % (label, observed))


def preflight(env, manifest=None, *, op, user=MAIN_USER, hids=None, sample_seconds=SAMPLE_SECONDS, need_bytes=0):
    """Check the device. op is 'install', 'start', 'update' or 'check'. A manifest brings the tested set.

    An update only stages files, so it needs neither a display nor controllers (a restart checks both itself).
    """
    report = Report()
    tested = manifest.tested if manifest is not None else None
    report.add('root', 'ok' if env.is_root() else ('fail' if op != 'check' else 'warn'),
               'running as root' if env.is_root() else 'not root; run with sudo')
    osr = read_os_release(env)
    version_id, build_id = osr.get('VERSION_ID'), osr.get('BUILD_ID')
    gamescope = gamescope_version(env)
    account = user_entry(env, user)
    steam, steam_source = (None, 'no %s account' % user)
    if account is not None:
        steam, steam_source = steam_client_version(env, account)
    report.observed = {'steamos': {'version_id': version_id, 'build_id': build_id},
                       'gamescope': gamescope, 'steam_client': steam}
    if osr.get('ID') != 'steamos':
        report.add('os', 'fail', 'this is not SteamOS (ID=%s)' % osr.get('ID'))
    elif version_id is None:
        report.add('os', 'unknown', 'VERSION_ID could not be read from /etc/os-release')
    else:
        label = 'SteamOS %s build %s' % (version_id, build_id or '?')
        listed = ['%s%s' % (e['version_id'], '/' + e['build_id'] if e.get('build_id') else '')
                  for e in (tested or {}).get('steamos', [])]
        if tested is None:
            report.add('os', 'info', label + ' (no manifest, so no tested set to compare with)')
        elif any(e['version_id'] == version_id and e.get('build_id') in (None, build_id) for e in tested['steamos']):
            report.add('os', 'ok', label + ' is in the tested set')
        else:
            report.add('os', 'untested', '%s is not in the tested set (%s)' % (label, ', '.join(listed) or 'none recorded'))
    _gate(report, 'gamescope', 'Gamescope', gamescope, tested, gamescope in (tested or {}).get('gamescope', []))
    if steam is None and account is not None and tested is not None:
        report.add('steam-client', 'unknown', '%s' % steam_source)
    else:
        _gate(report, 'steam-client', 'Steam client', steam, tested, steam in (tested or {}).get('steam_client', []))
    if account is None:
        report.add('main-user', 'fail', 'the main user "%s" does not exist' % user)
    elif account.uid < MIN_UID or not env.path(account.home).is_dir():
        report.add('main-user', 'fail', '%s (uid %d) needs an ordinary uid and a home directory' % (user, account.uid))
    else:
        report.add('main-user', 'ok', '%s, uid %d' % (user, account.uid))
    wanted = list(OWN_TOOLS) + ([] if op == 'check' else list(TRIAL_TOOLS))
    missing = [t for t in wanted if env.which(t) is None]
    report.add('tools', 'fail' if missing else 'ok', ('missing: ' + ', '.join(missing)) if missing else 'all present')
    nodes = [n for n in RUNTIME_NODES if not env.path('/dev/' + n).exists()]
    report.add('devices', 'fail' if nodes else 'ok', ('missing /dev/' + ', /dev/'.join(nodes)) if nodes else '/dev/uinput and /dev/cuse')
    displays = [d for d in connected_displays(env) if d['status'] == 'connected']
    if output_target(env)['kind'] == 'builtin':
        display_text = 'built-in screen connected (%s)' % ', '.join(d['connector'] for d in displays)
    else:
        display_text = ', '.join(d['connector'] for d in displays) + ' connected'
    report.add('display', 'ok' if displays else ('warn' if op == 'update' else 'fail'),
               display_text if displays else 'no connected display: turn on the TV and check the cable')
    try:
        space = shutil.disk_usage(str(env.path('/opt'))).free
        if need_bytes and space < 2 * need_bytes + (64 << 20):
            report.add('space', 'fail', 'only %d MiB free under /opt' % (space >> 20))
        else:
            report.add('space', 'ok', '%d MiB free under /opt' % (space >> 20))
    except OSError:
        report.add('space', 'warn', '/opt could not be inspected')
    deck = builtin_deck(env)
    if hids and any(hids):
        _check_controllers(env, report, hids, sample_seconds, deck)
    elif deck and op != 'update':
        _check_deck_controls(report, deck)
    elif op not in ('check', 'update'):
        report.add('controllers', 'info', "no controller is needed for this. The first controller you wake is Main's, "
                   "the next is the second player's while they have none, and Devices in the menu changes it")
    trials = trial_roots(env)
    if trials and op == 'install':
        report.add('trial', 'warn', 'a retained trial is already running: ' + ', '.join(str(t) for t in trials))
    legacy = legacy_leftovers(env)
    if legacy:
        report.add('legacy', 'warn', 'traces of the older installer: ' + ', '.join(legacy) + ' (not changed)')
    return report


def _check_deck_controls(report, deck):
    if len(deck) != 3:
        report.add('controllers', 'fail', 'the Steam Deck controller shows %d HID interfaces (%s); expected three'
                   % (len(deck), ', '.join(deck)))
        return
    report.add('controllers', 'ok', "the Steam Deck's own controls (%s) are Main's. The first other controller you "
               "wake or pair is the second player's; Devices in the menu changes it" % ', '.join(deck))


def _check_controllers(env, report, hids, sample_seconds, deck=()):
    """Check the slots that were given: each has to be a supported receiver slot, and the two distinct. A slot is
    never a condition for starting by being awake: with sample_seconds the report says which controller is asleep."""
    main, guest = hids
    given = [hid for hid in hids if hid is not None]
    try:
        if deck:
            # A Steam Deck: Main has the built-in controls; Guest's receiver slot is optional.
            if main is not None:
                raise DosplexError("this is a Steam Deck: Main's controls are its built-in ones (ADR-014), so "
                                  "--main-hid does not apply. Pass --guest-hid /dev/hidrawY for Guest's controller, "
                                  "or no slot at all")
            if len(deck) != 3:
                raise DosplexError('the Steam Deck controller shows %d HID interfaces (%s); expected three'
                                  % (len(deck), ', '.join(deck)))
            if guest is None:
                return _check_deck_controls(report, deck)
            hid_slot(env, guest)
            text = "the Steam Deck's own controls (Main) and %s (Guest)" % guest
        else:
            keys = [hid_slot(env, hid) for hid in given]
            if len(given) == 2 and (main == guest or keys[0] == keys[1]):
                raise DosplexError('choose two distinct controller slots')
            text = ' and '.join(['%s (Main)' % main] * (main is not None) + ['%s (Guest)' % guest] * (guest is not None))
        report.add('controllers', 'ok', text + ('' if sample_seconds > 0 else ', not sampled'))
        if sample_seconds > 0:
            counts = sample_reports(env, given, sample_seconds)
            for node in given:
                if not counts[node]['ibex-input']:
                    report.add('controller-input', 'info', 'no native Steam Controller input was seen on %s: the '
                               'controller is asleep. It works once it wakes' % node)
    except DosplexError as error:
        report.add('controllers', 'fail', str(error))


# ---------------------------------------------------------------------------------------------------
# The journal: write-ahead, one file per transaction, under <sysroot>/var/lib/dosplex/journal (root, 0700).
#
# Records are JSON lines: begin, then per step intent -> done, a commit that carries the rest of the plan,
# undo-intent -> undone while rolling back, and a final end. A step is applied only after its intent is on
# disk, and every step is idempotent, so `dosplex repair` can run the same step again from its record.
# ---------------------------------------------------------------------------------------------------

def _open_checked_dir(env, path, mode, *, create, exact_mode=False):
    """Open a directory root owns, refusing a symlink, another owner and loose permissions."""
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        if not create:
            return None
        os.mkdir(path, mode)
        os.chmod(path, mode)
        info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode):
        raise JournalError('%s is a symlink; refusing to use it' % path)
    if not stat.S_ISDIR(info.st_mode):
        raise JournalError('%s is not a directory' % path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise JournalError('cannot open %s: %s' % (path, os.strerror(error.errno))) from None
    opened = os.fstat(fd)
    if (opened.st_ino, opened.st_dev) != (info.st_ino, info.st_dev):
        os.close(fd)
        raise JournalError('%s changed while it was opened' % path)
    if opened.st_uid != env.trusted_uid:
        owner = describe_owner(env, opened.st_uid)
        os.close(fd)
        raise JournalError('%s is not owned by root; refusing to use it. It is owned by %s.\n'
                           'Fix: sudo chown root:root %s && sudo chmod %04o %s' % (path, owner, path, mode, path))
    if (opened.st_mode & 0o022) or (exact_mode and stat.S_IMODE(opened.st_mode) != mode):
        current = stat.S_IMODE(opened.st_mode)
        os.close(fd)
        raise JournalError('%s has mode %04o; it must be %04o.\nFix: sudo chmod %04o %s'
                           % (path, current, mode, mode, path))
    return fd


class Tx:
    """One transaction file. Appending a record writes and syncs it before returning."""

    def __init__(self, journal, name, records, fd):
        self.journal, self.name, self.records, self.fd = journal, name, records, fd
        match = TX_RE.fullmatch(name)
        self.op = match.group(2) if match else '?'

    # --- reading -------------------------------------------------------------------------------
    @property
    def ended(self):
        return any(r['kind'] == 'end' for r in self.records)

    @property
    def outcome(self):
        ends = [r for r in self.records if r['kind'] == 'end']
        return ends[-1].get('outcome') if ends else None

    @property
    def committed(self):
        return any(r['kind'] == 'commit' for r in self.records)

    @property
    def begin(self):
        return self.records[0] if self.records and self.records[0]['kind'] == 'begin' else {}

    @property
    def plan(self):
        for record in reversed(self.records):
            if record['kind'] == 'commit':
                return record.get('plan', [])
        return self.begin.get('plan', [])

    def steps(self):
        """step name -> {'status', 'data' (the intent), 'result' (the done record)} in order of first use."""
        steps = OrderedDict()
        for record in self.records:
            name = record.get('step')
            if name is None:
                continue
            entry = steps.setdefault(name, {'status': 'absent', 'data': {}, 'result': {}})
            kind = record['kind']
            if kind == 'intent':
                entry.update(status='intent', data=record.get('data', {}))
            elif kind == 'done':
                entry.update(status='done', result=record.get('data', {}))
            elif kind in ('undo-intent', 'undone', 'skipped'):
                entry['status'] = kind
                if kind == 'undone':
                    entry['undone'] = record.get('data', {})
        return steps

    def status(self, step):
        return self.steps().get(step, {'status': 'absent'})['status']

    # --- writing -------------------------------------------------------------------------------
    def point(self, kind, step=None):
        return '%s:%s%s' % (self.op, kind, ':' + step if step else '')

    def append(self, kind, **fields):
        if self.fd is None:
            raise JournalError('this journal file is open read-only')
        record = dict(fields, kind=kind, i=len(self.records), t=utc_now())
        line = (json.dumps(record, sort_keys=True, separators=(',', ':')) + '\n').encode()
        view = memoryview(line)
        while view:
            view = view[os.write(self.fd, view):]
        os.fsync(self.fd)
        self.records.append(record)
        self.journal.env.fault(self.point(kind, fields.get('step')))
        return record

    def run(self, step, data, apply):
        """intent -> apply -> done. `apply(data)` must be idempotent: repair may run it again."""
        self.append('intent', step=step, data=data)
        result = apply(data)
        self.journal.env.fault(self.point('applied', step))
        self.append('done', step=step, data=result if isinstance(result, dict) else {})
        return result if isinstance(result, dict) else {}

    def redo(self, step, apply):
        """Finish a step whose intent is already on disk."""
        data = self.steps()[step]['data']
        result = apply(data)
        self.journal.env.fault(self.point('applied', step))
        self.append('done', step=step, data=result if isinstance(result, dict) else {})
        return result if isinstance(result, dict) else {}

    def undo(self, step, revert):
        """undo-intent -> revert -> undone. `revert(data, result)` is idempotent and may return a dict
        (for example {'kept': True}) that is recorded with the undone record."""
        entry = self.steps()[step]
        self.append('undo-intent', step=step)
        outcome = revert(entry['data'], entry['result'])
        self.journal.env.fault(self.point('applied-undo', step))
        self.append('undone', step=step, data=outcome if isinstance(outcome, dict) else {})

    def skip(self, step, reason):
        self.append('skipped', step=step, reason=reason)

    def note(self, text):
        """A line for the person who ran the command. The work may run in a background service whose
        output nobody sees, so the line is kept in the journal and the command prints it when it ends."""
        text = hint(text)
        print(text, flush=True)
        self.append('note', text=text)

    def notes(self, after=0):
        return [r['text'] for r in self.records[after:] if r['kind'] == 'note']

    def error(self, text):
        """Why the operation stopped without an end, so that repair has work to do. The command shows it."""
        text = hint(text)
        print(text, file=sys.stderr, flush=True)
        self.append('error', text=text)

    def errors(self, after=0):
        return [r['text'] for r in self.records[after:] if r['kind'] == 'error']

    def commit(self, plan):
        self.append('commit', plan=plan)

    def end(self, outcome, **fields):
        self.append('end', outcome=outcome, **fields)


class Journal:
    def __init__(self, env, journal_fd, state_fd, lock_fd):
        self.env, self.fd, self.state_fd, self.lock_fd = env, journal_fd, state_fd, lock_fd

    @classmethod
    def open(cls, env, *, create=False, lock=False):
        """Open (and with create, make) the journal. Returns None when it does not exist.

        Raises JournalError for a symlinked or non-root journal directory, loose permissions or a
        concurrent writer.
        """
        base = env.path('/var/lib')
        try:
            info = os.stat(base)
        except OSError:
            raise JournalError('%s does not exist' % base) from None
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o022:
            raise JournalError('%s is not a directory that only root can change (it is owned by %s, mode %04o); '
                               'look at it before installing anything'
                               % (base, describe_owner(env, info.st_uid), stat.S_IMODE(info.st_mode)))
        state_fd = journal_fd = lock_fd = None
        try:
            env.check_write(env.var / 'x')
            state_fd = _open_checked_dir(env, env.var, 0o755, create=create)
            if state_fd is None:
                return None
            journal_dir = env.var / 'journal'
            journal_fd = _open_checked_dir(env, journal_dir, 0o700, create=create, exact_mode=True)
            if journal_fd is None:
                os.close(state_fd)
                return None
            if lock:
                lock_fd = os.open('.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=journal_fd)
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    raise BusyError('another dosplex operation is running; wait for it or see: dosplex status') from None
        except BaseException:
            for fd in (state_fd, journal_fd, lock_fd):
                if fd is not None:
                    os.close(fd)
            raise
        return cls(env, journal_fd, state_fd, lock_fd)

    def close(self):
        for fd in (self.lock_fd, self.fd, self.state_fd):
            if fd is not None:
                os.close(fd)
        self.lock_fd = self.fd = self.state_fd = None

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    # --- reading -------------------------------------------------------------------------------
    def names(self):
        return sorted(n for n in os.listdir(self.fd) if TX_RE.fullmatch(n))

    def load(self, name, writable=False):
        flags = (os.O_RDWR | os.O_APPEND) if writable else os.O_RDONLY
        try:
            fd = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=self.fd)
        except OSError as error:
            raise JournalError('cannot open journal file %s: %s' % (name, os.strerror(error.errno))) from None
        try:
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != self.env.trusted_uid
                    or info.st_mode & 0o077 or info.st_nlink != 1 or info.st_size > MAX_JOURNAL_FILE):
                where = self.env.var / 'journal' / name
                raise JournalError('journal file %s is not a private root-owned file (owner %s, mode %04o).\n'
                                   'Fix: sudo chown root:root %s && sudo chmod 0600 %s'
                                   % (name, describe_owner(self.env, info.st_uid), stat.S_IMODE(info.st_mode),
                                      where, where))
            data = b''
            while True:
                chunk = os.read(fd, 1 << 20)
                if not chunk:
                    break
                data += chunk
            records = []
            lines = data.split(b'\n')
            tail = lines.pop()              # b'' after a complete last line, else a torn record
            for number, line in enumerate(lines):
                try:
                    record = json.loads(line)
                    if not isinstance(record, dict) or not isinstance(record.get('kind'), str):
                        raise ValueError
                except ValueError:
                    raise JournalError('journal file %s has a damaged record at line %d; not guessing past it'
                                       % (name, number + 1)) from None
                records.append(record)
            if tail and writable:
                os.ftruncate(fd, len(data) - len(tail))     # a crash tore the last record: drop it
                os.fsync(fd)
        except BaseException:
            os.close(fd)
            raise
        if not writable:
            os.close(fd)
            fd = None
        return Tx(self, name, records, fd)

    def transactions(self):
        return [self.load(name) for name in self.names()]

    def interrupted(self):
        """The transaction a crash left open, or None."""
        open_ones = [tx for tx in self.transactions() if not tx.ended]
        if len(open_ones) > 1:
            raise JournalError('more than one interrupted operation (%s); inspect the journal'
                               % ', '.join(tx.name for tx in open_ones))
        return open_ones[0] if open_ones else None

    def require_clean(self):
        tx = self.interrupted()
        if tx is not None:
            raise NeedsRepair('an earlier %s was interrupted (%s). Run: sudo dosplex repair' % (tx.op, tx.name))

    # --- writing -------------------------------------------------------------------------------
    def begin(self, op, **fields):
        names = self.names()
        sequence = max([int(TX_RE.fullmatch(n).group(1)) for n in names] + [0]) + 1
        name = '%04d-%s.jsonl' % (sequence, op)
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=self.fd)
        os.fsync(self.fd)
        tx = Tx(self, name, [], fd)
        tx.append('begin', op=op, schema=SCHEMA, cli=CLI_VERSION, **fields)
        return tx

    def reopen(self, tx):
        return self.load(tx.name, writable=True)

    def history(self):
        """The last Guest that DosPlex owns according to the journal, or None.

        A Guest that DosPlex created, or that an earlier DosPlex install adopted, stays known after an
        uninstall that kept it, so a reinstall adopts it and --remove-guest may still remove it.
        """
        owned = ('created', 'adopted-dosplex') + (LEGACY_OWNED_ORIGINS if self.env.legacy else ())
        known = None
        for tx in self.transactions():
            step = tx.steps().get('guest')
            if step is None:
                continue
            if tx.op == 'install':
                if step['status'] == 'done':
                    known = step['result'] if step['result'].get('origin') in owned else None
                elif step['status'] == 'undone' and step.get('undone', {}).get('kept'):
                    known = step['result'] or step['data']
            elif tx.op == 'uninstall' and step['status'] == 'done':
                known = step['result'] if step['result'].get('action') == 'kept' else None
        return known


# --- the state file --------------------------------------------------------------------------------

def read_state(env):
    """The installed state, or None. World-readable by design: it holds no secrets.

    The directory it lives in is checked first (a real directory that root owns), so a symlinked
    /var/lib/dosplex is refused here as well as for the journal.
    """
    try:
        base = os.stat(env.path('/var/lib'))
    except OSError:
        return None
    if not stat.S_ISDIR(base.st_mode):
        return None
    directory = _open_checked_dir(env, env.var, 0o755, create=False)
    if directory is None:
        return None
    try:
        try:
            fd = os.open('state.json', os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory)
        except FileNotFoundError:
            return None
        except OSError as error:
            raise DosplexError('cannot read %s: %s' % (env.var / 'state.json', os.strerror(error.errno))) from None
    finally:
        os.close(directory)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_MANIFEST * 4 or info.st_uid != env.trusted_uid:
            raise DosplexError('%s is not a state file that root wrote (owner %s).\nFix: sudo chown root:root %s '
                              '&& sudo chmod 0644 %s' % (env.var / 'state.json', describe_owner(env, info.st_uid),
                                                         env.var / 'state.json', env.var / 'state.json'))
        try:
            state = json.loads(stream.read())
        except ValueError:
            raise DosplexError('%s is damaged (not JSON). Install again to rewrite it.' % (env.var / 'state.json')) from None
    if not isinstance(state, dict) or state.get('schema') != SCHEMA:
        raise DosplexError('%s has an unknown format' % (env.var / 'state.json'))
    problem = state_problem(env, state)
    if problem:
        raise DosplexError('%s is damaged (%s). Install again to rewrite it.' % (env.var / 'state.json', problem))
    return state


def state_problem(env, state):
    """What is wrong with a state file, or None. Its values become paths and commands, so check them."""
    version = state.get('version')
    if not isinstance(version, str) or not VERSION_RE.fullmatch(version) or state.get('release') != 'releases/' + version:
        return 'version and release do not agree'
    if not isinstance(state.get('manifest_sha256'), str) or not SHA256_RE.fullmatch(state['manifest_sha256']):
        return 'manifest digest'
    if not isinstance(state.get('commit'), str) or not isinstance(state.get('main_user'), str) or \
            not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', state['main_user']):
        return 'commit or main user'
    trial = state.get('trial')
    if trial is not None:
        root = Path(str(trial.get('root', ''))) if isinstance(trial, dict) else None
        if root is None or root.parent != env.path('/run') or not (
                LEGACY_TRIAL_RE if env.legacy else TRIAL_RE).fullmatch(root.name):
            return 'trial root'
    for key in ('guest', 'controllers'):
        if state.get(key) is not None and not isinstance(state[key], dict):
            return key
    store = state.get('game_store')
    if store is not None and (not isinstance(store, str) or not os.path.isabs(store) or '\0' in store
                              or '..' in store.split('/')):
        return 'shared game library place'
    if state.get('game_store_auto') is not None and not isinstance(state['game_store_auto'], bool):
        return 'automatic sharing choice'
    if state.get('autostart') is not None and not isinstance(state['autostart'], bool):
        return 'start at boot choice'
    # The signature facts of a signed release and the record of the previous release (written by dosplex 0.2).
    if state.get('signed') is not None and not _signed_fact_ok(state['signed']):
        return 'signature record'
    info = state.get('previous_info')
    if info is not None:
        if (not isinstance(info, dict) or not isinstance(info.get('manifest_sha256'), str)
                or not SHA256_RE.fullmatch(info['manifest_sha256']) or not isinstance(info.get('commit'), str)
                or not isinstance(info.get('scope'), str)
                or (info.get('signed') is not None and not _signed_fact_ok(info['signed']))
                or state.get('previous') is None):
            return 'previous release record'
    return None


def _signed_fact_ok(value):
    return (isinstance(value, dict) and isinstance(value.get('key_id'), str)
            and re.fullmatch(r'[0-9A-F]{16}', value['key_id']) is not None
            and type(value.get('sequence')) is int and 1 <= value['sequence'] < 1 << 40)


def write_state(env, state):
    env.write_file(env.var / 'state.json', (json.dumps(state, indent=2, sort_keys=True) + '\n').encode(), 0o644)


# ---------------------------------------------------------------------------------------------------
# install: the steps. Each apply function is idempotent and gets everything it needs from the journal
# record of its step, because repair runs it again from that record.
# ---------------------------------------------------------------------------------------------------

def token_of(tx):
    return tx.name[:-len('.jsonl')]


def current_version(env):
    try:
        target = os.readlink(env.opt / 'current')
    except OSError:
        return None
    found = re.fullmatch(r'releases/(%s)' % VERSION_RE.pattern, target)
    if found and (env.opt / 'releases' / found.group(1)).is_dir():
        return found.group(1)
    return None


def _write_exclusive(path, data, mode):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)


def write_tree(env, root, verified):
    """Write the verified bytes (never the bundle path again) into a fresh directory."""
    root = env.check_write(root)
    made = []

    def ensure(directory):
        if directory in made:
            return
        if directory != root:
            ensure(directory.parent)
        os.mkdir(directory, 0o755)
        os.chmod(directory, 0o755)
        made.append(directory)
    ensure(root)
    for name, (data, mode) in sorted(verified.files.items()):
        target = root / name
        ensure(target.parent)
        _write_exclusive(target, data, mode)
    _write_exclusive(root / 'manifest.json', verified.manifest.raw, 0o644)
    for directory in reversed(made):
        fsync_dir(directory)


def apply_stage(env, data, verified, cli_bytes, op='install'):
    env.ensure_dir(env.opt)
    releases = env.ensure_dir(env.opt / 'releases')
    if not data['skip_release']:
        staging = releases / data['release_staging']
        env.rmtree(staging)
        write_tree(env, staging, verified)
        env.fault('%s:inner:staged' % op)
        verify_directory(staging, data['manifest_sha256'], installed_uid=env.trusted_uid)
    if data['cli_staging']:
        env.ensure_dir(env.opt / 'bin')
        env.write_file(env.opt / 'bin' / data['cli_staging'], cli_bytes, 0o755)
    return {}


def undo_stage(env, tx, data, result):
    env.rmtree(env.opt / 'releases' / data['release_staging'])
    if data['cli_staging']:
        env.unlink(env.opt / 'bin' / data['cli_staging'])


def apply_release(env, tx, data):
    releases = env.opt / 'releases'
    target = releases / data['version']
    staging = releases / data['release_staging']
    if lexists(target):
        verify_directory(target, data['manifest_sha256'], installed_uid=env.trusted_uid)
        env.rmtree(staging)
        return {'created': False}
    if not staging.is_dir():
        raise DosplexError('the staged release is missing; run: sudo dosplex repair')
    verify_directory(staging, data['manifest_sha256'], installed_uid=env.trusted_uid)
    os.rename(staging, env.check_write(target))
    fsync_dir(releases)
    env.fault('%s:inner:release-renamed' % tx.op)
    return {'created': True}


def undo_release(env, tx, data, result):
    releases = env.opt / 'releases'
    env.rmtree(releases / data['release_staging'])
    if not data['existed']:
        env.rmtree(releases / data['version'])


def apply_current(env, tx, data):
    target = 'releases/' + data['version']
    if not (env.opt / 'releases' / data['version']).is_dir():
        raise DosplexError('release %s is missing' % data['version'])
    link = env.opt / 'current'
    if os.path.islink(link) and os.readlink(link) == target:
        return {}
    env.replace_symlink(link, target)
    return {}


def undo_current(env, tx, data, result):
    link = env.opt / 'current'
    previous = data.get('previous_current')
    if previous and (env.opt / 'releases' / previous).is_dir():
        env.replace_symlink(link, 'releases/' + previous)
    elif os.path.islink(link) and os.readlink(link) == 'releases/' + data['version']:
        env.unlink(link)


def apply_cli(env, tx, data):
    installed = env.opt / 'bin' / 'dosplex'
    staged = env.opt / 'bin' / data['cli_staging']
    if lexists(staged):
        env.check_write(installed)
        os.replace(staged, installed)
        fsync_dir(installed.parent)
    if not installed.is_file() or sha256_bytes(installed.read_bytes()) != data['sha256']:
        raise DosplexError('the installed dosplex program does not match the staged copy')
    return {}


def undo_cli(env, tx, data, result):
    env.unlink(env.opt / 'bin' / data['cli_staging'])
    if not data['had_cli']:
        env.unlink(env.opt / 'bin' / 'dosplex')


def apply_cli_update(env, tx, data):
    """Put the staged program in place of the installed one and keep the one it replaces as dosplex.previous.

    Safe to run again: once the replacement happened the staged file is gone and the previous copy is not touched.
    """
    installed = env.opt / 'bin' / 'dosplex'
    staged = env.opt / 'bin' / data['cli_staging']
    if lexists(staged):
        env.check_write(installed)
        old = installed.read_bytes() if installed.is_file() else None
        if old is not None and sha256_bytes(old) == data['previous_sha256']:
            env.write_file(env.opt / 'bin' / PREVIOUS_CLI, old, 0o755)
            env.fault('%s:inner:program-kept' % tx.op)
        os.replace(staged, installed)
        fsync_dir(installed.parent)
    if not installed.is_file() or sha256_bytes(installed.read_bytes()) != data['sha256']:
        raise DosplexError('the installed dosplex program does not match the staged copy')
    return {}


def undo_cli_update(env, tx, data, result):
    installed, previous = env.opt / 'bin' / 'dosplex', env.opt / 'bin' / PREVIOUS_CLI
    env.unlink(env.opt / 'bin' / data['cli_staging'])
    if installed.is_file() and sha256_bytes(installed.read_bytes()) == data['sha256'] and previous.is_file() and \
            sha256_bytes(previous.read_bytes()) == data['previous_sha256']:
        env.write_file(installed, previous.read_bytes(), 0o755)          # the replacement had happened: put it back
        if not data['had_previous']:
            env.unlink(previous)


def apply_update_state(env, tx, data):
    state = dict(data['previous_state'])
    state.update(
        version=data['version'], commit=data['commit'], scope=data['scope'], manifest_sha256=data['manifest_sha256'],
        release='releases/' + data['version'], previous=data['previous'], previous_info=data['previous_info'],
        installed_utc=data['installed_utc'], signed=data['signed'], untested=data['untested'],
        untested_observed=data['untested_observed'])
    if data['cli_sha256']:
        state['cli'] = {'version': data['cli_version'], 'sha256': data['cli_sha256']}
    write_state(env, state)
    return {}


def apply_rollback_state(env, tx, data):
    state = dict(data['previous_state'])
    state.update(
        version=data['version'], commit=data['commit'], scope=data['scope'], manifest_sha256=data['manifest_sha256'],
        release='releases/' + data['version'], previous=data['previous'], previous_info=data['previous_info'],
        installed_utc=data['installed_utc'], signed=data['signed'], untested=data['untested'],
        untested_observed=data['untested_observed'])
    write_state(env, state)
    return {}


def apply_state(env, tx, data):
    steps = tx.steps()
    guest = steps['guest']['result']
    defaults = data['defaults'] or steps['defaults']['result']
    # Every group dosplex has taken Guest out of, so that uninstall can put them back.
    stripped = [name.split(':', 1)[1] for name, step in steps.items()
                if name.startswith('guest-group:') and step['status'] == 'done']
    before = (data['previous_state'] or {}).get('guest') or data.get('inherited_guest') or {}
    if before.get('uid') == guest.get('uid'):
        stripped = list(dict.fromkeys(list(before.get('stripped_groups') or []) + stripped))
    state = {
        'schema': SCHEMA, 'version': data['version'], 'commit': data['commit'], 'scope': data['scope'],
        'manifest_sha256': data['manifest_sha256'], 'release': 'releases/' + data['version'],
        'previous': data['previous'], 'installed_utc': data['installed_utc'],
        'previous_info': data.get('previous_info'), 'signed': data.get('signed'),
        'cli': {'version': data.get('cli_version') or CLI_VERSION, 'sha256': data['cli_sha256']},
        'main_user': data['main_user'],
        'guest': dict({key: guest.get(key) for key in ('user', 'uid', 'gid', 'home', 'origin', 'home_mode_before')},
                      stripped_groups=stripped),
        'defaults': defaults, 'controllers': data['controllers'], 'output_mode': data['output_mode'],
        'untested': data['untested'], 'untested_observed': data['untested_observed'],
        'session': data['session'], 'trial': data['trial'],
    }
    # An install over an install keeps the shared game library on: its boot unit and its store are still there.
    store = (data['previous_state'] or {}).get('game_store')
    if store:
        state['game_store'] = store
        if (data['previous_state'] or {}).get('game_store_auto') is not None:
            state['game_store_auto'] = data['previous_state']['game_store_auto']
    # So does the start at boot: the unit is still there, and it runs the program this install keeps.
    if (data['previous_state'] or {}).get('autostart'):
        state['autostart'] = True
    # The entry for Steam's library: set up, or turned off by its owner. A release change keeps either answer.
    if isinstance((data['previous_state'] or {}).get('entry'), bool):
        state['entry'] = data['previous_state']['entry']
    env.ensure_dir(env.var)
    write_state(env, state)
    return {}


def undo_state(env, tx, data, result):
    if data['previous_state'] is not None:
        write_state(env, data['previous_state'])
    else:
        env.unlink(env.var / 'state.json')


def apply_prune(env, tx, data):
    keep = set(data['keep'])
    removed = []
    releases = env.opt / 'releases'
    for entry in sorted(releases.iterdir()):
        if entry.name not in keep and (VERSION_RE.fullmatch(entry.name) or entry.name.startswith(STAGING_PREFIX)):
            env.rmtree(entry)
            removed.append(entry.name)
    bin_dir = env.opt / 'bin'
    if bin_dir.is_dir():
        for entry in sorted(bin_dir.iterdir()):
            if entry.name.startswith(STAGED_CLI_PREFIXES):
                env.unlink(entry)
    return {'removed': removed}


