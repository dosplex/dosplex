def library_systemctl(env, verb, *units):
    """Start or stop a unit of the automatic sharing. A failure is said and never stops the operation."""
    try:
        proc = env.run(['systemctl', verb, *units], check=False, timeout=60)
    except DosplexError as error:
        say('Could not %s %s: %s' % (verb, ' and '.join(units), error))
        return
    if proc.returncode:
        say('Could not %s %s: %s' % (verb, ' and '.join(units), (proc.stderr or '').strip() or 'systemctl said no'))


