class CommandFailed(DosplexError):
    def __init__(self, argv, proc):
        detail = ((proc.stderr or '') + (proc.stdout or '')).strip().splitlines()
        super().__init__('%s failed (exit %s)%s' % (os.path.basename(argv[0]), proc.returncode,
                                                      ': ' + detail[-1] if detail else ''))
        self.proc = proc


# How the person running the program types it. Messages say `sudo dosplex ...`; this puts the path that works
# on their device in its place: the installed program once there is one, else the file they started.
PROGRAM = {'name': 'dosplex'}


def hint(text):
    return text.replace('sudo dosplex ', 'sudo %s ' % PROGRAM['name'])


def plain_error(error):
    """The text of an error for the person. A command that timed out is named by its base name and given a
    try again; its full command line is never shown. Every other error keeps its own text."""
    if isinstance(error, subprocess.TimeoutExpired):
        cmd = error.cmd
        words = [str(word) for word in cmd] if isinstance(cmd, (list, tuple)) else str(cmd).split()
        # `runuser -u deck -- /usr/bin/env -i NAME=value ... systemctl ...` is a wrapper around the program that
        # did not answer: name that program, not the wrapper.
        if '--' in words:
            words = words[words.index('--') + 1:]
        while words and (os.path.basename(words[0]) == 'env' or words[0].startswith('-') or '=' in words[0]):
            words = words[1:]
        name = os.path.basename(words[0]) if words else 'A command'
        if error.timeout is None:
            return '%s did not answer. Try again' % name
        return '%s did not finish in %s seconds. Try again' % (name, error.timeout)
    return str(error)


def say(message=''):
    print(hint(message), flush=True)


def utc_now():
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())


def sha256_bytes(data):
    return hashlib.sha256(data).hexdigest()


def is_under(path, parent):
    path, parent = os.path.abspath(str(path)), os.path.abspath(str(parent))
    return path == parent or path.startswith(parent.rstrip('/') + '/')


def fsync_dir(path):
    fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def lexists(path):
    return os.path.lexists(str(path))


def own_path():
    """The file this program runs from (resolved), or None when it was not started from a file."""
    try:
        return Path(os.path.realpath(__file__))
    except NameError:
        return None


