def read_small_json(path, limit=1 << 20):
    try:
        with open(path, 'rb') as stream:
            return json.loads(stream.read(limit))
    except (OSError, ValueError):
        return None


def trial_status(env, state):
    trial = (state or {}).get('trial')
    root = Path(trial['root']) if trial else None
    details = {'root': None, 'alive': False, 'sides': {}, 'guest_audio_endpoint': None,
               'foreign': [str(p) for p in trial_roots(env) if root is None or p != root]}
    if root is None or not root.is_dir():
        details['stale'] = bool(trial)
        return details
    record = read_small_json(root / 'transaction.json') or {}
    details.update(root=str(root), alive=record.get('phase') == 'started', phase=record.get('phase'),
                   unit=record.get('unit'))
    if record.get('unit') and DOSPLEX_UNIT.fullmatch(record['unit']) and env.which('systemctl'):
        proc = env.run(['systemctl', 'is-active', record['unit']], check=False, timeout=15)
        details['compositor_active'] = proc.stdout.strip() == 'active'
        if details['alive'] and proc.stdout.strip() in ('inactive', 'failed'):
            # The record says started, the compositor is gone (it crashed or quit): DosPlex is not running, and
            # stock Steam has to be brought back before anything starts again (TRL-03).
            details.update(alive=False, ended=True)
    guard = record.get('sleep_guard_unit')
    if guard and DOSPLEX_UNIT.fullmatch(guard) and env.which('systemctl'):
        proc = env.run(['systemctl', 'is-active', guard], check=False, timeout=15)
        details['sleep_guard_active'] = proc.stdout.strip() == 'active'
    for side, name in (('left', 'Main'), ('right', 'Guest')):
        session = read_small_json(root / 'sides' / side / 'session.json') or {}
        accounts = session.get('controller_tour_accounts')
        details['sides'][name] = {'side': side, 'owner': session.get('owner'), 'lifecycle': session.get('lifecycle'),
                                  'restart_count': session.get('restart_count'),
                                  'controller_tour_accounts': [a for a in accounts if isinstance(a, str) and a.isdigit()]
                                  if isinstance(accounts, list) else []}
    endpoint = root / 'audio-guest' / 'pulse' / 'native'
    try:
        present = endpoint.exists()
    except OSError:
        present = None          # Guest's audio directory is private to Guest; only root can look inside
    details['guest_audio_endpoint'] = {'path': 'unix:' + str(endpoint), 'present': present}
    return details


def collect_status(env):
    info = {'cli_version': CLI_VERSION, 'installed': False, 'interrupted': None,
            'legacy': [str(p) for p in (env.path(LEGACY_OPT), env.path(LEGACY_VAR), *legacy_trial_roots(env))
                       if lexists(p)]}
    state = read_state(env)
    journal = None
    if env.is_root():
        journal = Journal.open(env)
    else:
        info['note'] = 'not root: the journal is not shown (run with sudo)'
    try:
        if journal is not None:
            tx = journal.interrupted()
            if tx is not None:
                detail = {'op': tx.op, 'name': tx.name, 'last': tx.records[-1]['kind'] if tx.records else None}
                # An operation that is still running is not an interrupted one: it holds the journal's lock.
                info['in_progress' if journal_lock_held(journal.fd) else 'interrupted'] = detail
            if state is None:
                kept = journal.history()
                if kept:
                    info['guest_kept'] = kept
    finally:
        if journal is not None:
            journal.close()
    if state is None:
        return info
    info.update(installed=True, version=state['version'], commit=state['commit'],
                manifest_sha256=state['manifest_sha256'], installed_utc=state.get('installed_utc'),
                release=str(env.opt / state['release']), previous=state.get('previous'),
                guest=state.get('guest'), untested=state.get('untested') or [], controllers=state.get('controllers'),
                output_mode=state.get('output_mode'), main_user=state.get('main_user'), signed=state.get('signed'),
                program=state.get('cli'), migrated_from=state.get('migrated_from'), game_store=state.get('game_store'),
                game_store_mode=library_store_mode(env, state['game_store']) if state.get('game_store') else None,
                autostart=bool(state.get('autostart')), test_hooks=test_hooks_marked(env),
                boot_warnings=state.get('boot_warnings') or [],
                entry=entry_status_text(env, state, entry_facts(env, state)))
    info['trial'] = trial_status(env, state)
    return info


def journal_lock_held(journal_fd, locks='/proc/locks'):
    """Whether a process holds the journal's lock right now, that is, whether an operation is running.

    Read from the kernel's list of locks and never by trying the lock: a status that took it for a moment would
    make an operation that begins in that moment say "another dosplex operation is running", and a user interface
    asks for the status again and again. Anything that cannot be read counts as "nobody holds it", which is what
    status said before it knew of running operations.
    """
    try:
        info = os.stat('.lock', dir_fd=journal_fd, follow_symlinks=False)
        wanted = '%02x:%02x:%d' % (os.major(info.st_dev), os.minor(info.st_dev), info.st_ino)
        with open(locks, encoding='ascii', errors='replace') as listing:
            for line in listing:
                fields = line.split()
                # "1: FLOCK  ADVISORY  WRITE 1234 fd:01:5678 0 EOF"; a waiting lock has "->" as its second word.
                if len(fields) >= 6 and fields[1] == 'FLOCK' and fields[5] == wanted:
                    return True
    except (OSError, ValueError):
        pass
    return False


def format_status(info):
    if not info['installed']:
        lines = ['DosPlex is not installed.']
        if info.get('legacy'):
            lines.append('An install under the old name, DuplOS, is on this device (%s). Run: sudo dosplex install '
                         'BUNDLE --manifest SHA256 (or --release ARCHIVE); it takes over the old install.'
                         % ', '.join(info['legacy']))
        if info.get('guest_kept'):
            lines.append('Guest was kept from an earlier install: %s (remove with: sudo dosplex uninstall --remove-guest)'
                         % info['guest_kept'].get('home'))
    else:
        lines = ['DosPlex %s (commit %s)' % (info['version'], info['commit'][:9]),
                 '  manifest: %s' % info['manifest_sha256'],
                 '  installed: %s' % info['installed_utc'],
                 '  release: %s (previous: %s)' % (info['release'], info['previous'] or 'none'),
                 '  signature: %s' % ('signed by key %(key_id)s, sequence %(sequence)d' % info['signed'] if info.get('signed')
                                      else 'none (approved by its manifest digest)')]
        if info.get('program'):
            lines.append('  program: dosplex %s' % info['program'].get('version'))
        if info.get('game_store'):
            lines.append('  Shared game library: %s (%s), experimental' % ({
                'leaving': 'leaving, every game goes back to its account at the next restart of the machine or start '
                           'of DosPlex',
                'gone': 'off, every game is back with its account; what is left of it goes at the next restart of '
                        'the machine, or now with: sudo dosplex library slot',
            }.get(info.get('game_store_mode'), 'on'), info['game_store']))
        lines.append('  Starts at boot: %s' % ('yes, experimental' if info.get('autostart') else 'no'))
        if info.get('test_hooks'):
            lines.append('  Test hooks: on at the next start (engineering only; remove /var/lib/dosplex/%s)' % TEST_HOOKS_MARKER)
        if info.get('entry') is not None:
            lines.append('  Start from Steam\'s library: %s' % info['entry'])
        for warning in info.get('boot_warnings') or ():
            lines.append('  Warning: ' + warning)
        if info.get('migrated_from'):
            lines.append('  migrated from %(product)s %(version)s on %(utc)s' % info['migrated_from'])
        guest = info['guest'] or {}
        lines.append('  Guest: %s (uid %s), home %s, %s' % (guest.get('user'), guest.get('uid'), guest.get('home'),
                     {'created': 'created by DosPlex', 'adopted-dosplex': 'adopted (earlier DosPlex account)',
                      'adopted-foreign': 'adopted (existing account)'}.get(guest.get('origin'), 'origin unknown')))
        if info['untested']:
            lines.append('  Installed on an untested configuration (--allow-untested): ' + ', '.join(info['untested']))
        trial = info['trial']
        if trial['alive']:
            lines.append('  Running: yes (retained trial %s)' % trial['root'])
            for name, side in trial['sides'].items():
                lines.append('    %-5s (%s, %s): lifecycle %s, restarts %s' % (
                    name, side['side'], side['owner'], side['lifecycle'] or 'unknown',
                    side['restart_count'] if side['restart_count'] is not None else 'unknown'))
                if side['controller_tour_accounts']:
                    lines.append('      Steam shows its "Steam Controller detected!" tour for account %s and it cannot finish '
                                 'inside DosPlex. Switch it off in this side\'s Steam: Settings > Developer > Show Steam '
                                 'Controller Tour (or set "ShowIbexWelcomeTour" "0" in userdata/<account>/7/remote/'
                                 'sharedconfig.vdf with Steam closed).' % ', '.join(side['controller_tour_accounts']))
            endpoint = trial['guest_audio_endpoint']
            lines.append('    Guest audio endpoint: %s (%s)' % (
                endpoint['path'], {True: 'present', False: 'not there yet', None: 'run with sudo to see'}[endpoint['present']]))
            if trial.get('compositor_active') is False:
                lines.append('    Warning: the compositor unit is not active.')
            if trial.get('sleep_guard_active') is True:
                lines.append('    Sleep guard: active (freezes both sides before the machine sleeps)')
            elif trial.get('sleep_guard_active') is False:
                lines.append('    Warning: the sleep guard is not active. Sleep may fail until DosPlex is started again.')
        else:
            lines.append('  Running: no%s' % (' (the previous run is gone: the device was restarted, or DosPlex ended and stock Steam came back; '
                                              'run: sudo dosplex start)' if trial.get('stale') else ''))
            if trial.get('ended'):
                lines.append('    Warning: the compositor ended on its own. Stock Steam should be back; if the screen is '
                             'black, run: sudo dosplex stop. Then run: sudo dosplex start')
        if trial['foreign']:
            lines.append('  Other retained trials not started by dosplex: ' + ', '.join(trial['foreign']))
    if info.get('in_progress'):
        lines.append('  In progress: %(op)s (%(name)s). It is still running; wait for it to finish.' % info['in_progress'])
    elif info.get('interrupted'):
        lines.append('  Interrupted: %(op)s (%(name)s). Run: sudo dosplex repair' % info['interrupted'])
    if info.get('note'):
        lines.append('  (%s)' % info['note'])
    return '\n'.join(lines)


