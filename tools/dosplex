def check_command(env, argv, *, as_user=False):
    """Refuse any external command the preview is not meant to run (see the module docstring)."""
    if not argv:
        raise PolicyError('empty command')
    exe = os.path.basename(argv[0])
    if exe in FORBIDDEN_COMMANDS:
        raise PolicyError('refusing to run %s: %s' % (exe, FORBIDDEN_COMMANDS[exe]))
    if _is_python(argv[0]):
        return _check_python(env, argv)
    if exe == STEAM_ADD_TOOL and not as_user:
        raise PolicyError('%s runs as the main user, through runuser; it refuses to run as root' % exe)
    if exe in USER_COMMANDS and as_user:
        return _check_user_command(env, argv)
    if exe not in ALLOWED_COMMANDS:
        raise PolicyError('refusing to run %s: not a command dosplex uses' % exe)
    args = argv[1:]
    if exe == 'busctl':
        if argv[1:] == BUS_RELOAD[1:]:
            return
        raise PolicyError('refusing busctl %s: dosplex only asks the system bus to read its configuration again'
                          % ' '.join(args[:3]))
    if exe == 'systemctl':
        if args == ['daemon-reload']:       # after dosplex wrote or removed its shared game library unit
            return
        if args == ['start', AUTO_TIMER]:       # after dosplex wrote its automatic sharing units
            return
        if args == ['start', ENTRY_SOCKET]:     # after dosplex wrote the socket of its library entry
            return
        if not args or args[0] not in SYSTEMCTL_READ | {'stop'}:
            raise PolicyError('refusing systemctl %s: dosplex only reads unit state, stops its own units and '
                              'reloads systemd after it changed its own unit' % (args[0] if args else ''))
        units = [a for a in args[1:] if not a.startswith('-')]
        if args[0] == 'stop' and (len(units) != 1 or not DOSPLEX_UNIT.fullmatch(units[0])):
            raise PolicyError('refusing to stop %s: only dosplex-* units' % ' '.join(units))
        if any(re.search(r'display-manager|sddm|gamescope-session', a) for a in args):
            raise PolicyError('refusing to touch the display manager (ADR-001)')
    elif exe == 'useradd':
        if not env.real:
            if args[:2] != ['--root', str(env.sysroot)]:
                raise PolicyError('useradd must name the sysroot')
            args = args[2:]
        if args != ['--create-home', '--user-group', '--shell', GUEST_SHELL, GUEST_USER]:
            raise PolicyError('useradd may only create the plain Guest account (home 0700, no extra groups)')
    elif exe == 'userdel':
        if not env.real:
            if args[:2] != ['--root', str(env.sysroot)]:
                raise PolicyError('userdel must name the sysroot')
            args = args[2:]
        if args != [GUEST_USER]:
            raise PolicyError('userdel may only remove the Guest account, and never with --remove/--force')
    elif exe == 'gpasswd':
        if not env.real:
            if args[:2] != ['--root', str(env.sysroot)]:
                raise PolicyError('gpasswd must name the sysroot')
            args = args[2:]
        if len(args) != 3 or args[0] not in ('-d', '-a') or args[1] != GUEST_USER or args[2] not in STRIP_GROUPS:
            raise PolicyError('gpasswd may only take Guest out of audio, input, seat, video or render, '
                              'or put one of those back')
        if args[0] == '-a' and not env.restoring_groups:
            raise PolicyError('refusing to add Guest to a group (ADR-006); only a membership that dosplex '
                              'removed, recorded in the journal, is put back')
    elif exe == 'id':
        if args != ['-nG', GUEST_USER]:
            raise PolicyError('id is only asked for the groups of Guest')
    elif exe == 'gamescope':
        if args != ['--version']:
            raise PolicyError('gamescope is only asked for its version')
    elif exe == 'loginctl':
        if not args or args[0] != 'show-user':
            raise PolicyError('loginctl is only used to read a user state')
    elif exe == 'steamosctl':
        raise PolicyError('steamosctl runs as the main user, through runuser')
    elif exe == 'runuser':
        if len(args) < 4 or args[0] != '-u' or args[2] != '--':
            raise PolicyError('runuser is used as: runuser -u USER -- COMMAND')
        inner = args[3:]
        if inner and os.path.basename(inner[0]) == 'env':
            inner = [a for a in inner[1:]]
            while inner and re.fullmatch(r'[A-Z_]+=.*', inner[0]):
                inner = inner[1:]
        if not inner:
            raise PolicyError('runuser without a command')
        check_command(env, inner, as_user=True)
    elif exe == 'systemd-run':
        _check_systemd_run(env, args)


def _check_user_command(env, argv):
    exe, args = os.path.basename(argv[0]), argv[1:]
    if exe == STEAM_ADD_TOOL:
        # Asked one thing: to put the "DosPlex" application entry of the main user into that user's Steam library.
        entry = args[0] if len(args) == 1 else ''
        if (not entry or not os.path.isabs(entry) or os.path.normpath(entry) != entry
                or not is_under(entry, env.sysroot) or not entry.endswith('/' + ENTRY_DESKTOP)):
            raise PolicyError('%s may only be given the one entry file %s of the main user' % (exe, ENTRY_DESKTOP))
    elif exe == 'steamosctl':
        if not args or args[0] not in STEAMOSCTL_VERBS:
            raise PolicyError('refusing steamosctl %s' % (args[0] if args else ''))
    elif exe == 'xprop' and '-set' in args:
        if args[args.index('-set') + 1] not in XPROP_WRITABLE:
            raise PolicyError('xprop may only set the Gamescope display properties')
    elif exe == 'env':
        raise PolicyError('env is only used inside runuser')


def _check_python(env, argv):
    args = argv[1:]
    if args[:1] == ['-c'] and len(args) >= 2 and args[1] in (USER_WRITE_SCRIPT, USER_ENTRY_SCRIPT):
        return
    script = args[0] if args else ''
    allowed = {str(own_path())} if own_path() else set()
    installed = env.opt / 'bin' / 'dosplex'
    allowed.add(str(installed))
    if script in allowed:
        return
    if script == str(env.path(LEGACY_OPT) / 'bin' / LEGACY_PROGRAM):
        rest = args[1:]
        if rest[:1] == ['--sysroot']:
            rest = rest[2:]
        if rest == ['stop']:                # the only thing the old program is ever asked to do: stop its session
            return
    store = Path(script)
    if (store.name == Path(GAME_STORE_TOOL).name and store.parent.name == 'bin'
            and store.parent.parent.parent == env.opt / 'releases' and VERSION_RE.fullmatch(store.parent.parent.name)
            and args[1:2] and args[1] in GAME_STORE_VERBS):         # the shared game library tool of an installed release
        return
    trial = Path(script)
    if (trial.name == 'root-session-trial.py' and TRIAL_RE.fullmatch(trial.parent.name)
            and trial.parent.parent == env.path('/run') and args[1:2] == ['recover']):
        return
    # The running session's own helper, asked for one thing: close both sides' Steam before the session goes.
    if (trial.name == 'dosplex-power-action' and trial.parent.name == 'libexec' and trial.parent.parent.name == 'bundle'
            and TRIAL_RE.fullmatch(trial.parent.parent.parent.name)
            and trial.parent.parent.parent.parent == env.path('/run') and args[1:2] == ['close']):
        return
    raise PolicyError('refusing to run %s: only the dosplex program and a trial recovery are started'
                      % (script or 'python'))


def _check_systemd_run(env, args):
    if '--' not in args:
        raise PolicyError('systemd-run needs a command')
    options, command = args[:args.index('--')], args[args.index('--') + 1:]
    background = '--wait' not in options
    if not any(o.startswith('--unit=dosplex-') for o in options):
        raise PolicyError('dosplex starts only its own units, and waits for them')
    if background and not any(o.startswith('--unit=dosplex-control-') for o in options):
        raise PolicyError('dosplex starts only its own units, and waits for them')
    # A control operation (`dosplex control start|stop`) runs in the background and is followed through its record.
    marker = '_control_op' if background else '_worker'
    if (not command or not _is_python(command[0]) or marker not in command or (marker == '_control_op' and '_worker' in command)
            or command[1:2] and command[1] not in {str(own_path()), str(env.opt / 'bin' / 'dosplex')}):
        raise PolicyError('systemd-run may only start the dosplex worker')


class Env:
    """The sysroot, the notion of root, the guarded command runner and the guarded write paths."""

    def __init__(self, sysroot='/'):
        absolute = os.path.abspath(str(sysroot))
        real = os.path.realpath(absolute)
        if is_under(real, '/usr') or is_under(absolute, '/usr'):
            raise PolicyError('refusing a sysroot under /usr (ADR-005: nothing under /usr)')
        if not os.path.isdir(real):
            raise UsageError('the sysroot %s is not a directory' % sysroot)
        self.sysroot = Path(real)
        self.real = real == '/'
        override = os.environ.get('DOSPLEX_TEST_ROOT_UID', '')
        # Only a test sysroot may redefine who root is; on the device this is always uid 0.
        self.trusted_uid = int(override) if override.isdigit() and not self.real else 0
        self.opt = self.path('/opt/dosplex')
        self.var = self.path('/var/lib/dosplex')
        self.legacy = False             # True in the view of an install under the old name (legacy_env)
        self.extra_writable = []
        self.restoring_groups = False
        self.python = DEVICE_PYTHON if self.real else sys.executable

    # --- paths ---------------------------------------------------------------------------------
    def path(self, absolute):
        return self.sysroot / str(absolute).lstrip('/')

    def is_root(self):
        return os.geteuid() == self.trusted_uid

    def owned_by(self, info, uid):
        """Is the file owned by `uid`? In a test sysroot ownership cannot be arranged without root, so
        files made by the test user count as owned by every account there."""
        return info.st_uid == uid or (not self.real and info.st_uid == os.geteuid())

    @contextlib.contextmanager
    def group_restore(self):
        """Inside this block, and only here, Guest may be put back into a group dosplex took it out of."""
        self.restoring_groups = True
        try:
            yield
        finally:
            self.restoring_groups = False

    def require_root(self):
        if not self.is_root():
            raise NotRoot('this needs root: run it with sudo (for example: sudo dosplex %s)'
                              % (' '.join(sys.argv[1:2]) or 'status'))

    def allow_write(self, path):
        """Add a directory the current operation may change (Guest's home, the main user's Gamescope
        settings). /usr is never allowed."""
        path = Path(os.path.abspath(str(path)))
        self._refuse_usr(path)
        self.extra_writable.append(path)

    def _refuse_usr(self, path):
        for usr in (Path('/usr'), self.sysroot / 'usr'):
            if is_under(path, usr):
                raise PolicyError('refusing to write %s: nothing under /usr (ADR-005)' % path)

    def check_write(self, path):
        """Return `path` if dosplex may change it; raise PolicyError otherwise."""
        path = Path(os.path.abspath(str(path)))
        self._refuse_usr(path)
        parent_real = Path(os.path.realpath(str(path.parent)))
        self._refuse_usr(parent_real)
        for root in [self.opt, self.var, *self.extra_writable]:
            if path == root:
                if parent_real == Path(os.path.realpath(str(root.parent))):
                    return path
            elif is_under(path, root) and is_under(parent_real, os.path.realpath(str(root))):
                return path
        raise PolicyError('refusing to write %s: outside /opt/dosplex and /var/lib/dosplex' % path)

    # --- test hooks ----------------------------------------------------------------------------
    def fault(self, point):
        if self.real:
            return
        log = os.environ.get('DOSPLEX_TEST_FAULT_LOG')
        if log:
            with open(log, 'a') as stream:
                stream.write(point + '\n')
        if os.environ.get('DOSPLEX_TEST_CRASH_AT') == point:
            os._exit(FAULT_EXIT)

    def interactive(self):
        return sys.stdin.isatty() or (not self.real and os.environ.get('DOSPLEX_TEST_TTY') == '1')

    # --- commands ------------------------------------------------------------------------------
    def which(self, name):
        return shutil.which(name)

    def run(self, argv, *, check=True, timeout=60, input=None):
        argv = [str(a) for a in argv]
        check_command(self, argv)
        environment = dict(os.environ, LC_ALL='C', PYTHONDONTWRITEBYTECODE='1')
        if isinstance(input, str):
            input = input.encode()
        try:
            proc = subprocess.run(argv, input=input, capture_output=True, timeout=timeout, env=environment)
        except FileNotFoundError:
            raise CommandMissing('%s is not installed' % argv[0]) from None
        except subprocess.TimeoutExpired:
            raise DosplexError('%s did not finish in %s seconds' % (os.path.basename(argv[0]), timeout)) from None
        proc = subprocess.CompletedProcess(proc.args, proc.returncode, proc.stdout.decode(errors='replace'),
                                           proc.stderr.decode(errors='replace'))
        if check and proc.returncode:
            raise CommandFailed(argv, proc)
        return proc

    # --- guarded filesystem changes ------------------------------------------------------------
    def ensure_dir(self, path, mode=0o755):
        path = self.check_write(path)
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            os.mkdir(path, mode)
            os.chmod(path, mode)
            return path
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise PolicyError('%s must be a real directory (found a symlink or a file)' % path)
        if info.st_uid != self.trusted_uid or info.st_mode & 0o022:
            raise PolicyError('%s is not owned by root or is writable by others' % path)
        return path

    def write_file(self, path, data, mode):
        path = self.check_write(path)
        temporary = path.with_name('.%s.new-%s' % (path.name, uuid.uuid4().hex[:8]))
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            os.fchmod(fd, mode)
            os.fsync(fd)
        except BaseException:
            os.close(fd)
            os.unlink(temporary)
            raise
        os.close(fd)
        os.replace(temporary, path)
        fsync_dir(path.parent)
        return path

    def replace_symlink(self, link, target):
        link = self.check_write(link)
        if lexists(link) and not os.path.islink(link):
            raise PolicyError('%s exists and is not a symlink' % link)
        temporary = link.with_name('.%s.new-%s' % (link.name, uuid.uuid4().hex[:8]))
        os.symlink(target, temporary)
        os.replace(temporary, link)
        fsync_dir(link.parent)

    def unlink(self, path):
        path = self.check_write(path)
        try:
            os.unlink(path)
        except FileNotFoundError:
            return False
        fsync_dir(path.parent)
        return True

    def rmtree(self, path):
        path = self.check_write(path)
        if not lexists(path):
            return False
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode):
            os.unlink(path)
        elif stat.S_ISDIR(info.st_mode):
            shutil.rmtree(path)
        else:
            os.unlink(path)
        fsync_dir(path.parent)
        return True

    def rmdir_if_empty(self, path):
        path = self.check_write(path)
        try:
            os.rmdir(path)
        except FileNotFoundError:
            return False
        except OSError as error:
            if error.errno in (errno.ENOTEMPTY, errno.EEXIST):
                return False
            raise
        fsync_dir(path.parent)
        return True


# ---------------------------------------------------------------------------------------------------
# The verifier. This is the CLI's own code and never comes from the bundle (PKG-011). It reads each
# listed file without following symlinks and returns the verified bytes, so what is installed is exactly
# what was hashed.
# ---------------------------------------------------------------------------------------------------

class Manifest:
    def __init__(self, raw, data):
        self.raw = raw
        self.sha256 = sha256_bytes(raw)
        self.data = data
        self.version = data['version']
        self.commit = data['commit']
        self.scope = data.get('scope', '')
        self.files = data['files']
        self.tested = data['tested_versions']
        self.release = data.get('release')      # only a manifest that tools/release.py made carries one


class Verified:
    def __init__(self, manifest, files):
        self.manifest = manifest
        self.files = files          # name -> (bytes, mode)

    def total_bytes(self):
        return sum(len(data) for data, _ in self.files.values()) + len(self.manifest.raw)


def _text_list(value, what, limit=64):
    if value is None:
        return []
    if (not isinstance(value, list) or len(value) > limit
            or not all(isinstance(v, str) and 0 < len(v) <= 128 and v.isprintable() for v in value)):
        raise VerifyError('tested_versions.%s must be a list of short strings' % what)
    return value


def normalise_tested(value):
    """Validate the tested_versions object of a manifest and fill in missing lists."""
    if not isinstance(value, dict):
        raise VerifyError('the manifest has no tested_versions object; rebuild the bundle')
    steamos = value.get('steamos') or []
    if not isinstance(steamos, list) or len(steamos) > 64:
        raise VerifyError('tested_versions.steamos must be a list')
    entries = []
    for item in steamos:
        if (not isinstance(item, dict) or not isinstance(item.get('version_id'), str)
                or not item['version_id'] or len(item['version_id']) > 64
                or not (item.get('build_id') is None or (isinstance(item['build_id'], str)
                                                         and 0 < len(item['build_id']) <= 64))
                or set(item) - {'version_id', 'build_id'}):
            raise VerifyError('tested_versions.steamos entries need a version_id and an optional build_id')
        entries.append(dict(item))
    return {'steamos': entries,
            'gamescope': _text_list(value.get('gamescope'), 'gamescope'),
            'steam_client': _text_list(value.get('steam_client'), 'steam_client')}


def parse_manifest(raw):
    try:
        data = json.loads(raw)
    except ValueError:
        raise VerifyError('manifest.json is not valid JSON') from None
    if not isinstance(data, dict):
        raise VerifyError('manifest.json is not an object')
    entries = data.get('files')
    if not isinstance(entries, dict) or not 1 <= len(entries) <= MAX_ENTRIES:
        raise VerifyError('invalid manifest file set')
    for name, item in entries.items():
        if not valid_name(name):
            raise VerifyError('invalid bundle path %r' % name)
        if (not isinstance(item, dict) or type(item.get('bytes')) is not int or not 0 <= item['bytes'] <= MAX_FILE
                or type(item.get('mode')) is not int or item['mode'] not in (0o644, 0o755)
                or name == 'manifest.json' or not isinstance(item.get('sha256'), str)
                or not SHA256_RE.fullmatch(item['sha256'])):
            raise VerifyError('invalid manifest metadata for %r' % name)
    if not isinstance(data.get('version'), str) or not VERSION_RE.fullmatch(data['version']):
        raise VerifyError('the manifest has no valid "version" (letters, digits and . _ + -); rebuild the bundle')
    if not isinstance(data.get('commit'), str) or not COMMIT_RE.fullmatch(data['commit']):
        raise VerifyError('the manifest has no valid "commit"')
    data['tested_versions'] = normalise_tested(data.get('tested_versions'))
    if 'release' in data:
        data['release'] = parse_release_entry(data['release'])
    return Manifest(raw, data)


def parse_release_entry(value):
    """The "release" entry that tools/release.py adds to a bundle manifest before it is signed.

    sequence  a whole number that grows with every release; `dosplex update` never moves to a release whose
              sequence is not above the installed one, so a replayed older index cannot downgrade a device
    cli       the dosplex program the release ships (version, SHA-256, size), so that the program that comes
              with a release is covered by the same signature as the payload
    """
    if not isinstance(value, dict) or value.get('format') != 1:
        raise VerifyError('the manifest has a release entry in a format this dosplex does not know; '
                          'use the dosplex program that comes with the release')
    sequence, cli = value.get('sequence'), value.get('cli')
    if type(sequence) is not int or not 1 <= sequence < 1 << 40:
        raise VerifyError('the release entry of the manifest has no valid sequence')
    if (not isinstance(cli, dict) or not isinstance(cli.get('version'), str) or not VERSION_RE.fullmatch(cli['version'])
            or not isinstance(cli.get('sha256'), str) or not SHA256_RE.fullmatch(cli['sha256'])
            or type(cli.get('bytes')) is not int or not 1 <= cli['bytes'] <= MAX_CLI):
        raise VerifyError('the release entry of the manifest has no valid dosplex program entry')
    return {'format': 1, 'sequence': sequence,
            'cli': {'version': cli['version'], 'sha256': cli['sha256'], 'bytes': cli['bytes']}}


def valid_name(name):
    path = PurePosixPath(name)
    return bool(path.parts) and not path.is_absolute() and str(path) == name and \
        not any(part in ('.', '..') for part in path.parts)


def _read_regular(root_fd, name, limit, installed_uid=None, mode=None):
    path = PurePosixPath(name)
    if not valid_name(name):
        raise VerifyError('invalid bundle path %r' % name)
    directory = os.dup(root_fd)
    try:
        for component in path.parts[:-1]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                            dir_fd=directory)
            os.close(directory)
            directory = child
        fd = os.open(path.name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory)
        with os.fdopen(fd, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                raise VerifyError('%s is not a plain file' % name)
            if info.st_size > limit:
                raise VerifyError('%s is too large' % name)
            if installed_uid is not None and (info.st_uid != installed_uid or (
                    mode is not None and stat.S_IMODE(info.st_mode) != mode)):
                raise VerifyError('%s has the wrong owner or mode' % name)
            value = stream.read(limit + 1)
            if len(value) > limit:
                raise VerifyError('%s is too large' % name)
            return value
    except FileNotFoundError:
        raise VerifyError('%s is missing' % name) from None
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR):
            raise VerifyError('%s is or sits behind a symlink' % name) from None
        raise VerifyError('%s cannot be read: %s' % (name, os.strerror(error.errno))) from None
    finally:
        os.close(directory)


def _unlisted(root_fd, names, installed_uid=None):
    """Entries of the tree that the manifest does not list (and, for an installed tree, wrong owners)."""
    wanted = set()
    for name in names:
        parent = PurePosixPath(name).parent
        while str(parent) != '.':
            wanted.add(str(parent))
            parent = parent.parent
    found = []

    def walk(fd, prefix):
        with os.scandir(fd) as scan:
            entries = sorted(scan, key=lambda e: e.name)
        for entry in entries:
            relative = prefix + entry.name
            info = entry.stat(follow_symlinks=False)
            if stat.S_ISDIR(info.st_mode):
                if relative not in wanted:
                    found.append(relative + '/')
                    continue
                if installed_uid is not None and (info.st_uid != installed_uid or info.st_mode & 0o022):
                    found.append(relative + '/ (owner or mode)')
                child = os.open(entry.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                                dir_fd=fd)
                try:
                    walk(child, relative + '/')
                finally:
                    os.close(child)
            elif relative not in names:
                found.append(relative)
    walk(root_fd, '')
    return found


def verify_directory(path, expected_sha256, *, installed_uid=None):
    """Verify a bundle or an installed release against the approved manifest digest.

    Returns Verified. Raises VerifyError on any difference, and on any file the manifest does not list.
    With installed_uid the owner and exact modes of an installed tree are checked as well.
    """
    if not isinstance(expected_sha256, str) or not SHA256_RE.fullmatch(expected_sha256):
        raise VerifyError('the approved manifest digest must be 64 lowercase hex digits')
    try:
        root = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as error:
        raise VerifyError('cannot open %s: %s' % (path, os.strerror(error.errno))) from None
    try:
        top = os.fstat(root)
        if installed_uid is not None and (top.st_uid != installed_uid or top.st_mode & 0o022):
            raise VerifyError('%s is not owned by root or is writable by others' % path)
        raw = _read_regular(root, 'manifest.json', MAX_MANIFEST, installed_uid, 0o644 if installed_uid is not None else None)
        if sha256_bytes(raw) != expected_sha256:
            raise VerifyError('manifest.json does not match the approved SHA-256')
        manifest = parse_manifest(raw)
        files, total = {}, 0
        for name, item in manifest.files.items():
            data = _read_regular(root, name, min(MAX_FILE, MAX_TOTAL - total), installed_uid, item['mode'])
            total += len(data)
            if len(data) != item['bytes'] or sha256_bytes(data) != item['sha256']:
                raise VerifyError('%s differs from the approved manifest' % name)
            files[name] = (data, item['mode'])
        extra = _unlisted(root, set(files) | {'manifest.json'}, installed_uid)
        if extra:
            raise VerifyError('%d entr%s not in the manifest: %s' % (
                len(extra), 'y is' if len(extra) == 1 else 'ies are', ', '.join(extra[:5])))
        return Verified(manifest, files)
    finally:
        os.close(root)


def missing_required(manifest):
    return [name for name in REQUIRED_RELEASE_FILES if name not in manifest.files]


def missing_message(missing):
    text = 'the bundle lacks files that start needs: %s.' % ', '.join(missing)
    if 'libexec/native-hid-relay' in missing:
        text += (' libexec/native-hid-relay carries the controllers of a Steam Controller receiver; a bundle built '
                 'for a device with built-in controls lacks it, and dosplex start needs it because a start enrolls '
                 'every receiver that is plugged in. Use a bundle that was built with the receiver helper.')
    return text


# ---------------------------------------------------------------------------------------------------
# Release signatures: Ed25519 in the minisign file format (PKG-011, T-702).
#
# A signed release is checked with this program's own code and with a public key that is pinned in this
# file, before any file of the release is trusted, let alone run. Nothing from the payload takes part.
#
# The mathematics is RFC 8032 section 5.1 and the code follows the reference implementation of its
# section 6, so that the two can be read side by side. The file format is minisign's: `minisign -S` signs
# and `minisign -V` checks the same files. The code handles public data only (a key, a message, a
# signature), so it makes no attempt to run in constant time. It is as strict as libsodium, which
# minisign uses, and so stricter than RFC 8032 asks: a signature scalar that is not reduced, a public key or
# an R of small order and a point whose y is not reduced are all refused.
# ---------------------------------------------------------------------------------------------------

# The keys this program trusts to sign a release and the release index. One entry per minisign public key:
# "id" is the key id that minisign prints ("minisign public key: E7620F1842B4E81F"), "public" is the 32-byte
# Ed25519 key in hex. `tools/release.py pin PUBLIC_KEY_FILE` prints the entry for a minisign .pub file.
# The owner's release key, made on 2026-11-18 (key id A349720E6A674920). The secret half stays with the
# owner, offline; it is never in this repository. A test build can still pin its own key instead
# (`tools/release.py build --pin-key`). To rotate, add the new key in a release that the old key signed, and
# drop the old one a release or two later (docs/release-process.md).
# BEGIN RELEASE KEYS (tools/release.py rewrites the lines between these markers; keep both of them)
RELEASE_KEYS = (
    {'id': 'A349720E6A674920', 'public': '43c4424e0f9bdfe840bf36886f16c70a4e4adca26c79bbc0f1b8cf2a0f1f8186'},
)
# END RELEASE KEYS

_P = 2 ** 255 - 19
_L = 2 ** 252 + 27742317777372353535851937790883648493
_D = -121665 * pow(121666, _P - 2, _P) % _P
_SQRT_M1 = pow(2, (_P - 1) // 4, _P)


def _recover_x(y, sign):
    """The x of the curve point (x, y) whose lowest bit is `sign`, or None if there is none (RFC 8032, 5.1.3)."""
    if y >= _P:
        return None
    x2 = (y * y - 1) * pow(_D * y * y + 1, _P - 2, _P) % _P
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P:
        x = x * _SQRT_M1 % _P
    if (x * x - x2) % _P:
        return None
    return x if x & 1 == sign else _P - x


_BASE_Y = 4 * pow(5, _P - 2, _P) % _P
_BASE_X = _recover_x(_BASE_Y, 0)
_BASE = (_BASE_X, _BASE_Y, 1, _BASE_X * _BASE_Y % _P)         # points are (X, Y, Z, T) in extended coordinates
_NEUTRAL = (0, 1, 1, 0)


def _point_add(p, q):
    a = (p[1] - p[0]) * (q[1] - q[0]) % _P
    b = (p[1] + p[0]) * (q[1] + q[0]) % _P
    c = 2 * p[3] * q[3] * _D % _P
    d = 2 * p[2] * q[2] % _P
    e, f, g, h = b - a, d - c, d + c, b + a
    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)


def _point_mul(scalar, point):
    result = _NEUTRAL
    while scalar > 0:
        if scalar & 1:
            result = _point_add(result, point)
        point = _point_add(point, point)
        scalar >>= 1
    return result


def _point_equal(p, q):
    return (p[0] * q[2] - q[0] * p[2]) % _P == 0 and (p[1] * q[2] - q[1] * p[2]) % _P == 0


def _point_decompress(data):
    """The point a 32-byte encoding stands for, or None when it is not the encoding of a curve point."""
    if len(data) != 32:
        return None
    y = int.from_bytes(data, 'little')
    sign = y >> 255
    y &= (1 << 255) - 1
    x = _recover_x(y, sign)
    return None if x is None else (x, y, 1, x * y % _P)


def _has_small_order(point):
    for _ in range(3):                  # eight times the point is the neutral element for the small subgroup
        point = _point_add(point, point)
    return _point_equal(point, _NEUTRAL)


def ed25519_verify(public, message, signature):
    """True when `signature` (64 bytes) is a valid Ed25519 signature of `message` under `public` (32 bytes)."""
    if len(public) != 32 or len(signature) != 64:
        return False
    a_point = _point_decompress(public)
    r_point = _point_decompress(signature[:32])
    s = int.from_bytes(signature[32:], 'little')
    if a_point is None or r_point is None or s >= _L:
        return False
    if _has_small_order(a_point) or _has_small_order(r_point):
        return False
    h = int.from_bytes(hashlib.sha512(signature[:32] + public + message).digest(), 'little') % _L
    return _point_equal(_point_mul(s, _BASE), _point_add(r_point, _point_mul(h, a_point)))


def key_id_text(keynum):
    """A key id the way minisign prints it: the 8 bytes read as a little-endian number, in upper-case hex."""
    return bytes(reversed(keynum)).hex().upper()


class ReleaseKey:
    def __init__(self, keynum, public):
        self.keynum, self.public, self.id = keynum, public, key_id_text(keynum)


def pinned_keys():
    """The keys pinned in RELEASE_KEYS, as ReleaseKey objects."""
    keys = []
    for entry in RELEASE_KEYS:
        try:
            keynum, public = bytes.fromhex(entry['id'])[::-1], bytes.fromhex(entry['public'])
        except (KeyError, TypeError, ValueError):
            keynum = public = b''
        if len(keynum) != 8 or len(public) != 32:
            raise DosplexError('RELEASE_KEYS in this program holds an entry that is not a 16-digit key id with a '
                              '64-digit public key; use a dosplex program from the release page')
        keys.append(ReleaseKey(keynum, public))
    return keys


def read_minisign_public_key(text):
    """(key id bytes, public key bytes) from a minisign public key file, or from the base64 line alone."""
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if lines and lines[0].startswith('untrusted comment:'):
        lines = lines[1:]
    try:
        raw = base64.b64decode(lines[0], validate=True) if len(lines) == 1 else b''
    except ValueError:
        raw = b''
    if len(raw) != 42 or raw[:2] != b'Ed':
        raise VerifyError('that is not a minisign public key (a file with a comment line and a line of 56 base64 '
                          'characters, or that line alone)')
    return raw[2:10], raw[10:]


TRUSTED_COMMENT = 'trusted comment: '


class Signed:
    """What a good signature says: the key that made it and the rest of its trusted comment."""

    def __init__(self, key_id, subject):
        self.key_id, self.subject = key_id, subject


def parse_minisign_signature(text):
    """(prehashed, key id bytes, signature, trusted comment, global signature) of a minisign signature file."""
    if isinstance(text, bytes):
        try:
            text = text.decode('utf-8')
        except UnicodeDecodeError:
            raise VerifyError('the signature file is not text') from None
    if len(text) > MAX_SIGNATURE:
        raise VerifyError('the signature file is too large to be a minisign signature')
    lines = text.replace('\r\n', '\n').split('\n')
    if lines and lines[-1] == '':
        lines.pop()
    if len(lines) != 4 or not lines[0].startswith('untrusted comment:') or not lines[2].startswith(TRUSTED_COMMENT):
        raise VerifyError('the signature file is not a minisign signature (it needs four lines: untrusted comment, '
                          'signature, trusted comment, global signature)')
    try:
        first, last = base64.b64decode(lines[1], validate=True), base64.b64decode(lines[3], validate=True)
    except ValueError:
        raise VerifyError('the signature file is not a minisign signature (the signature is not base64)') from None
    if len(first) != 74 or len(last) != 64 or first[:2] not in (b'Ed', b'ED'):
        raise VerifyError('the signature file is not a minisign Ed25519 signature')
    return first[:2] == b'ED', first[2:10], first[10:], lines[2][len(TRUSTED_COMMENT):], last


def require_keys(keys):
    if not keys:
        raise VerifyError('this copy of dosplex pins no release signing key, so it cannot check a signed release. '
                          'Use the dosplex program that comes with a release (its SHA-256 is on the release page), '
                          'or install a bundle by its manifest digest')


def verify_signature(message, signature_text, keys, what):
    """Check the detached minisign signature of `message` against the pinned keys, or raise VerifyError.

    `what` is "manifest" or "index". The trusted comment of the signature, which the signature covers, has to
    start with "dosplex <what> ", so that a signature made for one kind of file cannot stand for another; the
    rest of the comment (a version, a channel name) is returned for the caller to compare with the file.
    """
    require_keys(keys)
    prehashed, keynum, signature, comment, global_signature = parse_minisign_signature(signature_text)
    matching = [key for key in keys if key.keynum == keynum]
    if not matching:
        raise VerifyError('the %s is signed with key %s, which this dosplex does not trust (it trusts %s). If the '
                          'release key was changed, install the newest release by hand from the release page: the '
                          'dosplex program inside it trusts the new key'
                          % (what, key_id_text(keynum), ', '.join(key.id for key in keys)))
    signed = hashlib.blake2b(message, digest_size=64).digest() if prehashed else message
    for key in matching:
        if ed25519_verify(key.public, signed, signature):
            break
    else:
        raise VerifyError('the signature of the %s is not valid: the file was changed, or it was signed with '
                          'another key' % what)
    if not ed25519_verify(key.public, signature + comment.encode('utf-8'), global_signature):
        raise VerifyError('the signature comment of the %s was changed' % what)
    prefix = 'dosplex %s ' % what
    if not comment.startswith(prefix) or not comment[len(prefix):] or not comment.isprintable():
        raise VerifyError('this signature does not say that it is for a dosplex %s (its comment is %r)' % (what, comment))
    return Signed(key.id, comment[len(prefix):])


# --- the release archive -----------------------------------------------------------------------------------

class _Capped:
    """A read-only stream that stops a decompression bomb: it fails once more than `budget` bytes came out."""

    def __init__(self, stream, budget):
        self.stream, self.budget = stream, budget

    def read(self, size=-1):
        chunk = self.stream.read(size)
        self.budget -= len(chunk)
        if self.budget < 0:
            raise VerifyError('the archive holds more data than a release may')
        return chunk


def read_archive_members(data):
    """name -> bytes for the files of a release archive (the bytes of a .tar.gz). Nothing is written to disk.

    Anything but plain files and directories is refused, so there are no links, devices or other surprises to
    extract, and no name is ever used as a path on this device.
    """
    members = {}
    try:
        stream = _Capped(gzip.GzipFile(fileobj=io.BytesIO(data)), MAX_TOTAL + MAX_CLI + (1 << 20))
        with tarfile.open(fileobj=stream, mode='r|') as archive:
            for member in archive:
                if member.type == tarfile.DIRTYPE:
                    continue
                if member.type not in (tarfile.REGTYPE, tarfile.AREGTYPE):
                    raise VerifyError('the archive holds %r, which is not a plain file or a directory' % member.name)
                if not valid_name(member.name) or '/' not in member.name or not 0 <= member.size <= MAX_FILE:
                    raise VerifyError('the archive holds a file with an unacceptable name or size: %r' % member.name)
                if member.name in members or len(members) >= MAX_ARCHIVE_MEMBERS:
                    raise VerifyError('the archive holds a duplicate name or too many files')
                members[member.name] = archive.extractfile(member).read()
    except (tarfile.TarError, OSError, EOFError, zlib.error) as error:
        raise VerifyError('the archive cannot be read as a gzip-compressed tar file: %s' % error) from None
    return members


def verify_release_archive(data, signature_text, keys):
    """Check a release archive against its detached signature. Returns (Verified, the dosplex program, Signed).

    The order is the point: the signature of the manifest first, with the pinned key; then every file the
    manifest lists, by size and SHA-256; then that nothing else is in the archive. Only then is anything in
    the result usable, and nothing from the archive has run by then (nothing is ever extracted).
    """
    members = read_archive_members(data)
    roots = {name.split('/', 1)[0] for name in members}
    if len(roots) != 1:
        raise VerifyError('the archive must hold one directory, named dosplex-<version>')
    root = roots.pop()
    manifest_raw = members.get(root + '/bundle/manifest.json')
    if manifest_raw is None or len(manifest_raw) > MAX_MANIFEST:
        raise VerifyError('the archive has no usable bundle/manifest.json')
    signed = verify_signature(manifest_raw, signature_text, keys, 'manifest')
    manifest = parse_manifest(manifest_raw)
    if signed.subject != manifest.version:
        raise VerifyError('the signature is for release %s but the manifest is for %s' % (signed.subject, manifest.version))
    if manifest.release is None:
        raise VerifyError('the manifest is signed but is not a release manifest (it has no release entry)')
    if root != 'dosplex-' + manifest.version:
        raise VerifyError('the archive directory is %s, not dosplex-%s' % (root, manifest.version))
    files, total = {}, 0
    for name, item in manifest.files.items():
        blob = members.get('%s/bundle/%s' % (root, name))
        if blob is None:
            raise VerifyError('%s is missing from the archive' % name)
        total += len(blob)
        if total > MAX_TOTAL or len(blob) != item['bytes'] or sha256_bytes(blob) != item['sha256']:
            raise VerifyError('%s differs from the signed manifest' % name)
        files[name] = (blob, item['mode'])
    program = members.get(root + '/dosplex')
    wanted = manifest.release['cli']
    if program is None or len(program) != wanted['bytes'] or sha256_bytes(program) != wanted['sha256']:
        raise VerifyError('the dosplex program in the archive differs from the signed manifest')
    expected = {'%s/bundle/%s' % (root, name) for name in files} | {root + '/bundle/manifest.json', root + '/dosplex'}
    extra = sorted(set(members) - expected)
    if extra:
        raise VerifyError('%d entr%s not in the signed manifest: %s' % (
            len(extra), 'y is' if len(extra) == 1 else 'ies are', ', '.join(extra[:5])))
    return Verified(manifest, files), program, signed


def read_regular_file(path, limit, what):
    """The bytes of an ordinary file named on the command line (a symlink is fine there), or a DosplexError."""
    try:
        with open(str(path), 'rb') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise DosplexError('%s %s is not a regular file' % (what, path))
            data = stream.read(limit + 1)
    except OSError as error:
        raise DosplexError('cannot read %s %s: %s' % (what, path, error.strerror or error)) from None
    if len(data) > limit:
        raise VerifyError('%s %s is larger than %d bytes' % (what, path, limit))
    return data


def sibling_signature(archive):
    """Where the signature of dosplex-<v>.tar.gz is by default: dosplex-<v>.manifest.json.minisig beside it."""
    archive = Path(archive)
    name = archive.name[:-len('.tar.gz')] if archive.name.endswith('.tar.gz') else archive.name
    return archive.with_name(name + '.manifest.json.minisig')


def load_release_file(archive, signature=None):
    """Verify a downloaded release archive and its signature file. Returns (Verified, program, Signed)."""
    signature = Path(signature) if signature else sibling_signature(archive)
    data = read_regular_file(archive, MAX_ARCHIVE, 'the release archive')
    text = read_regular_file(signature, MAX_SIGNATURE, 'the signature file')
    return verify_release_archive(data, text, pinned_keys())


# --- the release channel -------------------------------------------------------------------------------------

INDEX_NAME = re.compile(r'[a-z0-9][a-z0-9._-]{0,31}')


def redact_url(url):
    """The address without a user name or password, for messages and the journal."""
    parts = urllib.parse.urlsplit(url)
    if '@' in parts.netloc:
        return urllib.parse.urlunsplit(parts._replace(netloc=parts.netloc.rpartition('@')[2]))
    return url


def channel_address(text):
    """The channel as a URL: an https:// or file:// address, or an absolute path (made into file://)."""
    if text.startswith('/'):
        return Path(text).as_uri()
    if urllib.parse.urlsplit(text).scheme not in ('https', 'file'):
        raise UsageError('the channel %s must be an https:// or file:// address (or an absolute path)' % redact_url(text))
    return text


class _HttpsOnly(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme != 'https':
            raise urllib.error.HTTPError(newurl, code, 'a redirect to a non-https address was refused', headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def fetch_url(url, limit, what, timeout=60):
    """The bytes at an https:// or file:// address, at most `limit` of them."""
    if urllib.parse.urlsplit(url).scheme not in ('https', 'file'):
        raise DosplexError('refusing to fetch the %s from %s: only https:// and file:// addresses are used'
                          % (what, redact_url(url)))
    request = urllib.request.Request(url, headers={'User-Agent': 'dosplex/' + CLI_VERSION})
    try:
        with urllib.request.build_opener(_HttpsOnly).open(request, timeout=timeout) as response:
            data = response.read(limit + 1)
    except urllib.error.HTTPError as error:
        raise DosplexError('cannot fetch the %s from %s: HTTP %s %s' % (what, redact_url(url), error.code, error.reason)) from None
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as error:
        raise DosplexError('cannot fetch the %s from %s: %s' % (what, redact_url(url), getattr(error, 'reason', error))) from None
    if len(data) > limit:
        raise VerifyError('the %s at %s is larger than %d bytes; refusing it' % (what, redact_url(url), limit))
    return data


def _asset(value, what, limit=None):
    if (not isinstance(value, dict) or not isinstance(value.get('url'), str) or not 0 < len(value['url']) <= 1024
            or not value['url'].isprintable()):
        raise VerifyError('the release index has a bad %s entry' % what)
    result = {'url': value['url']}
    if limit is not None:
        if (not isinstance(value.get('sha256'), str) or not SHA256_RE.fullmatch(value['sha256'])
                or type(value.get('bytes')) is not int or not 1 <= value['bytes'] <= limit):
            raise VerifyError('the release index has a bad %s entry' % what)
        result.update(sha256=value['sha256'], bytes=value['bytes'])
    return result


class Index:
    """A parsed release index: the channel name and the releases it lists, newest first."""

    def __init__(self, raw, url, channel, releases):
        self.raw, self.url, self.channel, self.releases = raw, url, channel, releases

    def resolve(self, reference):
        """The absolute address of an asset the index names. It stays on the scheme the index came from."""
        address = urllib.parse.urljoin(self.url, reference)
        if urllib.parse.urlsplit(address).scheme != urllib.parse.urlsplit(self.url).scheme:
            raise VerifyError('the release index names %s, which is not on the same kind of address as the index '
                              'itself' % redact_url(address))
        return address


def parse_index(raw, url):
    """Validate the bytes of a release index (after its signature was checked) and return an Index."""
    try:
        data = json.loads(raw)
    except ValueError:
        raise VerifyError('the release index is not valid JSON') from None
    if (not isinstance(data, dict) or data.get('format') != 'dosplex-index' or data.get('format_version') != 1
            or not isinstance(data.get('channel'), str) or not INDEX_NAME.fullmatch(data['channel'])
            or not isinstance(data.get('releases'), list) or len(data['releases']) > 64):
        raise VerifyError('this is not a release index in a format this dosplex reads')
    releases, versions = [], set()
    for item in data['releases']:
        if (not isinstance(item, dict) or not isinstance(item.get('version'), str) or not VERSION_RE.fullmatch(item['version'])
                or type(item.get('sequence')) is not int or not 1 <= item['sequence'] < 1 << 40
                or not isinstance(item.get('commit'), str) or not COMMIT_RE.fullmatch(item['commit'])
                or item['version'] in versions):
            raise VerifyError('the release index has a bad release entry')
        versions.add(item['version'])
        signed_by = item.get('signed_by')
        if signed_by is not None and (not isinstance(signed_by, str) or not re.fullmatch(r'[0-9A-F]{16}', signed_by)):
            raise VerifyError('the release index has a bad release entry')
        releases.append({'version': item['version'], 'sequence': item['sequence'], 'commit': item['commit'],
                         'signed_by': signed_by, 'tested_versions': normalise_tested(item.get('tested_versions')),
                         'manifest': _asset(item.get('manifest'), 'manifest', MAX_MANIFEST),
                         'signature': _asset(item.get('signature'), 'signature'),
                         'tarball': _asset(item.get('tarball'), 'tarball', MAX_ARCHIVE)})
    releases.sort(key=lambda release: -release['sequence'])
    return Index(raw, url, data['channel'], releases)


# ---------------------------------------------------------------------------------------------------
# What is on the device: accounts, versions, displays, controllers, processes.
# ---------------------------------------------------------------------------------------------------

class Account:
    def __init__(self, name, uid, gid, home, shell):
        self.name, self.uid, self.gid, self.home, self.shell = name, uid, gid, home, shell


def read_accounts(env):
    accounts = {}
    try:
        text = env.path('/etc/passwd').read_text()
    except OSError:
        return accounts
    for line in text.splitlines():
        fields = line.split(':')
        if len(fields) >= 7 and fields[2].isdigit() and fields[3].isdigit():
            accounts[fields[0]] = Account(fields[0], int(fields[2]), int(fields[3]), fields[5], fields[6])
    return accounts


def read_groups(env):
    """group name -> (gid, members)"""
    groups = {}
    try:
        text = env.path('/etc/group').read_text()
    except OSError:
        return groups
    for line in text.splitlines():
        fields = line.split(':')
        if len(fields) >= 4 and fields[2].isdigit():
            groups[fields[0]] = (int(fields[2]), [m for m in fields[3].split(',') if m])
    return groups


def user_entry(env, name):
    return read_accounts(env).get(name)


def describe_owner(env, uid):
    """'deck (uid 1000)' for an account the sysroot knows, else 'uid 1000'."""
    for account in read_accounts(env).values():
        if account.uid == uid:
            return '%s (uid %d)' % (account.name, uid)
    return 'uid %d' % uid


def supplementary_groups(env, account):
    """The groups that list the account as a member (its own primary group is not one of them)."""
    return sorted(name for name, (_, members) in read_groups(env).items() if account.name in members)


def sensitive_memberships(env, account):
    found = []
    for name, (gid, members) in read_groups(env).items():
        if name in SENSITIVE_GROUPS and (account.name in members or gid == account.gid):
            found.append(name)
    return sorted(found)


def read_os_release(env):
    for relative in ('/etc/os-release', '/usr/lib/os-release'):
        try:
            text = env.path(relative).read_text()
        except OSError:
            continue
        fields = {}
        for line in text.splitlines():
            line = line.strip()
            if '=' in line and not line.startswith('#'):
                key, value = line.split('=', 1)
                fields[key.strip()] = value.strip().strip('"\'')
        return fields
    return {}


def gamescope_version(env):
    try:
        proc = env.run(['gamescope', '--version'], check=False, timeout=15)
    except DosplexError:
        return None
    text = (proc.stdout or '') + (proc.stderr or '')
    found = re.search(r'\bgamescope(?:\s+version)?\s+v?(\d+\.\d+[^\s()]*)', text, re.I)
    return found.group(1) if found else None


def steam_client_version(env, account):
    """The Steam client package version of the main user, or (None, reason).

    UNCERTAIN source, to be confirmed on a device: the client manifest in the Steam package directory,
    named after the channel in package/beta when that file exists.
    """
    package = env.path(account.home) / '.local/share/Steam/package'
    names = []
    try:
        channel = (package / 'beta').read_text().strip().splitlines()[0]
        if re.fullmatch(r'[A-Za-z0-9_.-]{1,64}', channel):
            names.append('steam_client_%s_ubuntu12.manifest' % channel)
    except (OSError, IndexError):
        pass
    names.append('steam_client_ubuntu12.manifest')
    for name in names:
        try:
            text = (package / name).read_text(errors='replace')[:65536]
        except OSError:
            continue
        found = re.search(r'"version"\s+"(\d+)"', text)
        if found:
            return found.group(1), name
    return None, 'no Steam client manifest found under %s' % package


def connected_displays(env):
    result = []
    for status in sorted(env.path('/sys/class/drm').glob('card*-*/status')):
        try:
            value = status.read_text().strip()
        except OSError:
            continue
        result.append({'connector': status.parent.name, 'status': value})
    return result


BUILTIN_CONNECTOR_RE = re.compile(r'^card\d+-(eDP|LVDS|DSI)-\d+$')


def output_target(env):
    """Which screen DosPlex would use: an external display (the TV) when one is connected, otherwise the
    device's built-in panel. Returns {'kind': 'external'|'builtin'|'none', 'connector': name or None,
    'native': [w, h] or None}. 'native' is the panel's preferred mode (first line of its modes file); a
    Steam Deck's panel is 800x1280 and the session shows it rotated, as 1280x800."""
    connected = [d['connector'] for d in connected_displays(env) if d['status'] == 'connected']
    external = [c for c in connected if not BUILTIN_CONNECTOR_RE.match(c)]
    if external:
        return {'kind': 'external', 'connector': external[0], 'native': None}
    if connected:
        native = None
        try:
            first = (env.path('/sys/class/drm') / connected[0] / 'modes').read_text().split()[0]
            found = re.fullmatch(r'(\d+)x(\d+)', first)
            native = [int(found[1]), int(found[2])] if found else None
        except (OSError, IndexError):
            pass
        return {'kind': 'builtin', 'connector': connected[0], 'native': native}
    return {'kind': 'none', 'connector': None, 'native': None}


def check_panel_mode(target, mode):
    """--output-mode on the built-in panel: only its own mode (in either orientation) can be asked for. The
    kernel lists no refresh rate for it, so the width and height are what is checked."""
    native = target['native']
    if mode and native and [mode[0], mode[1]] not in (native, native[::-1]):
        raise DosplexError('the built-in screen (%s) runs at %dx%d (shown as %dx%d); --output-mode %d %d %d is not '
                           'a mode it has. Leave --output-mode out to use the screen as it is'
                           % (target['connector'], native[0], native[1], native[1], native[0], *mode))


def hid_slot(env, hid):
    """Check that `hid` is a Steam Controller wireless receiver slot (28de:1304 or 28de:1305). Lifted from the retained
    trial's enrollment so the preview supports exactly what that path was tested with."""
    hid = str(hid)
    if not HIDRAW_RE.fullmatch(hid):
        raise DosplexError('%s is not a /dev/hidrawN path' % hid)
    name = hid.rsplit('/', 1)[1]
    try:
        device = (env.path('/sys/class/hidraw') / name / 'device').resolve(strict=True)
        hid_id = re.search(r'^HID_ID=0003:0000([0-9A-F]{4}):0000([0-9A-F]{4})$', (device / 'uevent').read_text(), re.M)
        if hid_id and (hid_id.group(1), hid_id.group(2)) == ('28DE', '1142'):
            raise DosplexError('%s is a Steam Controller dongle (28de:1142); it is not supported yet. This release '
                              'carries the wireless Steam Controller receivers 28de:1304 and 28de:1305' % hid)
        if not hid_id or (hid_id.group(1), hid_id.group(2)) not in (('28DE', '1304'), ('28DE', '1305')):
            raise DosplexError('%s is not a Steam Controller wireless receiver (28de:1304 or 28de:1305); this '
                              'release supports only those receivers' % hid)
        interface = device.parent
        usb = interface.parent
        serial = (usb / 'serial').read_text().strip() if (usb / 'serial').exists() else str(usb)
        identity = [(usb / 'idVendor').read_text().strip(), (usb / 'idProduct').read_text().strip(), serial,
                    (interface / 'bInterfaceNumber').read_text().strip()]
    except OSError as error:
        raise DosplexError('cannot inspect %s: %s' % (hid, error.strerror or error)) from None
    return hashlib.sha256(json.dumps(['native-receiver-slot', *identity]).encode()).hexdigest()[:32]


def builtin_deck(env):
    """The /dev/hidrawN nodes of the Steam Deck's own controller (28de:1205), sorted; [] on a device without one.

    A Deck has three HID interfaces for it. Its controls are Main's (ADR-014), so no external receiver is needed.
    """
    found = []
    for path in sorted(env.path('/sys/class/hidraw').glob('hidraw*')):
        try:
            uevent = (path / 'device/uevent').read_text()
        except OSError:
            continue
        if re.search(r'^HID_ID=0003:000028DE:00001205$', uevent, re.M):
            found.append('/dev/' + path.name)
    return sorted(found, key=lambda node: int(node[len('/dev/hidraw'):]))


def requested_hids(env, main, guest):
    """The [main, guest] slots the command line names, or None when it names none. Either may be given alone: a
    player without a slot starts without a controller. (A Steam Deck takes no Main slot; preflight says so.)"""
    if main is None and guest is None:
        return None
    return [main, guest]


def usable_hids(env, state, requested):
    """(the [main, guest] slots a start uses, notes). Slots named on the command line are used as they are and
    checked by preflight. Remembered slots (from install or an earlier start) are used only while each still
    names a supported receiver slot; one that does not is left out with a note, and never refuses the start."""
    if requested is not None:
        return list(requested), []
    remembered = state.get('controllers') or {}
    deck = builtin_deck(env)
    hids, keys, notes = [None, None], [None, None], []
    for number, role in enumerate(('main', 'guest')):
        hid = remembered.get(role)
        if hid is None:
            continue
        if role == 'main' and deck:
            notes.append("The remembered Main slot %s is not used: on a Steam Deck Main's controls are its own." % hid)
            continue
        try:
            keys[number] = hid_slot(env, hid)
        except DosplexError as error:
            notes.append('The remembered %s controller slot is not used: %s.' % (role.capitalize(), error))
            continue
        hids[number] = hid
    if hids[0] is not None and hids[1] is not None and (hids[0] == hids[1] or keys[0] == keys[1]):
        notes.append("The remembered Main and Guest slots are the same slot; Guest's is not used.")
        hids[1] = None
    return hids, notes


def report_kind(data):
    if data and (data[0], len(data)) in ((0x42, 54), (0x45, 46), (0x47, 46)):
        return 'ibex-input'
    if len(data) == 64 and data[:4] == bytes((1, 0, 1, 60)):
        return 'steam-controller-input'
    if len(data) == 64 and data[:4] == bytes((1, 0, 9, 64)):
        return 'deck-input'
    return 'other'


def sample_reports(env, nodes, seconds):
    """Count report kinds on each node for a few seconds. Read-only: nothing is grabbed or written."""
    if not 0 < seconds <= 5:
        raise ValueError('sample duration must be greater than zero and at most five seconds')
    opened, counts = {}, {node: Counter() for node in nodes}
    try:
        for node in nodes:
            try:
                fd = os.open(str(env.path(node)), os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
                opened[fd] = node
            except OSError:
                pass
        until = time.monotonic() + seconds
        while opened and time.monotonic() < until:
            for fd in select.select(list(opened), [], [], min(.1, max(0, until - time.monotonic())))[0]:
                try:
                    data = os.read(fd, 4096)
                except BlockingIOError:
                    continue
                except OSError:
                    os.close(fd)
                    del opened[fd]
                    continue
                if not data:
                    os.close(fd)
                    del opened[fd]
                    continue
                counts[opened[fd]][report_kind(data)] += 1
    finally:
        for fd in opened:
            os.close(fd)
    return counts


def processes(env, uid=None):
    """(pid, comm, uid) of the running processes; read from <sysroot>/proc."""
    found = []
    proc = env.path('/proc')
    try:
        entries = list(proc.iterdir())
    except OSError:
        return found
    for entry in entries:
        if not entry.name.isdigit():
            continue
        try:
            comm = (entry / 'comm').read_text().strip()
            status = (entry / 'status').read_text()
        except OSError:
            continue
        owner = re.search(r'^Uid:\s+(\d+)', status, re.M)
        if owner and (uid is None or int(owner.group(1)) == uid):
            found.append((int(entry.name), comm, int(owner.group(1))))
    return found


def host_mode(env, account):
    """'desktop' while the main user's Plasma session runs, 'gaming' under Gamescope, else 'unknown'."""
    comms = {comm for _, comm, _ in processes(env, account.uid)}
    if comms & {'kwin_wayland', 'kwin_x11'}:
        return 'desktop'
    if any(comm.startswith('gamescope') for comm in comms):
        return 'gaming'
    return 'unknown'


def host_desktop_session(env, account):
    comms = {comm for _, comm, _ in processes(env, account.uid)}
    if 'kwin_wayland' in comms:
        return 'plasma.desktop'
    if 'kwin_x11' in comms:
        return 'plasmax11.desktop'
    return None


def user_command(account, *args):
    return ['runuser', '-u', account.name, '--', 'env', 'XDG_RUNTIME_DIR=/run/user/%d' % account.uid,
            'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%d/bus' % account.uid, *args]


def steamosctl(env, account, verb, *args, check=True):
    return env.run(user_command(account, 'steamosctl', verb, *args), check=check, timeout=60).stdout.strip()


def gather_defaults(env, account):
    """The session defaults to leave exactly as they are, and the mode DosPlex found the device in."""
    def default(verb):
        try:
            return steamosctl(env, account, verb)
        except DosplexError:
            return None
    product = None
    try:
        product = env.path('/sys/class/dmi/id/product_name').read_text().strip()
    except OSError:
        pass
    return {'main_user': account.name, 'main_uid': account.uid,
            'login_mode': default('get-default-login-mode'),
            'desktop_session': default('get-default-desktop-session'),
            'host_mode': host_mode(env, account), 'host_desktop': host_desktop_session(env, account),
            'product': product}


def trial_roots(env):
    run = env.path('/run')
    try:
        return sorted(p for p in run.glob('dosplex-trial-*') if TRIAL_RE.fullmatch(p.name) and p.is_dir())
    except OSError:
        return []


# What the older installer (a script, before this program) and the first trial tooling put outside /opt and
# /var/lib, under the product's two names. dosplex never changes them (nothing under /usr, no units, no udev
# rules, ADR-005); it names them so that the person can remove them with the commands it prints.
LEGACY_TRACES = (
    '/usr/local/bin/{n}-compositor', '/usr/lib/systemd/system/{n}-compositor.service',
    '/usr/lib/udev/rules.d/72-{n}-hidraw-input.rules', '/usr/lib/udev/rules.d/99-{n}-uinput.rules',
    '/etc/udev/rules.d/99-{n}.rules', '/etc/sudoers.d/{n}-side-auth', '/etc/sudoers.d/zz-{n}-dev', '/etc/{n}',
    '/etc/systemd/system/{n}-compositor.service', '/etc/systemd/system/{n}-audio-router.service',
    '/etc/systemd/system/{n}-gamepad-arbiter.service', '/etc/systemd/system/{n}-primary-input-bridge.service',
    '/etc/systemd/system/{n}-deck-control-shortcut.service', '/etc/systemd/system/input-leap-{n}.service',
)


def legacy_leftovers(env):
    """Traces of the older installer (PKG-012). Reported, never changed."""
    found = []
    if lexists(env.path('/usr/local/bin/dosplex-compositor')):
        found.append('/usr/local/bin/dosplex-compositor')
    for template in LEGACY_TRACES:          # under the old name, everything the old installer could have left
        if lexists(env.path(template.format(n=LEGACY_PROGRAM))):
            found.append(template.format(n=LEGACY_PROGRAM))
    if lexists(env.path('/usr/bin/steamos-session-select.orig')):
        found.append('/usr/bin/steamos-session-select.orig')
    alias = env.path('/etc/systemd/system/display-manager.service')
    try:
        if lexists(alias) and any(name in os.path.realpath(alias) + alias.read_text(errors='replace')[:4096]
                                  for name in ('dosplex', LEGACY_PROGRAM)):
            found.append('/etc/systemd/system/display-manager.service')
    except OSError:
        pass
    return found


def legacy_trial_roots(env):
    """Retained trials started under the old name (/run/duplos-trial-*)."""
    run = env.path('/run')
    try:
        return sorted(p for p in run.glob(LEGACY_PROGRAM + '-trial-*') if LEGACY_TRIAL_RE.fullmatch(p.name) and p.is_dir())
    except OSError:
        return []


