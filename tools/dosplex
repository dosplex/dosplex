LIBRARY_APPLY = {'store': apply_library_store, 'unit': apply_library_unit, 'state': apply_library_state,
                 'unit-remove': apply_library_unit_remove, 'state-remove': apply_library_state_remove,
                 'auto': apply_library_auto, 'auto-remove': apply_library_auto_remove,
