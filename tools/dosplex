def sample_seconds(text):
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError('%r is not a number' % text) from None
    if not 0 <= value <= 5:
        raise argparse.ArgumentTypeError('must be between 0 and 5 seconds')
    return value


def check_output_mode(values):
    if values is None:
        return None
    width, height, refresh = values
    if not (640 <= width <= 16384 and 480 <= height <= 16384 and 24 <= refresh <= 240):
        raise UsageError('--output-mode %d %d %d is not a plausible display mode' % (width, height, refresh))
    return list(values)


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--sysroot', default=argparse.SUPPRESS, metavar='DIR',
                        help='run against this root directory instead of / (for tests)')
    parser = argparse.ArgumentParser(prog='dosplex', description=__doc__.split('\n')[0],
                                     epilog='Run `dosplex COMMAND --help` for the options of a command.')
    parser.add_argument('--sysroot', default='/', metavar='DIR',
                        help='run against this root directory instead of / (for tests)')
    sub = parser.add_subparsers(dest='command', metavar='COMMAND')

    def add(name, help, *, flags=()):
        command = sub.add_parser(name, help=help, parents=[common], description=help)
        if 'untested' in flags:
            command.add_argument('--allow-untested', action='store_true',
                                 help='continue on a SteamOS, Gamescope or Steam version the manifest does not list')
        if 'controllers' in flags:
            command.add_argument('--main-hid', metavar='/dev/hidrawX',
                                 help="Main's Steam Controller receiver slot (optional)")
            command.add_argument('--guest-hid', metavar='/dev/hidrawY',
                                 help="Guest's Steam Controller receiver slot (optional)")
            command.add_argument('--sample-seconds', type=sample_seconds, default=SAMPLE_SECONDS, metavar='S',
                                 help='how long to listen for controller input, for the report only: a sleeping '
                                 'controller never stops a start (0 to skip; default %(default)s)')
        if 'mode' in flags:
            command.add_argument('--output-mode', nargs=3, type=int, metavar=('W', 'H', 'HZ'),
                                 help='physical display mode to use while DosPlex runs, e.g. 3840 2160 60')
        if 'user' in flags:
            command.add_argument('--main-user', default=MAIN_USER, help=argparse.SUPPRESS)
        return command

    install = add('install', 'verify a bundle or a signed release, install it and create Guest (does not start DosPlex)',
                  flags=('untested', 'controllers', 'mode', 'user'))
    install.add_argument('bundle', type=Path, nargs='?', metavar='BUNDLE', help='the bundle directory (needs --manifest)')
    install.add_argument('--manifest', metavar='SHA256',
                         help='the approved SHA-256 of the bundle\'s manifest.json (required with BUNDLE)')
