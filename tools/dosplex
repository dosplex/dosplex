def legacy_created_guest(env, account):
    """True when an earlier private installer journal recorded creating exactly this Guest."""
    for host in sorted(p for pattern in ('dosplex-machine-*', 'duplos-machine-*')
                       for p in env.path('/var/tmp').glob(pattern + '/host.json')):
        try:
            for path in (host.parent, host):
                info = os.lstat(path)
                if stat.S_ISLNK(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o077:
                    raise PermissionError
            record = json.loads(host.read_text())
        except (OSError, ValueError, PermissionError):
            continue
        if (record.get('guest_creation_intent') is True and record.get('guest_home') == account.home
                and record.get('guest_uid') == account.uid and record.get('guest_gid') == account.gid):
            return True
    return False


def plan_guest(env, journal, state, main, strip=False):
    """Decide before anything changes: create Guest, adopt the existing one, or refuse.

    With strip, an existing Guest's memberships of audio, input, seat, video and render are to be removed
    (and recorded) as part of adopting it; any other group that voids the isolation still refuses.
    """
    entry = user_entry(env, GUEST_USER)
    home = env.path('/home') / GUEST_USER
    if entry is None:
        if lexists(home):
            raise RefusedError('/home/guest exists but there is no guest account. DosPlex will not take over a '
                               'directory it did not create: inspect it and move it away first. Nothing was changed.')
        if GUEST_USER in read_groups(env):
            raise RefusedError('a group named guest exists without a guest account; resolve that first. '
                               'Nothing was changed.')
        return {'action': 'create', 'user': GUEST_USER, 'home': '/home/guest', 'exists_before': False,
                'strip_groups': []}
    problems = []
    if entry.uid < MIN_UID:
        problems.append('its uid %d is below %d' % (entry.uid, MIN_UID))
    if main is not None and entry.uid == main.uid:
        problems.append('it is the same account as the main user')
    mode = None
    if not entry.home.startswith('/home/'):
        problems.append('its home %s is outside /home' % entry.home)
    else:
        try:
            info = os.lstat(env.path(entry.home))
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or not env.owned_by(info, entry.uid):
                problems.append('its home %s is not a directory that it owns' % entry.home)
            mode = stat.S_IMODE(info.st_mode)
        except OSError:
            problems.append('its home %s is missing' % entry.home)
    members = supplementary_groups(env, entry)
    removable = [group for group in STRIP_GROUPS if group in members]
    blocking = [group for group in sensitive_memberships(env, entry) if not (strip and group in removable)]
    if blocking:
        text = ('it is in the %s group%s, which would void the isolation between players'
                % ('/'.join(blocking), 's' if len(blocking) > 1 else ''))
        if not strip and all(group in removable for group in blocking):
            text += ('. An older installer leaves these memberships behind. Add --adopt-guest-strip-groups and '
                     'DosPlex removes exactly %s from Guest with gpasswd -d, one journaled step each, and uninstall '
                     'puts them back' % ', '.join(removable))
        problems.append(text)
    if problems:
        raise RefusedError('the existing guest account cannot be adopted: %s. Nothing was changed.'
                           % '; '.join(problems))
    return {'action': 'adopt', 'user': GUEST_USER, 'uid': entry.uid, 'gid': entry.gid, 'home': entry.home,
            'origin': adoption_origin(env, journal, state, entry), 'home_mode_before': mode, 'exists_before': True,
            'strip_groups': removable if strip else []}


def adoption_origin(env, journal, state, entry):
    known = (state or {}).get('guest')
    if known and known.get('uid') == entry.uid and known.get('home') == entry.home and \
            known.get('origin') in ('created', 'adopted-dosplex', 'adopted-foreign'):
        return known['origin']
    owned = journal.history() if journal is not None else None
    if owned and (owned.get('uid'), owned.get('gid'), owned.get('home')) == (entry.uid, entry.gid, entry.home):
        return 'adopted-dosplex'
    if legacy_created_guest(env, entry):
        return 'adopted-dosplex'
    return 'adopted-foreign'


def apply_guest(env, tx, data):
    if data['action'] == 'create':
        entry = user_entry(env, GUEST_USER)
        if entry is None:
            command = ['useradd'] + ([] if env.real else ['--root', str(env.sysroot)]) + [
                '--create-home', '--user-group', '--shell', GUEST_SHELL, GUEST_USER]
            env.run(command, timeout=120)
            env.fault('install:inner:guest-created')
            entry = user_entry(env, GUEST_USER)
        if entry is None or entry.uid < MIN_UID:
            raise DosplexError('useradd did not leave a usable guest account')
        origin, before = 'created', None
    else:
        entry = user_entry(env, GUEST_USER)
        if entry is None or entry.uid != data['uid']:
            raise DosplexError('the guest account changed while it was being adopted')
        origin, before = data['origin'], data['home_mode_before']
    if sensitive_memberships(env, entry):
        raise DosplexError('the guest account is in a group that would void the isolation')
    home = env.path(entry.home)
    env.allow_write(home)
    info = os.lstat(home)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or not env.owned_by(info, entry.uid):
        raise DosplexError('%s is not a directory that guest owns' % home)
    os.chmod(home, 0o700)
    if stat.S_IMODE(os.lstat(home).st_mode) != 0o700:
        raise DosplexError('could not set %s to 0700' % home)
    return {'action': data['action'], 'origin': origin, 'user': GUEST_USER, 'uid': entry.uid, 'gid': entry.gid,
            'home': entry.home, 'home_mode_before': before}


def group_command(env, flag, group):
    return ['gpasswd'] + ([] if env.real else ['--root', str(env.sysroot)]) + [flag, GUEST_USER, group]


def reported_groups(env):
    """What `id -nG guest` says: the system's own view of Guest's groups, or None when it cannot say."""
    if not env.which('id'):
        return None
    proc = env.run(['id', '-nG', GUEST_USER], check=False, timeout=15)
    return proc.stdout.split() if proc.returncode == 0 else None


def apply_guest_group(env, tx, data):
    """Take Guest out of one group. A membership that is already gone stays gone (repair runs this again)."""
    group = data['group']
    entry = user_entry(env, GUEST_USER)
    if group not in STRIP_GROUPS or entry is None or entry.uid != data['uid']:
        raise DosplexError('the guest account is not the one whose %s membership was to be removed' % group)
    if GUEST_USER in read_groups(env).get(group, (None, []))[1]:
        env.run(group_command(env, '-d', group), timeout=30)
        env.fault('install:inner:group-removed')
    if GUEST_USER in read_groups(env).get(group, (None, []))[1] or group in (reported_groups(env) or []):
        raise DosplexError('guest is still in the %s group after gpasswd -d' % group)
    return {'group': group, 'removed': True}


def restore_guest_group(env, data, op):
    """Put Guest back into a group that dosplex took it out of. Nothing else is ever added."""
    group = data['group']
    entry = user_entry(env, GUEST_USER)
    if group not in STRIP_GROUPS or entry is None or entry.uid != data['uid']:
        return {'group': group, 'restored': False, 'why': 'the guest account is not the one it was removed from'}
    groups = read_groups(env)
    if group not in groups:
        return {'group': group, 'restored': False, 'why': 'the group no longer exists'}
    if GUEST_USER in groups[group][1]:
        return {'group': group, 'restored': True}
    with env.group_restore():
        env.run(group_command(env, '-a', group), timeout=30)
    env.fault('%s:inner:group-restored' % op)
    return {'group': group, 'restored': True}


def undo_guest_group(env, tx, data, result):
    restore_guest_group(env, data, tx.op)


def apply_restore_guest_group(env, tx, data):
    return restore_guest_group(env, data, tx.op)


def guest_home_is_pristine(env, home):
    """True when nothing but the skeleton files of a new account is in Guest's home."""
    path = env.path(home)
    try:
        return not (path / '.local/share/Steam').exists() and not (path / '.steam').exists()
    except OSError:
        return False


def undo_guest(env, tx, data, result):
    """Roll back an interrupted install's Guest step. A Guest that was just created and is still empty
    goes away; anything else is kept, and an adopted Guest gets its home mode back."""
    entry = user_entry(env, GUEST_USER)
    if data['action'] == 'adopt':
        before = data.get('home_mode_before')
        if entry is not None and before is not None and entry.uid == data['uid']:
            env.allow_write(env.path(entry.home))
            try:
                os.chmod(env.path(entry.home), before)
            except OSError:
                pass
        return {}
    if entry is None:
        return {}
    if not guest_home_is_pristine(env, entry.home) or processes(env, entry.uid):
        return {'kept': True}
    remove_guest_account(env, entry)
    return {}


# After a session stops, Guest's user manager needs some seconds to exit; an uninstall waits that long.
GUEST_EXIT_SECONDS = 20
GUEST_EXIT_POLL_SECONDS = 0.5
GUEST_LOGIN_STATES = ('active', 'online', 'lingering', 'closing')
GUEST_LINGER_MESSAGE = ("Guest's account is set to keep running after sign-out (linger), so its processes do not end. "
                        "Switch that off with: sudo loginctl disable-linger guest   (then Guest can be removed).")


class GuestRunning(DosplexError):
    """Guest cannot be removed yet: its processes or its login are still there."""


def guest_login_property(env, name):
    """What logind says about Guest (read-only), or '' when it cannot say."""
    if not env.which('loginctl'):
        return ''
    proc = env.run(['loginctl', 'show-user', GUEST_USER, '--property=' + name, '--value'], check=False, timeout=15)
    return proc.stdout.strip() if proc.returncode == 0 else ''


def wait_for_guest_to_leave(env, uid, sleep=time.sleep, clock=time.monotonic):
    """Wait until Guest has no process and logind has no login for it; GuestRunning (with the true reason) if not."""
    seconds = GUEST_EXIT_SECONDS
    if not env.real and os.environ.get('DOSPLEX_TEST_GUEST_SECONDS'):
        seconds = float(os.environ['DOSPLEX_TEST_GUEST_SECONDS'])
    deadline = clock() + seconds
    while True:
        running = processes(env, uid)
        login = guest_login_property(env, 'State')
        if not running and login not in GUEST_LOGIN_STATES:
            return
        if clock() >= deadline:
            break
        sleep(GUEST_EXIT_POLL_SECONDS)
    if guest_login_property(env, 'Linger') == 'yes':
        raise GuestRunning(GUEST_LINGER_MESSAGE)
    if running:
        names = sorted({comm for _, comm, _ in running})[:5]
        raise GuestRunning('Guest still has running processes (%s).' % ', '.join(names))
    raise GuestRunning('Guest still has a login session (%s).' % login)


def remove_guest_account(env, entry):
    """userdel (never --remove) and then Guest's home with every safety check."""
    if processes(env, entry.uid):
        raise DosplexError('guest still has running processes; stop DosPlex first')
    login = guest_login_property(env, 'State')
    if login in GUEST_LOGIN_STATES:
        raise DosplexError('guest still has a login session (%s); stop DosPlex first' % login)
    env.run(['userdel'] + ([] if env.real else ['--root', str(env.sysroot)]) + [GUEST_USER], timeout=60)
    env.fault('uninstall:inner:guest-account-removed')
    remove_guest_home(env, entry.home, entry.uid)


def remove_guest_home(env, home, uid):
    path = env.path(home)
    env.allow_write(path)
    if not lexists(path):
        return False
    info = os.lstat(path)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or not env.owned_by(info, uid) or \
            not home.startswith('/home/') or home.rstrip('/').count('/') != 2:
        raise DosplexError('refusing to remove %s: it is not a plain home directory of guest' % path)
    try:
        mounts = env.path('/proc/self/mountinfo').read_text()
    except OSError:
        mounts = ''
    for line in mounts.splitlines():
        fields = line.split()
        if len(fields) > 4 and is_under(fields[4].replace('\\040', ' '), path):
            raise DosplexError('refusing to remove %s: %s is a mount point inside it' % (path, fields[4]))
    shutil.rmtree(path)
    fsync_dir(path.parent)
    return True


UPDATE_APPLY = {'release': apply_release, 'current': apply_current, 'cli': apply_cli_update,
                'state': apply_update_state, 'prune': apply_prune}
UPDATE_UNDO = {'stage': undo_stage, 'release': undo_release, 'current': undo_current, 'cli': undo_cli_update,
               'state': undo_state}
ROLLBACK_APPLY = {'current': apply_current, 'state': apply_rollback_state}
ROLLBACK_UNDO = {'current': undo_current, 'state': undo_state}
INSTALL_APPLY = {'release': apply_release, 'guest-group': apply_guest_group, 'guest': apply_guest,
                 'current': apply_current, 'cli': apply_cli, 'state': apply_state, 'prune': apply_prune}
INSTALL_UNDO = {'stage': undo_stage, 'release': undo_release, 'guest-group': undo_guest_group, 'guest': undo_guest,
                'current': undo_current, 'cli': undo_cli, 'state': undo_state}


def rollback(env, tx, table):
    """Undo, newest first, every step of `tx` that was started and has an undo."""
    for step, entry in reversed(list(tx.steps().items())):
        key = step.split(':', 1)[0]
        if entry['status'] in ('intent', 'done', 'undo-intent') and key in table:
            tx.undo(step, lambda data, result, key=key: table[key](env, tx, data, result))


def complete_plan(env, tx, table):
    """Run the rest of a committed plan. A step with an intent on disk is run again from that record."""
    for item in tx.plan:
        step = item['step']
        status = tx.status(step)
        if status in ('done', 'skipped'):
            continue
        apply = lambda data, key=step.split(':', 1)[0]: table[key](env, tx, data)
        if status == 'intent':
            tx.redo(step, apply)
        else:
            tx.run(step, item['data'], apply)


def release_info(state):
    """What it takes to make the release `state` describes the current one again (see rollback)."""
    return {'manifest_sha256': state['manifest_sha256'], 'commit': state['commit'], 'scope': state.get('scope', ''),
            'installed_utc': state.get('installed_utc'), 'signed': state.get('signed')}


def signed_fact(signed, manifest):
    """The signature facts the state keeps for a release, or None for one that was approved by its digest."""
    if signed is None or manifest.release is None:
        return None
    return {'key_id': signed.key_id, 'sequence': manifest.release['sequence']}


def plan_install(env, journal, verified, args, report, program, release=None, inherited=None):
    """Everything install decides, computed before the journal is created or anything is changed.

    `release` is (the dosplex program a signed release ships, what its signature said) for a signed release,
    which installs that program; without it the program that is running is the one that gets installed.
    `inherited` is what an install under the old name knew (inspect_legacy): it stands in for the state file
    when there is none, for the Guest record, the defaults, the controller slots and the output mode.
    """
    manifest = verified.manifest
    state = read_state(env)
    if state is not None:
        require_store_tool(state, manifest, 'install')
    known = state or inherited          # where the choices of an earlier install come from
    cli_bytes = program.read_bytes() if release is None else release[0]
    releases = env.opt / 'releases'
    existed = lexists(releases / manifest.version)
    if existed:
        try:
            verify_directory(releases / manifest.version, manifest.sha256, installed_uid=env.trusted_uid)
        except VerifyError as error:
            raise DosplexError('release %s is already installed with different contents (%s). Build the bundle '
                              'with a new version. Nothing was changed.' % (manifest.version, error)) from None
    current = current_version(env)
    installed_cli = env.opt / 'bin' / 'dosplex'
    controllers = ({'main': args.main_hid, 'guest': args.guest_hid} if (args.main_hid or args.guest_hid)
                   else (known or {}).get('controllers'))
    if current == manifest.version:
        previous, previous_info = (state or {}).get('previous'), (state or {}).get('previous_info')
    else:
        previous = current
        previous_info = release_info(state) if state and current == state['version'] else None
    if release is None:
        own_copy = lexists(installed_cli) and os.path.realpath(installed_cli) == str(program)
    else:       # a signed release brings its own program; the installed one is already right if it is the same
        own_copy = lexists(installed_cli) and installed_cli.is_file() and sha256_bytes(installed_cli.read_bytes()) == sha256_bytes(cli_bytes)
    return {
        'state': state, 'cli_bytes': cli_bytes, 'cli_sha256': sha256_bytes(cli_bytes), 'existed': existed,
        'current': current, 'previous': previous, 'previous_info': previous_info,
        'cli_version': manifest.release['cli']['version'] if release is not None else CLI_VERSION,
        'signed': signed_fact(release[1], manifest) if release is not None else None,
        'guest': plan_guest(env, journal, known, user_entry(env, args.main_user),
                            strip=bool(args.adopt_guest_strip_groups)),
        'own_copy': own_copy,
        'had_cli': lexists(installed_cli), 'controllers': controllers,
        'output_mode': (list(args.output_mode) if args.output_mode and output_target(env)['kind'] != 'builtin'
                        else (known or {}).get('output_mode')),
        'inherited': inherited,
        'untested': [c.name for c in report.untested()],
    }


def run_install(env, journal, verified, args, report, plan):
    manifest, state = verified.manifest, plan['state']
    main = user_entry(env, args.main_user)
    version = manifest.version
    source = ({'release': os.path.abspath(str(args.release)), 'signed_by': plan['signed']['key_id']} if args.release
              else {'bundle': os.path.abspath(str(args.bundle))})
    tx = journal.begin('install', version=version, manifest_sha256=manifest.sha256, commit=manifest.commit,
                       allow_untested=bool(args.allow_untested), untested=plan['untested'],
                       controllers=plan['controllers'], output_mode=plan['output_mode'],
                       cli_sha256=plan['cli_sha256'], observed=report.observed, **source)
    token = token_of(tx)
    stage = {'version': version, 'manifest_sha256': manifest.sha256, 'release_staging': STAGING_PREFIX + token,
             'skip_release': plan['existed'], 'cli_staging': None if plan['own_copy'] else '.dosplex-staged-' + token}
    steps = [
        {'step': 'release', 'data': {'version': version, 'manifest_sha256': manifest.sha256,
                                     'release_staging': stage['release_staging'], 'existed': plan['existed']}},
    ]
    steps += [{'step': 'guest-group:' + group, 'data': {'user': GUEST_USER, 'uid': plan['guest']['uid'], 'group': group}}
              for group in plan['guest'].get('strip_groups', [])]
    steps += [
        {'step': 'guest', 'data': plan['guest']},
        {'step': 'current', 'data': {'version': version, 'previous_current': plan['current']}},
    ]
    if not plan['own_copy']:
        steps.append({'step': 'cli', 'data': {'sha256': plan['cli_sha256'], 'cli_staging': stage['cli_staging'],
                                              'had_cli': plan['had_cli']}})
    steps += [
        {'step': 'state', 'data': {
            'version': version, 'commit': manifest.commit, 'scope': manifest.scope,
            'manifest_sha256': manifest.sha256, 'previous': plan['previous'], 'cli_sha256': plan['cli_sha256'],
            'previous_info': plan['previous_info'], 'signed': plan['signed'], 'cli_version': plan['cli_version'],
            'installed_utc': (state or {}).get('installed_utc') if plan['existed'] and state else utc_now(),
            'main_user': args.main_user, 'defaults': ((state or plan['inherited']) or {}).get('defaults'),
            'inherited_guest': (plan['inherited'] or {}).get('guest'),
            'controllers': plan['controllers'], 'output_mode': plan['output_mode'], 'untested': plan['untested'],
            'untested_observed': report.observed if plan['untested'] else None,
            'session': (state or {}).get('session'), 'trial': (state or {}).get('trial'),
            'previous_state': state}},
        {'step': 'prune', 'data': {'keep': [v for v in (version, plan['previous']) if v]}},
    ]
    try:
        tx.run('defaults', {}, lambda data: gather_defaults(env, main))
        tx.run('stage', stage, lambda data: apply_stage(env, data, verified, plan['cli_bytes']))
        tx.commit(steps)
        complete_plan(env, tx, INSTALL_APPLY)
        tx.end('complete', version=version, manifest_sha256=manifest.sha256)
    except BaseException as error:
        abort(env, tx, INSTALL_UNDO, error, 'install')
        raise
    return tx


def abort(env, tx, table, error, what):
    """An error (not a crash) interrupted `what`: undo it and end the transaction. If even that fails the
    transaction stays open for `dosplex repair`."""
    try:
        rollback(env, tx, table)
        cleanup_opt(env)
    except BaseException as undo_error:
        raise DosplexError('%s failed (%s) and could not be rolled back (%s). Run: sudo dosplex repair'
                          % (what, error, undo_error)) from error
    tx.end('rolled-back', error=str(error))


def cleanup_opt(env):
    """Remove the empty directories a finished or undone install leaves under /opt/dosplex."""
    for name in ('bin', 'releases'):
        env.rmdir_if_empty(env.opt / name)
    env.rmdir_if_empty(env.opt)


# ---------------------------------------------------------------------------------------------------
# Migration from DuplOS. The product was renamed in October 2026. A device that has the old install
# (/opt/duplos, /var/lib/duplos, maybe a running session) gets exactly one product after `dosplex install`:
#
#   1. inspect_legacy reads the old install without changing it. An interrupted operation of the old program, a
#      damaged state file or a symlinked directory refuses the install with the command to run.
#   2. A session that is still running is stopped by the old program (`duplos stop`, the same recovery that
#      restores the display mode and the Steam session), because the new program cannot start beside it. A
#      session the old program does not know is not touched: the message names the recovery command.
#   3. The install runs as always (the same journaled steps). It inherits what only the old state knew: the
#      main user, the Guest record (so that Guest stays "created by DosPlex" and uninstall --remove-guest still
#      works), the original SteamOS defaults, the controller slots and the output mode. If it fails, the old
#      install is still there, only its session is stopped.
#   4. finish_legacy moves the old data across and removes the old program and releases. /var/lib/duplos/*
#      is renamed into /var/lib/dosplex (side modes, controller registry, input policy, the per-user Wine
#      journals); the old state file and transaction journal are kept under /var/lib/dosplex/legacy-duplos as a
#      record. Everything it cannot place is left where it is and named. It can be run again after a crash.
#
# The side accounts' own files (~/.local/share/duplos, ~/DuplOS) are moved by the side session on its first
# launch (guest/dosplex-user-side-session.sh), because they belong to those accounts.
# ---------------------------------------------------------------------------------------------------

def legacy_env(env):
    """A view of env in which /opt/duplos and /var/lib/duplos play the part of opt and var (read the old
    state and journal with the same code that reads the new ones)."""
    view = copy.copy(env)
    view.legacy = True
    view.opt, view.var = env.path(LEGACY_OPT), env.path(LEGACY_VAR)
    view.extra_writable = []
    return view


def _legacy_program(view):
    """The old program, when it can be trusted to run as root: a regular file root owns that others cannot write."""
    program = view.opt / 'bin' / LEGACY_PROGRAM
    try:
        info = os.lstat(program)
    except OSError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != view.trusted_uid or info.st_mode & 0o022:
        return None
    return program


def inspect_legacy(env):
    """What an install under the old name left, or None. Read-only; raises when the old install cannot be
    migrated until the person has done something (the message says what)."""
    view = legacy_env(env)
    trials = legacy_trial_roots(env)
    if not (lexists(view.opt) or lexists(view.var) or trials):
        return None
    for path in (view.opt, view.var):
        if lexists(path) and (os.path.islink(path) or not os.path.isdir(path)):
            raise PolicyError('%s is not a real directory (a symlink or a file). The old DuplOS install cannot be '
                              'migrated safely; look at it, then run the install again. Nothing was changed.' % path)
    program = _legacy_program(view)
    history = state = None
    if lexists(view.var):
        journal = Journal.open(view)
        if journal is not None:
            with journal:
                pending = journal.interrupted()
                if pending is not None:
                    raise DosplexError(
                        'an operation of the old DuplOS program was interrupted (%s). Finish it first: sudo %s repair. '
                        'Then run the install again. Nothing was changed.'
                        % (pending.name, view.opt / 'bin' / LEGACY_PROGRAM))
                history = journal.history()
        state = read_state(view)
    inherit = None
    source = state or ({'guest': history, 'main_user': None} if history else None)
    if source is not None:
        guest = source.get('guest')
        if isinstance(guest, dict):
            guest = dict(guest, origin=LEGACY_ORIGINS.get(guest.get('origin'), guest.get('origin')))
        inherit = {'main_user': source.get('main_user'), 'guest': guest, 'defaults': source.get('defaults'),
                   'controllers': source.get('controllers'), 'output_mode': source.get('output_mode')}
    return {'state': state, 'version': (state or {}).get('version'), 'trials': trials, 'program': program,
            'inherit': inherit, 'opt': lexists(view.opt), 'var': lexists(view.var)}


def retire_legacy_session(env, legacy):
    """Stop a session that is still running under the old name. Returns True when there was one."""
    trials = legacy['trials']
    if not trials:
        return False
    program = legacy['program']
    by_hand = ' '.join('sudo python3 %s/root-session-trial.py recover --root %s;' % (t, t) for t in trials)
    if program is None or legacy['state'] is None:
        raise DosplexError('a DuplOS session is running (%s) and the old program that could stop it is not there. '
                          'Recover it by hand: %s then run the install again. Nothing was changed.'
                          % (', '.join(str(t) for t in trials), by_hand))
    say('A DuplOS session is running (%s). Stopping it with the old program first.' % ', '.join(str(t) for t in trials))
    command = [env.python, str(program)] + ([] if env.real else ['--sysroot', str(env.sysroot)]) + ['stop']
    proc = env.run(command, check=False, timeout=1800)
    left = legacy_trial_roots(env)
    if proc.returncode or left:
        detail = (proc.stderr or proc.stdout or '').strip().splitlines()
        raise DosplexError('the old program could not stop the DuplOS session%s. Try: sudo %s stop. If %s remains, '
                          'recover it by hand: %s then run the install again. Nothing else was changed.'
                          % (' (' + detail[-1] + ')' if detail else '', program,
                             ', '.join(str(t) for t in left or trials),
                             ' '.join('sudo python3 %s/root-session-trial.py recover --root %s;' % (t, t)
                                      for t in left or trials)))
    return True


def _move(env, source, destination):
    """Rename source to destination when destination is free. Both sit under /var/lib on one file system."""
    env.check_write(source)
    env.check_write(destination)
    if lexists(destination):
        return False
    os.rename(source, destination)
    fsync_dir(Path(destination).parent)
    fsync_dir(Path(source).parent)
    return True


def finish_legacy(env, legacy):
    """Move the old data into /var/lib/dosplex and remove the old program and releases. Idempotent.

    Returns {'moved': [...], 'kept': [...]}: what went where, and what was left in place because the new
    name already had it or because dosplex did not put it there.
    """
    view = legacy_env(env)
    env.allow_write(view.opt)
    env.allow_write(view.var)
    moved, kept = [], []
    if lexists(view.var):
        env.ensure_dir(env.var)
        archive = env.ensure_dir(env.var / ARCHIVE, 0o700)
        for name in sorted(os.listdir(view.var)):
            source = view.var / name
            if name == 'state.json':
                env.write_file(archive / 'state.json', source.read_bytes(), 0o600)
                env.unlink(source)
                moved.append('state.json (kept as a record in %s)' % archive)
            elif name.startswith('.state.json.new-'):
                env.unlink(source)
            elif name == 'journal':
                journal_dir = env.ensure_dir(archive / 'journal', 0o700)
                for entry in sorted(os.listdir(source)):
                    if entry == '.lock':
                        env.unlink(source / entry)
                    elif TX_RE.fullmatch(entry):
                        _move(env, source / entry, journal_dir / entry)
                    elif _move(env, source / entry, env.var / 'journal' / entry):
                        moved.append('journal/' + entry)      # the per-user Wine journals live beside the transactions
                    else:
                        kept.append('%s/journal/%s' % (LEGACY_VAR, entry))
                env.rmdir_if_empty(source)
                moved.append('journal (the old transactions are kept as a record in %s)' % journal_dir)
            elif _move(env, source, env.var / name):
                moved.append(name)
            else:
                kept.append('%s/%s' % (LEGACY_VAR, name))
        env.rmdir_if_empty(view.var)
        if lexists(view.var) and LEGACY_VAR not in kept:
            kept.append(LEGACY_VAR)
    if lexists(view.opt):
        releases = view.opt / 'releases'
        if releases.is_dir() and not os.path.islink(releases):
            for entry in sorted(releases.iterdir()):
                if VERSION_RE.fullmatch(entry.name) or entry.name.startswith(STAGING_PREFIX):
                    env.rmtree(entry)
            env.rmdir_if_empty(releases)
        bin_dir = view.opt / 'bin'
        if bin_dir.is_dir() and not os.path.islink(bin_dir):
            for entry in sorted(bin_dir.iterdir()):
                if entry.name.lstrip('.').startswith(LEGACY_PROGRAM):
                    env.unlink(entry)
            env.rmdir_if_empty(bin_dir)
        link = view.opt / 'current'
        if os.path.islink(link):
            env.unlink(link)
        for entry in sorted(view.opt.glob('.current.new-*')):
            env.unlink(entry)
        env.rmdir_if_empty(view.opt)
        if lexists(view.opt):
            kept.extend('%s/%s' % (LEGACY_OPT, p.name) for p in sorted(view.opt.iterdir()))
    return {'moved': moved, 'kept': kept}


def record_migration(env, legacy, result):
    """Journal that the migration ran, and note it in the state file (an additive field)."""
    with Journal.open(env, create=True, lock=True) as journal:
        journal.require_clean()
        tx = journal.begin('migrate', from_product='DuplOS', from_version=legacy['version'],
                           stopped_session=bool(legacy['trials']), moved=result['moved'], kept=result['kept'])
        state = read_state(env)
        if state is not None:
            state['migrated_from'] = {'product': 'DuplOS', 'version': legacy['version'], 'utc': utc_now()}
            write_state(env, state)
        tx.note('Moved the DuplOS install into DosPlex: %s.' % (', '.join(result['moved']) or 'nothing to move'))
        if result['kept']:
            tx.note('Left in place (the new name has it already, or DosPlex did not put it there): %s. '
                    'Look at it, then remove it yourself.' % ', '.join(result['kept']))
        tx.end('complete')


# ---------------------------------------------------------------------------------------------------
# update: fetch the signed release index, pick the newest release this device can run, stage it, switch
# `current` and keep the release it replaces (N-1), then restart DosPlex if it was running.
#
# Every release is checked against the pinned keys before anything is staged (see verify_release_archive),
# by the program that is installed now and never by anything in the new payload (ADR-005). The journal has
# the same shape as install's: stage, release, then a commit record, then the steps that make it the current
# release (current, cli, state, prune). A crash before the commit record is rolled back by `dosplex repair`
# and a crash after it is finished, so the device is either exactly as it was or fully on the new release.
# ---------------------------------------------------------------------------------------------------

def signature_address(url):
    parts = urllib.parse.urlsplit(url)
    return urllib.parse.urlunsplit(parts._replace(path=parts.path + '.minisig'))


def pick_release(env, state, index, allow_untested):
    """The newest release above the installed sequence that this program can check and this device is tested for.

    Returns (entry, skipped); `skipped` is a list of (newer entry, why) for the releases that were passed over:
    signed with a key this program does not pin (the index says so; a key rotation has such releases, and the
    release before them brings the program that trusts the new key), or not tested on this device. With nothing
    newer it returns (None, []). If every newer release is untested here, RefusedError (nothing changed) unless
    allow_untested, which takes the newest one. If every one is signed with a key this program lacks, VerifyError.
    """
    installed = (state.get('signed') or {}).get('sequence') or 0
    trusted = [key.id for key in pinned_keys()]
    skipped, untested = [], []
    for entry in (release for release in index.releases if release['sequence'] > installed):
        if entry['signed_by'] and entry['signed_by'] not in trusted:
            skipped.append((entry, 'signed with key %s, which this dosplex does not trust (it trusts %s)'
                            % (entry['signed_by'], ', '.join(trusted))))
            continue
        report = preflight(env, types.SimpleNamespace(tested=entry['tested_versions']), op='update',
                           user=state['main_user'], sample_seconds=0)
        report.enforce(True)                # a failed check (not root, no main user, ...) refuses at once
        if not report.untested():
            return entry, skipped
        detail = '; '.join('%s: %s' % (c.name, c.detail) for c in report.untested())
        untested.append((entry, detail))
        skipped.append((entry, 'not tested on this device (%s)' % detail))
    if untested:
        newest, detail = untested[0]
        if not allow_untested:
            raise RefusedError('the newest release, %s, is not tested on this device (%s). Nothing was changed. '
                               'Use --allow-untested to continue at your own risk.' % (newest['version'], detail))
        return newest, [(entry, why) for entry, why in skipped if entry['sequence'] > newest['sequence']]
    if skipped:
        raise VerifyError('this dosplex cannot check any newer release: %s. Install the newest release by hand from the '
                          'release page; the dosplex program inside it trusts the newer key. Nothing was changed.'
                          % '; '.join('%s is %s' % (entry['version'], why) for entry, why in skipped))
    return None, []


def release_plan(env, state, verified, program_bytes, report):
    """What an update decides before the journal is created or anything is changed."""
    manifest = verified.manifest
    releases = env.opt / 'releases'
    existed = lexists(releases / manifest.version)
    if existed:
        try:
            verify_directory(releases / manifest.version, manifest.sha256, installed_uid=env.trusted_uid)
        except VerifyError as error:
            raise DosplexError('release %s is already on this device with other contents (%s), for example because it '
                              'was installed from a bundle. Nothing was changed. Install the signed release over it '
                              'with: sudo dosplex install --release ARCHIVE' % (manifest.version, error)) from None
    installed_cli = env.opt / 'bin' / 'dosplex'
    installed_sha = sha256_bytes(installed_cli.read_bytes()) if installed_cli.is_file() else None
    return {'existed': existed, 'cli_sha256': sha256_bytes(program_bytes), 'installed_cli_sha256': installed_sha,
            'cli_changes': installed_sha != sha256_bytes(program_bytes),
            'had_previous_cli': lexists(env.opt / 'bin' / PREVIOUS_CLI),
            'untested': [c.name for c in report.untested()]}


def run_update(env, journal, state, verified, program_bytes, signed, report, plan, source):
    """The journaled part of an update. Returns the transaction."""
    manifest = verified.manifest
    version, previous = manifest.version, state['version']
    tx = journal.begin('update', version=version, manifest_sha256=manifest.sha256, commit=manifest.commit,
                       from_version=previous, from_manifest_sha256=state['manifest_sha256'],
                       sequence=manifest.release['sequence'], signed_by=signed.key_id, channel=source,
                       cli_sha256=plan['cli_sha256'], cli_changes=plan['cli_changes'], untested=plan['untested'],
                       observed=report.observed)
    token = token_of(tx)
    stage = {'version': version, 'manifest_sha256': manifest.sha256, 'release_staging': STAGING_PREFIX + token,
             'skip_release': plan['existed'], 'cli_staging': '.dosplex-staged-' + token if plan['cli_changes'] else None}
    steps = [
        {'step': 'release', 'data': {'version': version, 'manifest_sha256': manifest.sha256,
                                     'release_staging': stage['release_staging'], 'existed': plan['existed']}},
        {'step': 'current', 'data': {'version': version, 'previous_current': previous}},
    ]
    if plan['cli_changes']:
        steps.append({'step': 'cli', 'data': {
            'sha256': plan['cli_sha256'], 'cli_staging': stage['cli_staging'], 'had_cli': True,
            'previous_sha256': plan['installed_cli_sha256'], 'had_previous': plan['had_previous_cli']}})
    steps += [
        {'step': 'state', 'data': {
            'version': version, 'commit': manifest.commit, 'scope': manifest.scope,
            'manifest_sha256': manifest.sha256, 'previous': previous, 'previous_info': release_info(state),
            'installed_utc': utc_now(), 'signed': signed_fact(signed, manifest),
            'cli_sha256': plan['cli_sha256'] if plan['cli_changes'] else None,
            'cli_version': manifest.release['cli']['version'], 'untested': plan['untested'],
            'untested_observed': report.observed if plan['untested'] else None, 'previous_state': state}},
        {'step': 'prune', 'data': {'keep': [version, previous]}},
    ]
    try:
        tx.run('stage', stage, lambda data: apply_stage(env, data, verified, program_bytes, 'update'))
        tx.commit(steps)
        complete_plan(env, tx, UPDATE_APPLY)
        tx.end('complete', version=version, manifest_sha256=manifest.sha256)
    except BaseException as error:
        abort(env, tx, UPDATE_UNDO, error, 'update')
        raise
    return tx


def restart_session(env, allow_untested, sample_seconds):
    """Stop DosPlex and start it again, so that it runs the release that is now current, with the layout it had."""
    layout = ((read_state(env) or {}).get('trial') or {}).get('layout')
    created, proc = launch_worker(env, 'stop', {})
    if created is not None or proc.returncode != 0:
        finish_worker(env, 'stop', created, proc)
    start_client(env, argparse.Namespace(main_hid=None, guest_hid=None, output_mode=None, sample_seconds=sample_seconds,
                                         allow_untested=allow_untested, keep_on_failure=False, layout=layout, boot=False))


def finish_change(env, args, what, was_running, before, after):
    """Tell the person what changed and restart a session that was running."""
    say('%s DosPlex %s -> %s.' % (what, before, after))
    if not was_running:
        return 0
    if args.no_restart:
        say('DosPlex keeps running the release it started with. To run %s: sudo dosplex stop, then sudo dosplex start' % after)
        return 0
    say('Restarting DosPlex on %s.' % after)
    try:
        restart_session(env, args.allow_untested, args.sample_seconds)
    except DosplexError as error:
        raise DosplexError('%s DosPlex %s -> %s, but DosPlex could not be restarted: %s. Fix that and run: sudo dosplex start; '
                          'or go back with: sudo dosplex rollback' % (what, before, after, error)) from error
    return 0


def require_store_tool(state, manifest, verb):
    """While the shared game library is on, the boot unit runs the tool of the current release."""
    if state.get('game_store') and GAME_STORE_TOOL not in manifest.files:
        raise RefusedError('the shared game library is on, and release %s has no tool for it (%s), so the boot unit '
                           'would find nothing to run. Nothing was changed. Turn the library off first: sudo dosplex '
                           'library off, restart the machine, then run: sudo dosplex %s'
                           % (manifest.version, GAME_STORE_TOOL, verb))


def cmd_update(env, args):
    env.require_root()
    reader = Journal.open(env)
    try:
        if reader is not None:
            reader.require_clean()
        state = read_state(env)
    finally:
        if reader is not None:
            reader.close()
    if state is None:
        raise DosplexError('DosPlex is not installed, so there is nothing to update. Install a release first: '
                          'sudo dosplex install --release ARCHIVE')
    check_current(env, state)
    keys = pinned_keys()
    require_keys(keys)                      # before any network use
    channel = channel_address(args.channel or os.environ.get(CHANNEL_ENV) or DEFAULT_CHANNEL)
    say('Looking for a newer release in %s' % redact_url(channel))
    raw = fetch_url(channel, MAX_INDEX, 'release index')
    signed_index = verify_signature(raw, fetch_url(signature_address(channel), MAX_SIGNATURE, 'signature of the index').decode('utf-8', 'replace'),
                                    keys, 'index')
    index = parse_index(raw, channel)
    if signed_index.subject != index.channel:
        raise VerifyError('the index is signed for channel %s but says it is channel %s' % (signed_index.subject, index.channel))
    entry, skipped = pick_release(env, state, index, args.allow_untested)
    installed = (state.get('signed') or {}).get('sequence')
    say('Installed: %s%s. Index: channel %s, %d release(s), signed by key %s.' % (
        state['version'], ' (sequence %d)' % installed if installed else ' (not from a signed release)',
        index.channel, len(index.releases), signed_index.key_id))
    for other, why in skipped:
        say('Skipped %s (sequence %d): %s' % (other['version'], other['sequence'], why))
    if entry is None:
        say('DosPlex is up to date.')
        return 0
    if args.check:
        say('Update available: %s (sequence %d). Run: sudo dosplex update' % (entry['version'], entry['sequence']))
        return 0
    say('Updating to %s (sequence %d).' % (entry['version'], entry['sequence']))
    manifest_raw = fetch_url(index.resolve(entry['manifest']['url']), entry['manifest']['bytes'], 'manifest')
    if sha256_bytes(manifest_raw) != entry['manifest']['sha256']:
        raise VerifyError('the manifest of %s is not the one the signed index names' % entry['version'])
    signature = fetch_url(index.resolve(entry['signature']['url']), MAX_SIGNATURE, 'signature of the manifest').decode('utf-8', 'replace')
    verify_signature(manifest_raw, signature, keys, 'manifest')          # before the big download
    require_store_tool(state, parse_manifest(manifest_raw), 'update')
    say('Downloading %s (%.1f MB).' % (entry['version'], entry['tarball']['bytes'] / 1e6))
    archive = fetch_url(index.resolve(entry['tarball']['url']), entry['tarball']['bytes'], 'release archive')
    if len(archive) != entry['tarball']['bytes'] or sha256_bytes(archive) != entry['tarball']['sha256']:
        raise VerifyError('the archive of %s is not the one the signed index names' % entry['version'])
    verified, program_bytes, signed = verify_release_archive(archive, signature, keys)
    manifest = verified.manifest
    if (verified.manifest.raw != manifest_raw or manifest.version != entry['version'] or manifest.commit != entry['commit']
            or manifest.release['sequence'] != entry['sequence'] or manifest.tested != entry['tested_versions']):
        raise VerifyError('the signed index and the signed manifest of %s disagree; refusing both' % entry['version'])
    missing = missing_required(manifest)
    if missing:
        raise VerifyError(missing_message(missing) + ' Nothing was changed.')
    say('Verified the signature of release %s (key %s, sequence %d) and %d files against manifest %s.' % (
        manifest.version, signed.key_id, manifest.release['sequence'], len(verified.files), manifest.sha256[:12]))
    report = preflight(env, manifest, op='update', user=state['main_user'], sample_seconds=0,
                       need_bytes=verified.total_bytes())
    say(report.text())
    report.enforce(args.allow_untested)
    journal = Journal.open(env, create=True, lock=True)
    with journal:
        journal.require_clean()
        if read_state(env) != state:
            raise DosplexError('DosPlex changed while the update was being fetched. Nothing was changed; run the command again.')
        was_running = trial_status(env, state)['alive']
        plan = release_plan(env, state, verified, program_bytes, report)
        run_update(env, journal, state, verified, program_bytes, signed, report, plan, redact_url(channel))
    ensure_library_units(env)
    ensure_autostart_unit(env)
    ensure_entry(env)
    return finish_change(env, args, 'Updated', was_running, state['version'], manifest.version)


# ---------------------------------------------------------------------------------------------------
# rollback: make the release before the current one (N-1, kept by install and update) the current one again.
# Nothing is downloaded and nothing is unpacked: the kept release is checked against the digest the state
# recorded for it, then `current` is switched. The release rolled back from is kept in its place, so a second
# rollback goes forward again.
# ---------------------------------------------------------------------------------------------------

def run_rollback(env, journal, state, verified, report):
    manifest = verified.manifest
    info = state['previous_info']
    target, leaving = manifest.version, state['version']
    plan_untested = [c.name for c in report.untested()]
    tx = journal.begin('rollback', version=target, manifest_sha256=info['manifest_sha256'], from_version=leaving,
                       from_manifest_sha256=state['manifest_sha256'], untested=plan_untested, observed=report.observed)
    steps = [
        {'step': 'current', 'data': {'version': target, 'previous_current': leaving}},
        {'step': 'state', 'data': {
            'version': target, 'commit': info['commit'], 'scope': info['scope'], 'manifest_sha256': info['manifest_sha256'],
            'previous': leaving, 'previous_info': release_info(state), 'installed_utc': info['installed_utc'],
            'signed': info['signed'], 'untested': plan_untested,
            'untested_observed': report.observed if plan_untested else None, 'previous_state': state}},
    ]
    try:
        tx.run('verify-previous', {'version': target, 'manifest_sha256': info['manifest_sha256'], 'files': len(verified.files)},
               lambda data: {})
        tx.commit(steps)
        complete_plan(env, tx, ROLLBACK_APPLY)
        tx.end('complete', version=target, manifest_sha256=info['manifest_sha256'])
    except BaseException as error:
        abort(env, tx, ROLLBACK_UNDO, error, 'rollback')
        raise
    return tx


def cmd_rollback(env, args):
    env.require_root()
    reader = Journal.open(env)
    try:
        if reader is not None:
            reader.require_clean()
        state = read_state(env)
    finally:
        if reader is not None:
            reader.close()
    if state is None:
        raise DosplexError('DosPlex is not installed, so there is nothing to roll back.')
    check_current(env, state)
    previous, info = state.get('previous'), state.get('previous_info')
    if not previous or not (env.opt / 'releases' / previous).is_dir():
        raise DosplexError('There is no earlier release to go back to (a release is kept after an update or a second '
                          'install). Nothing was changed.')
    if not info:
        raise DosplexError('The record of release %s is incomplete because an older dosplex installed over it. Install it '
                          'again from its bundle or release archive. Nothing was changed.' % previous)
    verified = verify_directory(env.opt / 'releases' / previous, info['manifest_sha256'], installed_uid=env.trusted_uid)
    if verified.manifest.version != previous:
        raise VerifyError('the release kept as %s says it is %s. Nothing was changed.' % (previous, verified.manifest.version))
    say('Release %s is intact: %d files match manifest %s.' % (previous, len(verified.files), verified.manifest.sha256[:12]))
    missing = missing_required(verified.manifest)
    if missing:
        raise VerifyError(missing_message(missing).replace('the bundle lacks', 'release %s lacks' % previous)
                          + ' Nothing was changed.')
    require_store_tool(state, verified.manifest, 'rollback')
    report = preflight(env, verified.manifest, op='update', user=state['main_user'], sample_seconds=0)
    say(report.text())
    report.enforce(args.allow_untested)
    journal = Journal.open(env, create=True, lock=True)
    with journal:
        journal.require_clean()
        if read_state(env) != state:
            raise DosplexError('DosPlex changed while the rollback was being prepared. Nothing was changed; run the command again.')
        was_running = trial_status(env, state)['alive']
        run_rollback(env, journal, state, verified, report)
    return finish_change(env, args, 'Rolled back', was_running, state['version'], previous)


# ---------------------------------------------------------------------------------------------------
# The session: what `start` and `stop` run. This wraps the retained trial that works today. The seeds
# (root-session-trial.py and start-external-native-trial.py) are imported from the verified installed
# release; their verification step is replaced by this program's own.
# ---------------------------------------------------------------------------------------------------

class Seeds:
    NAMES = {'trial': 'root-session-trial.py', 'external': 'start-external-native-trial.py'}

    def __init__(self, release):
        self.release = Path(release)
        self.modules = {}

    def module(self, key):
        if key not in self.modules:
            path = self.release / 'tools' / self.NAMES[key]
            spec = importlib.util.spec_from_file_location('dosplex_seed_' + key, path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            self.modules[key] = module
        return self.modules[key]


TEST_HOOKS_MARKER = 'test-hooks'     # under /var/lib/dosplex: root's engineering switch; a release never creates it


def test_hooks_marked(env):
    """Whether root asked for sessions with the compositor's test hooks (TRL-09): an ordinary file of root's
    that nobody else may write. Without it a session has no test hooks, no power stand-in and no synthetic
    controls in the relays."""
    try:
        info = os.lstat(env.var / TEST_HOOKS_MARKER)
    except OSError:
        return False
    return stat.S_ISREG(info.st_mode) and info.st_uid == env.trusted_uid and not info.st_mode & 0o022


def wait_for(predicate, seconds, what):
    deadline = time.monotonic() + seconds
    while not predicate():
        if time.monotonic() > deadline:
            raise DosplexError(what)
        time.sleep(.1)


def replace_mode(data, description, width, height, refresh):
    """The Gamescope modes.cfg bytes with one connector's mode replaced; every other byte is kept."""
    if not description or len(description) > 200 or any(c in description for c in ':\r\n'):
        raise ValueError('invalid connector description')
    if not (640 <= width <= 16384 and 480 <= height <= 16384 and 24 <= refresh <= 240):
        raise ValueError('invalid mode')
    prefix = description.encode() + b':'
    lines = data.splitlines(keepends=True)
    matches = [i for i, line in enumerate(lines) if line.startswith(prefix)]
    if len(matches) > 1:
        raise ValueError('duplicate connector settings; inspect before changing')
    replacement = prefix + ('%dx%d@%d 0\n' % (width, height, refresh)).encode()
    if matches:
        lines[matches[0]] = replacement
    else:
        if data and not data.endswith(b'\n'):
            lines.append(b'\n')
        lines.append(replacement)
    return b''.join(lines)


class Display:
    """Journaled physical output mode: the saved connector mode controls scanout, and the host Xwayland
    size has to follow. The original bytes of modes.cfg are kept in /var/lib/dosplex/display-mode.json
    and put back only while the file still holds the value this program wrote."""

    def __init__(self, env, account):
        self.env, self.account = env, account
        self.mode_file = env.path(account.home) / '.config/gamescope/modes.cfg'
        self.record_path = env.var / 'display-mode.json'
        # How long to wait for Gamescope to follow a change, and for it to follow a restore (it may never).
        self.wait, self.settle = 12.0, 5.0
        if not env.real and os.environ.get('DOSPLEX_TEST_DISPLAY_SECONDS'):
            self.wait = self.settle = float(os.environ['DOSPLEX_TEST_DISPLAY_SECONDS'])

    def user(self, *args):
        return ['runuser', '-u', self.account.name, '--', 'env', 'DISPLAY=:0',
                'XAUTHORITY=%s/.Xauthority' % self.account.home,
                'XDG_RUNTIME_DIR=/run/user/%d' % self.account.uid, *args]

    def query(self, *args):
        return self.env.run(self.user(*args), timeout=15).stdout.strip()

    def record(self):
        try:
            return json.loads(self.record_path.read_text())
        except (OSError, ValueError):
            return None

    def save(self, record):
        self.env.write_file(self.record_path, (json.dumps(record, indent=2, sort_keys=True) + '\n').encode(), 0o600)

    def virtual_size(self):
        text = self.query('xwininfo', '-root')
        return [int(re.search(r'^\s*%s: (\d+)' % field, text, re.M)[1]) for field in ('Width', 'Height')]

    def physical_modes(self):
        result = []
        for path in sorted(self.env.path('/sys/kernel/debug/dri').glob('[0-9]/state')):
            try:
                text = path.read_text()
            except OSError:
                continue
            for block in re.split(r'(?m)^crtc\[', text)[1:]:
                if re.search(r'(?m)^\s*active=1$', block):
                    found = re.search(r'mode: "([0-9]+)x([0-9]+)": ([0-9]+)', block)
                    if found:
                        result.append([int(v) for v in found.groups()])
        return result

    def write_user_file(self, expected_sha256, data):
        self.env.allow_write(self.mode_file.parent)
        self.env.run(self.user(self.env.python, '-c', USER_WRITE_SCRIPT, str(self.mode_file), expected_sha256),
                     input=data, timeout=20)

    def nudge(self):
        self.query('xprop', '-root', '-f', 'GAMESCOPE_DISPLAY_MODE_NUDGE', '32c', '-set',
                   'GAMESCOPE_DISPLAY_MODE_NUDGE', '1')

    def resize_host(self, width, height):
        self.query('xprop', '-root', '-f', 'GAMESCOPE_XWAYLAND_MODE_CONTROL', '32c', '-set',
                   'GAMESCOPE_XWAYLAND_MODE_CONTROL', '0, %d, %d, 0' % (width, height))
        wait_for(lambda: self.virtual_size() == [width, height], self.wait, 'the host display size did not follow')

    def apply(self, mode, trial_module, trial_root):
        width, height, refresh = mode
        info = self.query('gamescopectl')
        make, model = re.search(r'Display Make: ([^\n]+)', info), re.search(r'Display Model: ([^\n]+)', info)
        if not make or not model:
            raise DosplexError('cannot identify the active display connector')
        description = make[1].strip() + ' ' + model[1].strip()
        listed = self.query('xprop', '-root', 'GAMESCOPE_DISPLAY_MODE_LIST_EXTERNAL')
        if '%dx%d@%d' % (width, height, refresh) not in re.findall(r'\b\d+x\d+@\d+\b', listed):
            raise DosplexError('the TV does not advertise %dx%d at %d Hz' % (width, height, refresh))
        if self.mode_file.is_symlink() or not self.mode_file.is_file():
            raise DosplexError('expected a regular %s' % self.mode_file)
        current = self.mode_file.read_bytes()
        earlier = self.record()
        # A mode applied before a reboot and never restored: the true original is the one saved then.
        original = current
        if earlier and earlier.get('phase') != 'restored':
            original = base64.b64decode(earlier['before_base64'])
        after = replace_mode(current, description, width, height, refresh)
        record = {'phase': 'prepared', 'file': str(self.mode_file), 'description': description,
                  'before_base64': base64.b64encode(original).decode(), 'before_sha256': sha256_bytes(original),
                  'after_sha256': sha256_bytes(after), 'old_virtual': self.virtual_size(),
                  'old_physical': self.physical_modes(), 'requested': [width, height, refresh]}
        self.save(record)
        self.env.fault('start:inner:display-prepared')
        self.write_user_file(sha256_bytes(current), after)
        self.nudge()
        wait_for(lambda: [width, height, refresh] in self.physical_modes(), self.wait,
                 'the display mode did not change; it will be restored by dosplex stop')
        self.resize_host(width, height)
        trial_module.trusted_root(trial_root)
        presentation = trial_module.present_window(self.account.name, set())
        state_path = Path(trial_root) / 'runtime/state.json'

        def matching():
            layout = json.loads(state_path.read_text())
            return (max(layout[x]['x'] + layout[x]['width'] for x in ('left', 'right')) == width
                    and max(layout[x]['y'] + layout[x]['height'] for x in ('left', 'right')) == height)
        wait_for(matching, self.wait, 'the DosPlex regions did not follow the new display size')
        record.update(phase='applied', physical=self.physical_modes(), virtual=self.virtual_size())
        self.save(record)
        return {'mode': [width, height, refresh], 'presentation': presentation}

    def restore(self):
        """Put modes.cfg back and ask Gamescope to follow, without ever failing the caller.

        A running host Gamescope does not re-read the file (HW-008), so convergence is only waited for
        briefly; the saved mode then returns the next time Gamescope starts.
        """
        record = self.record()
        if not record or record.get('phase') == 'restored':
            return {'restored': False}
        original = base64.b64decode(record['before_base64'], validate=True)
        if sha256_bytes(original) != record['before_sha256']:
            raise DosplexError('the saved display settings are damaged; left as they are')
        try:
            current = sha256_bytes(self.mode_file.read_bytes())
        except OSError:
            current = None
        note = None
        if current == record['after_sha256']:
            try:
                self.write_user_file(current, original)
            except DosplexError as error:
                return {'restored': False, 'converged': False, 'note': str(error)}
        elif current != record['before_sha256']:
            note = 'the display settings were changed since; left as the user has them'
        converged = False
        try:
            self.nudge()
            deadline = time.monotonic() + self.settle
            while time.monotonic() < deadline:
                if not record['old_physical'] or self.physical_modes() == record['old_physical']:
                    converged = True
                    break
                time.sleep(.2)
            if converged:
                self.resize_host(*record['old_virtual'])
        except DosplexError as error:
            note = note or str(error)
        record['phase'] = 'restored'
        self.save(record)
        return {'restored': True, 'converged': converged, 'note': note}


class Session:
    """start and stop, running in the worker (a transient system service) with the journal locked."""

    def __init__(self, env, journal, state):
        self.env, self.journal, self.state = env, journal, state
        self.account = user_entry(env, state['main_user'])
        if self.account is None:
            raise DosplexError('the main user %s no longer exists' % state['main_user'])
        self.release = env.opt / state['release']
        self.seeds = Seeds(self.release)
        self.tx = None

    # --- helpers -------------------------------------------------------------------------------
    def note(self, text):
        if self.tx is not None:
            self.tx.note(text)
        else:
            say(text)

    def trial_alive(self):
        """The root of the trial that dosplex started and that still runs, or None."""
        trial = self.state.get('trial')
        if not trial:
            return None
        root = Path(trial['root'])
        try:
            record = json.loads((root / 'transaction.json').read_text())
        except (OSError, ValueError):
            return None
        return root if record.get('phase') == 'started' else None

    def trial_ended(self):
        """The root of a trial whose record says started but whose compositor is gone, or None (TRL-03)."""
        root = self.trial_alive()
        return root if root is not None and trial_status(self.env, self.state).get('ended') else None

    def idle(self):
        try:
            return bool(self.seeds.module('trial').idle_steam(self.account.name))
        except Exception:
            return False

    def check_root(self, root):
        root = Path(root)
        if root.parent != self.env.path('/run') or not TRIAL_RE.fullmatch(root.name):
            raise DosplexError('%s is not a retained trial directory' % root)
        return root

    def save_state(self, **changes):
        self.state.update(changes)
        write_state(self.env, self.state)

    # --- start ---------------------------------------------------------------------------------
    def start(self, opts):
        state = self.state
        hids, notes = (list(opts['hids']), []) if opts.get('hids') else usable_hids(self.env, state, None)
        layout = opts.get('layout') or 'vertical'
        if layout not in LAYOUTS:
            raise DosplexError('the layout is one of: %s' % ', '.join(LAYOUTS))
        output_mode = opts.get('output_mode') or state.get('output_mode')
        # On the built-in screen (no external display) the saved TV mode does not apply and is kept for
        # the next docked start; an explicit mode is only checked against the panel.
        target = output_target(self.env)
        if target['kind'] == 'builtin':
            check_panel_mode(target, opts.get('output_mode'))
            output_mode = None
        tx = self.tx = self.journal.begin('start', hids=hids, output_mode=output_mode, layout=layout,
                                          boot=bool(opts.get('boot')), allow_untested=bool(opts.get('allow_untested')))
        for note in notes:
            tx.note(note)
        try:
            return self._start(tx, opts, hids, output_mode, layout)
        except BaseException as error:
            self._abort_start(tx, error, keep=bool(opts.get('keep_on_failure')))
            raise

    def _start(self, tx, opts, hids, output_mode, layout='vertical'):
        env, state = self.env, self.state
        check_current(env, state)
        verified = verify_directory(self.release, state['manifest_sha256'], installed_uid=env.trusted_uid)
        tx.run('verify-release', {'release': state['release'], 'files': len(verified.files)}, lambda d: {})
        # A controller is never listened to for a start, asleep or awake: nothing is sampled here.
        report = preflight(env, verified.manifest, op='start', user=state['main_user'], hids=hids, sample_seconds=0)
        warnings = start_acceptance(report, state, bool(opts.get('allow_untested')),
                                    bool(opts.get('boot') or opts.get('unattended')))
        for warning in warnings:
            tx.note('Warning: ' + warning)
        tx.run('preflight', {}, lambda d: {'observed': report.observed, 'untested': [c.name for c in report.untested()]})
        ended = self.trial_ended()
        if self.trial_alive() and not ended:
            tx.note('DosPlex is already running (%s). Nothing to do.' % state['trial']['root'])
            tx.end('complete', note='already running')
            return 0
        if ended:
            # The compositor is gone but its trial is still there: the recovery that should have followed did not
            # finish (or this release had none). Bring stock Steam back first, then start again.
            tx.note('DosPlex ended on its own earlier (its compositor is not running). Bringing stock Steam back first.')
            tx.run('recover-ended-session', {'root': str(ended)}, lambda d: self.stop_logic(d['root'], None))
        others = [str(p) for p in trial_roots(env) + legacy_trial_roots(env)]
        if others:
            raise DosplexError('a retained trial is running that dosplex did not start (%s). Recover it with '
                              'its own tool first; dosplex will not start a second compositor.' % ', '.join(others))
        if state.get('trial'):
            tx.note('The previous run is gone (the device was restarted, or DosPlex ended and stock Steam came back). '
                    'Starting again.')
            def forget(data):
                self.save_state(trial=None)
                return {}
            tx.run('forget-stale-trial', {'root': state['trial']['root']}, forget)
        display = Display(env, self.account)
        if display.record() and display.record().get('phase') not in (None, 'restored'):
            tx.run('restore-stale-display', {}, lambda d: display.restore())
        boot = bool(opts.get('boot'))
        if boot:
            # At boot Steam may still be starting or updating itself: wait for it, and leave everything as it is when
            # it does not come up idle, or when the device turns out to be in Desktop mode.
            waited = tx.run('idle-steam', {'boot': True}, self._wait_idle_at_boot)
            if waited['outcome'] != 'idle':
                tx.note({'desktop': 'DosPlex does not start at boot in Desktop mode; Steam is left as it is.',
                         'busy': 'Steam was not idle after %d minutes, so DosPlex did not start at boot; Steam is left '
                                 'running.' % (BOOT_IDLE_SECONDS // 60)}[waited['outcome']])
                tx.end('complete', note='boot start skipped: ' + waited['outcome'])
                return 0
        host = tx.run('host-mode', self._plan_host_mode(boot), self._host_mode)
        if not boot:
            tx.run('idle-steam', {}, self._wait_idle)
        deck = bool(builtin_deck(env))    # a Steam Deck: Main's controls are the built-in ones
        trial = tx.run('trial', {'before': [str(p) for p in trial_roots(env)], 'deck': deck, 'layout': layout},
                       self._start_trial)
        tx.run('controllers', {'trial': trial['root'], 'main': hids[0], 'guest': hids[1], 'deck': deck,
                               'layout': layout}, self._controllers)
        if output_mode:
            tx.run('display-mode', {'mode': output_mode, 'trial': trial['root']},
                   lambda d: display.apply(d['mode'], self.seeds.module('trial'), Path(d['trial'])))

        def running(data):
            changes = dict(
                trial={'root': trial['root'], 'started_utc': utc_now(), 'tx': token_of(tx), 'layout': layout},
                session={'original': host['original'], 'desktop_session': host['desktop_session'],
                         'switched': host['switched']},
                controllers={'main': hids[0], 'guest': hids[1]} if opts.get('remember') else state.get('controllers'),
                output_mode=output_mode if output_mode else state.get('output_mode'),
                untested_observed=state.get('untested_observed') if warnings else (
                    report.observed if report.untested() else None),
                boot_warnings=warnings or None)
            self.save_state(**changes)
            return {}
        tx.run('running', {'trial': trial['root']}, running)
        tx.note('DosPlex is running (%s).' % trial['root'])
        tx.end('complete', trial=trial['root'])
        return 0

    def _plan_host_mode(self, boot=False):
        """Decide, without changing anything, whether the device has to be switched to Gaming mode. A start at boot
        never switches it: it has waited for Steam to be idle before it gets here."""
        original = host_mode(self.env, self.account)
        desktop = host_desktop_session(self.env, self.account)
        if self.idle() or boot:
            switch = False
        elif original == 'desktop':
            switch = True
        else:
            raise DosplexError('Steam is busy or the session is unknown. Close any running game and return to '
                              'the Steam home screen (or Desktop mode), then run: sudo dosplex start')
        return {'original': original, 'desktop_session': desktop, 'switched': switch}

    def _host_mode(self, data):
        if data['switched']:
            self.note('Switching to Gaming mode (save your desktop work).')
            steamosctl(self.env, self.account, 'switch-to-game-mode')
        return dict(data)

    def _wait_idle(self, data):
        seconds = STEAM_IDLE_SECONDS
        if not self.env.real and os.environ.get('DOSPLEX_TEST_IDLE_SECONDS'):
            seconds = float(os.environ['DOSPLEX_TEST_IDLE_SECONDS'])
        wait_for(self.idle, seconds, 'normal Gaming mode did not become ready')
        return {}

    def _wait_idle_at_boot(self, data):
        """Wait for the stock Steam to be idle: 'idle', 'desktop' (the device is in Desktop mode) or 'busy' (it never
        became idle in BOOT_IDLE_SECONDS). The device may still be starting its session when this begins."""
        seconds = BOOT_IDLE_SECONDS
        if not self.env.real and os.environ.get('DOSPLEX_TEST_IDLE_SECONDS'):
            seconds = float(os.environ['DOSPLEX_TEST_IDLE_SECONDS'])
        deadline = time.monotonic() + seconds
        while True:
            if self.idle():
                return {'outcome': 'idle'}
            if host_mode(self.env, self.account) == 'desktop':
                return {'outcome': 'desktop'}
            if time.monotonic() > deadline:
                return {'outcome': 'busy'}
            time.sleep(.1 if not self.env.real else 2)

    def _start_trial(self, data):
        ensure_controller_directory(self.env)
        trial = self.seeds.module('trial')
        deck = {'native_deck': 'left', 'native_relay': True} if data.get('deck') else {}
        layout = data.get('layout') or 'vertical'
        if 'layout' in inspect.signature(trial.start).parameters:
            deck['layout'] = layout
        elif layout != 'vertical':
            raise DosplexError('this release cannot start with the %s layout' % layout)
        store = self.state.get('game_store')
        if store:
            if 'game_store' in inspect.signature(trial.start).parameters:
                deck['game_store'] = store
            else:
                self.note('This release cannot use the shared game library, so DosPlex starts without it.')
        if test_hooks_marked(self.env):
            marker = self.env.var / TEST_HOOKS_MARKER
            if 'test_hooks' in inspect.signature(trial.start).parameters:
                deck['test_hooks'] = True
                self.note('Test hooks are on for this session (engineering only): %s exists. Remove that file for '
                          'a normal start.' % marker)
            else:
                self.note('This release cannot start with test hooks; %s is ignored.' % marker)
        result = trial.start(self.release, self.state['manifest_sha256'], 120, self.state['main_user'],
                             GUEST_USER, device_view=True, keep_session=True, **deck)
        root = self.check_root(result['root'])
        return {'root': str(root)}

    def _controllers(self, data):
        """Main's and Guest's slots, then every other slot of their receiver(s) as Unassigned. The retained
        trial journals each one before it starts, so a failure here is rolled back with the first two."""
        slots = [Path(data[role]) if data[role] else None for role in ('main', 'guest')]
        # No slot at all is fine: the bootstrap then enrolls every slot of every receiver that is plugged in.
        result = self.seeds.module('external').run(self.check_root(data['trial']), *slots,
                                                   **({'builtin_deck': True} if data.get('deck') else {}))
        unassigned = result.get('unassigned') if isinstance(result, dict) else None
        if not unassigned:
            return {}
        self.note("Controller slots of the receiver: %s. The first controller that wakes is Main's, the next is the "
                  "second player's while they have none; Devices in the menu changes it." % ', '.join(unassigned))
        return {'unassigned': unassigned}

    MUTATING = ('recover-ended-session', 'forget-stale-trial', 'restore-stale-display', 'host-mode', 'idle-steam',
                'trial', 'controllers', 'display-mode', 'running')

    def _abort_start(self, tx, error, keep):
        # A command that timed out reaches the person as a plain sentence (see plain_error), never as its command line.
        if keep or not any(step in self.MUTATING for step in tx.steps()):
            tx.end('failed', error=plain_error(error))
            if keep:
                tx.note('Start failed (%s). The partly started session is kept for inspection; run: sudo dosplex '
                        'stop' % plain_error(error))
            return
        tx.note('Start failed (%s). Returning to stock Steam.' % plain_error(error))
        try:
            self.rollback_start(tx)
        except BaseException as undo_error:
            message = ('start failed (%s) and the device could not be returned to stock Steam (%s). '
                       'Run: sudo dosplex repair' % (plain_error(error), undo_error))
            tx.error(message)
            raise DosplexError(message) from error
        tx.end('rolled-back', error=plain_error(error))

    def rollback_start(self, tx):
        steps = tx.steps()
        root = None
        trial = steps.get('trial')
        if trial and trial['status'] == 'done':
            root = trial['result']['root']
        elif trial:
            created = [str(p) for p in trial_roots(self.env) if str(p) not in trial['data'].get('before', [])]
            if len(created) > 1:
                raise DosplexError('several new trial directories exist (%s); not guessing which to recover'
                                  % ', '.join(created))
            root = created[0] if created else None
        earlier = steps.get('recover-ended-session')
        if root is None and earlier and earlier['status'] in ('intent', 'done') and earlier['data'].get('root'):
            root = earlier['data']['root']       # a recovery of the ended session that was cut short: finish it
        host = steps.get('host-mode')
        host = host['data'] if host and host['status'] in ('intent', 'done') else None
        if tx.status('rollback-session') == 'absent':
            tx.run('rollback-session', {'root': root, 'host': host}, lambda d: self.stop_logic(d['root'], d['host']))
        elif tx.status('rollback-session') == 'intent':
            tx.redo('rollback-session', lambda d: self.stop_logic(d['root'], d['host']))

    # --- stop ----------------------------------------------------------------------------------
    def stop_logic(self, root, host):
        """Recover the trial, restore the display mode and the session mode. Idempotent."""
        env = self.env
        recovered = False
        if root:
            root = self.check_root(root)
            if lexists(root):
                script = root / 'root-session-trial.py'
                for path in (root, script):
                    info = os.lstat(path)
                    if stat.S_ISLNK(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o022:
                        raise DosplexError('refusing to recover %s: %s is not root-owned and closed' % (root, path))
                self.close_sides(root)
                env.run([env.python, str(script), 'recover', '--root', str(root)], timeout=300)
                recovered = True
        env.fault('stop:inner:recovered')
        display = Display(env, self.account).restore()
        env.fault('stop:inner:display-restored')
        switched = False
        if host and host.get('switched') and host.get('original') == 'desktop' and host.get('desktop_session'):
            defaults = (self.state.get('defaults') or {})
            for verb, key in (('get-default-login-mode', 'login_mode'), ('get-default-desktop-session', 'desktop_session')):
                try:
                    now = steamosctl(env, self.account, verb)
                except DosplexError:
                    continue
                if defaults.get(key) and now != defaults[key]:
                    self.note('The SteamOS default %s changed since install (%s); left as it is.' % (key, now))
            steamosctl(env, self.account, 'switch-to-desktop-mode', host['desktop_session'])
            switched = True
        if self.state.get('trial'):
            self.save_state(trial=None)
        return {'recovered': recovered, 'display': display, 'returned_to_desktop': switched}

    def close_sides(self, root):
        """Before the session is taken down: ask each side's Steam to quit and wait for it, as Turn off DosPlex
        does (TRL-04). A Steam that is killed has not uploaded the saves of the game that just closed. The
        session's own helper does it; a session without one, or with one that fails, is stopped as before."""
        env = self.env
        helper = root / 'bundle' / 'libexec' / 'dosplex-power-action'
        try:
            for path in (root / 'bundle', helper.parent, helper):
                info = os.lstat(path)
                if stat.S_ISLNK(info.st_mode) or info.st_uid != env.trusted_uid or info.st_mode & 0o022:
                    return
        except OSError:
            return
        # The screen says what is going on while the sides close: without it both halves only waited for a Steam that
        # was being closed (a first tester took an uninstall for hung and switched the machine off). A compositor
        # that does not know the request, or does not answer, changes nothing here.
        try:
            compositor_request(env, root, bytes([1, 4, 1, 0]))
        except (DosplexError, OSError):
            pass
        try:
            done = env.run([env.python, str(helper), 'close', '--trial-root', str(root)], check=False, timeout=260)
            # What the helper says of each side (asked, quit after N s, did not quit) goes where this operation's
            # own lines go: the journal of its unit. It names no game and nothing a person wrote.
            sys.stderr.write(done.stderr[-4000:])
            sys.stderr.flush()
        except DosplexError as error:
            self.note('Steam was not asked to quit first (%s); the session is stopped as it is.' % plain_error(error))

    def stop(self):
        root = self.trial_alive()
        stale = self.state.get('trial')
        leftover = Display(self.env, self.account).record()
        leftover = bool(leftover and leftover.get('phase') not in (None, 'restored'))
        if root is None and not stale and not leftover:
            say('DosPlex is not running.')
            return 0
        tx = self.tx = self.journal.begin('stop', root=str(root) if root else None)
        try:
            session = self.state.get('session') or {}
            result = tx.run('stop-session', {'root': str(root) if root else None, 'host': session},
                            lambda d: self.stop_logic(d['root'], d['host']))
        except BaseException as error:
            tx.end('failed', error=str(error))
            raise
        tx.note('DosPlex stopped; Steam is back to normal%s.'
                % (' (Desktop mode restored)' if result.get('returned_to_desktop') else ''))
        tx.end('complete')
        return 0


# ---------------------------------------------------------------------------------------------------
# Start at boot: `dosplex autostart on|off|status`. One unit runs `dosplex start --boot` once the display manager
# is up: Main alone on the full screen, no controller needed. A boot start that cannot run leaves stock Steam as
# it is. The unit is written and removed like the shared game library's (journaled, a file or link that is not
# DosPlex's is refused, never started when it is turned on); the state key `autostart` says it is on.
# ---------------------------------------------------------------------------------------------------

AUTOSTART_UNIT = 'dosplex-autostart.service'
AUTOSTART_UNIT_DIR = '/etc/systemd/system'
AUTOSTART_WANTS_DIR = AUTOSTART_UNIT_DIR + '/graphical.target.wants'
AUTOSTART_PROGRAM = '/opt/dosplex/bin/dosplex'
AUTOSTART_UNIT_TEXT = '''[Unit]
Description=DosPlex at boot
After=display-manager.service
ConditionPathExists=%(program)s

[Service]
Type=oneshot
ExecStart=%(program)s start --boot
TimeoutStartSec=600

[Install]
WantedBy=graphical.target
''' % {'program': AUTOSTART_PROGRAM}
AUTOSTART_LINK_TARGET = '../' + AUTOSTART_UNIT


def autostart_paths(env):
    """The unit file, its enable link and the directory of the link."""
    unit_dir, wants = env.path(AUTOSTART_UNIT_DIR), env.path(AUTOSTART_WANTS_DIR)
    return unit_dir / AUTOSTART_UNIT, wants / AUTOSTART_UNIT, wants


def autostart_writable(env):
    paths = autostart_paths(env)
    for path in paths:
        env.allow_write(path)
    return paths


def autostart_facts(env):
    """What of the boot unit is on disk, and whether a file or link there is not the one DosPlex writes."""
    unit, link, wants = autostart_paths(env)
    facts = {'text': AUTOSTART_UNIT_TEXT, 'unit_existed': lexists(unit), 'link_existed': lexists(link),
             'wants_existed': lexists(wants), 'foreign': None}
    if facts['unit_existed'] and (os.path.islink(unit) or not unit.is_file()
                                  or not written_by_dosplex(unit.read_text(), AUTOSTART_UNIT_TEXT)):
        facts['foreign'] = '%s is already there and is not the one DosPlex writes; look at it first' % (
            AUTOSTART_UNIT_DIR + '/' + AUTOSTART_UNIT)
    elif facts['link_existed'] and (not os.path.islink(link) or os.readlink(link) != AUTOSTART_LINK_TARGET):
        facts['foreign'] = '%s is already there and is not the link DosPlex makes; look at it first' % (
            AUTOSTART_WANTS_DIR + '/' + AUTOSTART_UNIT)
    return facts


def apply_autostart_unit(env, tx, data):
    unit, link, wants = autostart_writable(env)
    env.ensure_dir(wants)
    env.write_file(unit, data['text'].encode(), 0o644)
    env.replace_symlink(link, AUTOSTART_LINK_TARGET)
    library_reload(env)
    return {}


def undo_autostart_unit(env, tx, data, result):
    unit, link, wants = autostart_writable(env)
    if not data['link_existed']:
        env.unlink(link)
    if not data['unit_existed']:
        env.unlink(unit)
    if not data['wants_existed']:
        env.rmdir_if_empty(wants)
    library_reload(env, check=False)
    return {}


def apply_autostart_unit_remove(env, tx, data):
    unit, link, wants = autostart_writable(env)
    env.unlink(link)
    env.unlink(unit)
    env.rmdir_if_empty(wants)     # an empty directory is nothing to keep; systemd makes it again
    library_reload(env)
    return {}


def undo_autostart_unit_remove(env, tx, data, result):
    unit, link, wants = autostart_writable(env)
    if data['unit_existed']:
        env.write_file(unit, data['text'].encode(), 0o644)
    if data['link_existed']:
        env.ensure_dir(wants)
        env.replace_symlink(link, AUTOSTART_LINK_TARGET)
    library_reload(env, check=False)
    return {}


def apply_autostart_state(env, tx, data):
    state = dict(data['previous_state'])
    if data['on']:
        state['autostart'] = True
    else:
        state.pop('autostart', None)
    write_state(env, state)
    return {}


def apply_remove_autostart(env, tx, data):
    """Uninstall: take the boot unit and its link away when they are DosPlex's. Idempotent; a file that is not
    DosPlex's stays where it is."""
    unit, link, wants = autostart_writable(env)
    removed = False
    if os.path.islink(link) and os.readlink(link) == AUTOSTART_LINK_TARGET:
        removed = env.unlink(link) or removed
        env.rmdir_if_empty(wants)
    if lexists(unit) and not os.path.islink(unit) and unit.is_file() and \
            written_by_dosplex(unit.read_text(), AUTOSTART_UNIT_TEXT):
        removed = env.unlink(unit) or removed
    if removed:
        library_reload(env, check=False)
    return {'removed': removed}


AUTOSTART_APPLY = {'unit': apply_autostart_unit, 'unit-remove': apply_autostart_unit_remove,
                   'state': apply_autostart_state}
AUTOSTART_UNDO = {'unit': undo_autostart_unit, 'unit-remove': undo_autostart_unit_remove, 'state': undo_state}


def repair_autostart(env, journal, tx):
    """An interrupted `autostart on` or `off`: finish it once its commit record is on disk, else undo it."""
    if tx.committed:
        tx.append('repair', action='roll-forward')
        try:
            complete_plan(env, tx, AUTOSTART_APPLY)
            tx.note('The change of the start at boot was completed.')
            tx.end('complete', repaired=True)
            return
        except BaseException as error:
            tx.note('The change of the start at boot could not be completed (%s); rolling it back.' % error)
    else:
        tx.append('repair', action='rollback')
    rollback(env, tx, AUTOSTART_UNDO)
    tx.note('The change of the start at boot was rolled back; the device is as it was before.')
    tx.end('rolled-back', repaired=True)


def autostart_change(env, journal, state, wanted, action):
    """Write or remove the boot unit and the state key as one journaled operation."""
    facts = autostart_facts(env)
    tx = journal.begin('autostart', action=action)
    plan = [{'step': 'unit' if wanted else 'unit-remove', 'data': facts},
            {'step': 'state', 'data': {'previous_state': state, 'on': wanted}}]
    try:
        tx.commit(plan)
        complete_plan(env, tx, AUTOSTART_APPLY)
        tx.end('complete')
    except BaseException as error:
        abort(env, tx, AUTOSTART_UNDO, error, 'autostart ' + action)
        raise


def cmd_autostart(env, args):
    """`autostart on|off|status`. Turning it on never starts the unit: DosPlex starts at the next boot."""
    if args.mode == 'status':
        state = library_state(env)
        say('Starts at boot: %s' % ('yes' if state.get('autostart') else 'no'))
        return 0
    env.require_root()
    wanted = args.mode == 'on'
    journal = Journal.open(env, lock=True)
    if journal is None:
        raise NotInstalled('DosPlex is not installed. Run: sudo dosplex install BUNDLE --manifest SHA256')
    with journal:
        journal.require_clean()
        state = library_state(env)
        facts = autostart_facts(env)
        present = facts['unit_existed'] and facts['link_existed'] and not facts['foreign']
        if facts['foreign'] and (wanted or state.get('autostart')):
            raise RefusedError(facts['foreign'])
        if wanted == bool(state.get('autostart')) and (wanted == present or facts['foreign']):
            say('DosPlex already %s at boot.' % ('starts' if wanted else 'does not start'))
            return 0
        if wanted and not state.get('autostart') and not getattr(args, 'experimental', False):
            # ADR-026: the first release starts only when asked. Starting at boot stays in the program, off, and is
            # turned on knowingly. An installation that already has it on keeps it.
            raise RefusedError('starting at boot is experimental in this release and is off unless you ask for it. '
                               'To turn it on: sudo dosplex autostart on --experimental')
        autostart_change(env, journal, state, wanted, args.mode)
    if wanted:
        say('DosPlex starts at every boot from now on, with Main alone on the full screen and no controller needed.')
        say('If it cannot start, the device stays on stock Steam. Turn it off with: sudo dosplex autostart off')
    else:
        say('DosPlex no longer starts at boot. Start it by hand with: sudo dosplex start')
    return 0


def ensure_autostart_unit(env):
    """After an install or an update: when the start at boot is on, make sure its unit is there. A problem is said,
    never fatal."""
    try:
        journal = Journal.open(env, lock=True)
        if journal is None:
            return
        with journal:
            journal.require_clean()
            state = read_state(env)
            if not state or not state.get('autostart'):
                return
            facts = autostart_facts(env)
            if facts['foreign']:
                say('The start at boot could not be kept: %s.' % facts['foreign'])
                return
            if facts['unit_existed'] and facts['link_existed']:
                return
            autostart_change(env, journal, state, True, 'units')
        say('The unit that starts DosPlex at boot was written again.')
    except DosplexError as error:
        say('The start at boot could not be set up: %s. Try: sudo dosplex autostart on --experimental' % error)


# ---------------------------------------------------------------------------------------------------
# The entry in Steam's library, and the service behind it (ADR-026)
#
# The first release starts only when asked, and the person asking holds a controller. So the installer leaves an
# application entry "DosPlex" in the main user's applications (the installer asks Steam to add it to the library;
# by hand it is "Add a Non-Steam Game"), and behind it a socket unit that systemd listens on for the main user alone. The service it starts accepts one
# request, "start", and runs `dosplex control start`. Nothing of this runs until the entry is used.
ENTRY_WANTS_DIR = AUTOSTART_UNIT_DIR + '/sockets.target.wants'
ENTRY_LINK_TARGET = '../' + ENTRY_SOCKET
ENTRY_LIBEXEC = '/opt/dosplex/current/libexec'
ENTRY_DESKTOP = '.local/share/applications/dosplex.desktop'
ENTRY_SOCKET_TEXT = """[Unit]
Description=DosPlex: the socket Steam's library entry asks to start DosPlex

[Socket]
ListenStream=/run/dosplex-start.sock
SocketUser=%(user)s
SocketMode=0600
Accept=no

[Install]
WantedBy=sockets.target
"""
ENTRY_SERVICE_TEXT = """[Unit]
Description=DosPlex: start on request from the main player's account
ConditionPathExists=%(libexec)s/dosplex-start-service.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 %(libexec)s/dosplex-start-service.py --config %(config)s
# Not hardened further on purpose: "dosplex control start" starts a unit of its own through systemd-run.
ProtectHome=read-only
PrivateTmp=yes
"""
ENTRY_DESKTOP_TEXT = """[Desktop Entry]
Type=Application
Name=DosPlex
Comment=Two players, one screen
Exec=/usr/bin/python3 %(libexec)s/dosplex-start-client.py
Icon=/opt/dosplex/current/share/dosplex/icons/dosplex.png
Terminal=false
Categories=Game;
"""
# The application entry exactly as 0.1.0-alpha.5 wrote it: the name spelled "Dosplex", a stock icon. It is still
# dosplex's own on a device that updates from that release.
ENTRY_DESKTOP_TEXT_ALPHA_5 = """[Desktop Entry]
Type=Application
Name=Dosplex
Comment=Two players, one screen
Exec=/usr/bin/python3 %(libexec)s/dosplex-start-client.py
Icon=input-gaming
Terminal=false
Categories=Game;
"""
ENTRY_LAUNCHER = 'Desktop/DosPlex.desktop'      # the same entry on the main user's desktop, when there is one


def entry_files(env, state):
    """Everything the entry consists of, for this installation: path -> text for the files root writes, the link,
    and the desktop entry with the account it belongs to. None when the main user is not an account here."""
    account = user_entry(env, state.get('main_user') or '')
    if account is None:
        return None
    units, wants = env.path(AUTOSTART_UNIT_DIR), env.path(ENTRY_WANTS_DIR)
    config = json.dumps({'uid': account.uid, 'program': AUTOSTART_PROGRAM}, sort_keys=True) + '\n'
    names = {'libexec': ENTRY_LIBEXEC, 'config': '/var/lib/dosplex/start-service.json', 'user': account.name}
    return {'account': account, 'wants': wants, 'link': wants / ENTRY_SOCKET,
            'root': {units / ENTRY_SOCKET: ENTRY_SOCKET_TEXT % names, units / ENTRY_SERVICE: ENTRY_SERVICE_TEXT % names,
                     env.var / 'start-service.json': config},
            'desktop': ENTRY_DESKTOP_TEXT % names,
            'desktop_ours': [ENTRY_DESKTOP_TEXT % names, earlier_name(ENTRY_DESKTOP_TEXT % names),
                             ENTRY_DESKTOP_TEXT_ALPHA_5 % names]}


def launcher_current(env, files):
    """Whether the launcher on the main user's desktop needs nothing: there is no ~/Desktop folder, or the file there
    is this release's text and executable, or it is somebody else's (a link or a file that is not dosplex's is left
    alone, and does not keep the entry from being "present")."""
    home = env.path(files['account'].home)
    folder, path = home / 'Desktop', home / ENTRY_LAUNCHER
    if not folder.is_dir() or folder.is_symlink() or os.path.islink(path):
        return True
    if not lexists(path):
        return False
    try:
        if not path.is_file():
            return True
        found = path.read_bytes()
        if found not in [text.encode() for text in files['desktop_ours']]:
            return True
        return found == files['desktop'].encode() and bool(path.stat().st_mode & 0o111)
    except OSError:
        return True


def entry_facts(env, state):
    """What of the entry is on disk: 'present' (all of it, as dosplex writes it), 'foreign' (a file or link there
    that is not dosplex's, named), and which root files existed, for an undo."""
    files = entry_files(env, state)
    if files is None:
        return {'present': False, 'foreign': 'the main user %r is not an account on this device' % state.get('main_user'),
                'existed': []}
    existed, foreign, same = [], None, True
    for path, text in files['root'].items():
        if lexists(path):
            existed.append(str(path))
            found = None if os.path.islink(path) or not path.is_file() else path.read_text()
            if found != text:
                same = False    # (a unit as an earlier release wrote it is DosPlex's, and is written again)
                # the config is rewritten freely; a unit file is not
                if path.name != 'start-service.json' and (found is None or not written_by_dosplex(found, text)):
                    foreign = foreign or '%s is already there and is not the one DosPlex writes; look at it first' % path
        else:
            same = False
    link = files['link']
    if lexists(link):
        if not os.path.islink(link) or os.readlink(link) != ENTRY_LINK_TARGET:
            foreign = foreign or '%s is already there and is not the link DosPlex makes; look at it first' % link
    else:
        same = False
    desktop = env.path(files['account'].home) / ENTRY_DESKTOP
    try:
        desktop_same = desktop.is_file() and not desktop.is_symlink() and desktop.read_text() == files['desktop']
    except OSError:
        desktop_same = False
    desktop_same = desktop_same and launcher_current(env, files)
    return {'present': same and desktop_same and not foreign, 'foreign': foreign, 'existed': existed,
            'wants_existed': lexists(files['wants']), 'link_existed': lexists(link)}


def entry_desktop(env, files, action):
    """Write or remove the desktop entry as the main user, in that user's own folder."""
    account = files['account']
    home = env.path(account.home)
    argv = [env.python, '-c', USER_ENTRY_SCRIPT, str(home), action]
    if env.real:
        argv = ['runuser', '-u', account.name, '--'] + argv
    env.run(argv, input=json.dumps(files['desktop_ours']).encode(), timeout=20)


def apply_entry(env, tx, data):
    files = entry_files(env, read_state(env) or data['state'])
    if files is None:
        raise DosplexError('the main user is not an account on this device')
    for path in list(files['root']) + [files['wants'], files['link']]:
        env.allow_write(path)
    env.ensure_dir(files['wants'])
    for path, text in files['root'].items():
        env.write_file(path, text.encode(), 0o644)
    env.replace_symlink(files['link'], ENTRY_LINK_TARGET)
    library_reload(env)
    env.run(['systemctl', 'start', ENTRY_SOCKET], check=False, timeout=30)
    entry_desktop(env, files, 'write')
    return {}


def remove_entry_files(env, state, only=None):
    """Take the entry away: stop the socket and the service, remove the link, the units, the config and the desktop
    entry, each only when it is the one dosplex writes. `only` limits the root files to those paths (an undo)."""
    files = entry_files(env, state)
    if files is None:
        return False
    desktop = env.path(files['account'].home) / ENTRY_DESKTOP
    if not (lexists(files['link']) or lexists(desktop) or lexists(env.path(files['account'].home) / ENTRY_LAUNCHER)
            or any(lexists(path) for path in files['root'])):
        return False            # never set up, or gone already: nothing to stop and nothing to reload
    removed = False
    for unit in (ENTRY_SOCKET, ENTRY_SERVICE):
        env.run(['systemctl', 'stop', unit], check=False, timeout=30)
    for path in list(files['root']) + [files['wants'], files['link']]:
        env.allow_write(path)
    link = files['link']
    if os.path.islink(link) and os.readlink(link) == ENTRY_LINK_TARGET and (only is None or str(link) in only):
        removed = env.unlink(link) or removed
        env.rmdir_if_empty(files['wants'])
    for path, text in files['root'].items():
        if only is not None and str(path) not in only:
            continue
        ours = lexists(path) and not os.path.islink(path) and path.is_file() and (
            path.name == 'start-service.json' or written_by_dosplex(path.read_text(), text))
        if ours:
            removed = env.unlink(path) or removed
    try:
        entry_desktop(env, files, 'remove')
    except DosplexError:
        pass                    # the user's own folder: what cannot be removed there stays, and says nothing is wrong
    library_reload(env, check=False)
    return removed


def undo_entry(env, tx, data, result):
    state = data['state']
    files = entry_files(env, state)
    if files is None:
        return {}
    written = [str(p) for p in files['root'] if str(p) not in data['existed']]
    if not data.get('link_existed'):
        written.append(str(files['link']))
    remove_entry_files(env, state, only=written)
    return {}


def apply_entry_remove(env, tx, data):
    return {'removed': remove_entry_files(env, data['state'])}


def apply_entry_state(env, tx, data):
    state = dict(data['previous_state'])
    state['entry'] = bool(data['on'])
    write_state(env, state)
    return {}


def apply_remove_entry(env, tx, data):
    """Uninstall: the entry goes with everything else. Idempotent."""
    state = read_state(env)
    return {'removed': remove_entry_files(env, state) if state else False}


ENTRY_APPLY = {'entry': apply_entry, 'entry-remove': apply_entry_remove, 'state': apply_entry_state}
ENTRY_UNDO = {'entry': undo_entry, 'entry-remove': lambda env, tx, data, result: {}, 'state': undo_state}


def repair_entry(env, journal, tx):
    """An interrupted change of the library entry: finish it once its commit record is on disk, else undo it."""
    if tx.committed:
        tx.append('repair', action='roll-forward')
        try:
            complete_plan(env, tx, ENTRY_APPLY)
            tx.note('The change of the entry in Steam\'s library was completed.')
            tx.end('complete', repaired=True)
            return
        except BaseException as error:
            tx.note('The change of the entry in Steam\'s library could not be completed (%s); rolling it back.' % error)
    else:
        tx.append('repair', action='rollback')
    rollback(env, tx, ENTRY_UNDO)
    tx.note('The change of the entry in Steam\'s library was rolled back; the device is as it was before.')
    tx.end('rolled-back', repaired=True)


def entry_change(env, journal, state, wanted, action):
    """Write or remove the entry and the state key as one journaled operation."""
    facts = entry_facts(env, state)
    tx = journal.begin('entry', action=action)
    plan = [{'step': 'entry' if wanted else 'entry-remove', 'data': dict(facts, state=state)},
            {'step': 'state', 'data': {'previous_state': state, 'on': wanted}}]
    try:
        tx.commit(plan)
        complete_plan(env, tx, ENTRY_APPLY)
        tx.end('complete')
    except BaseException as error:
        abort(env, tx, ENTRY_UNDO, error, 'entry ' + action)
        raise


STEAM_CLIENT_NAME = b'dosplex-start-client.py'
STEAM_SHORTCUTS_MAX = 8 * 1024 * 1024
STEAM_ADD_SECONDS = 20          # how long steamos-add-to-steam may take; it only hands the address to Steam
STEAM_CONFIRM_SECONDS = 6.0     # how long after it returned Steam may take to write the shortcut
STEAM_RETRY = 'sudo /opt/dosplex/bin/dosplex entry on'


def steam_library_has_dosplex(env, account):
    """Whether any Steam account of the main user lists DosPlex as a non-Steam game: shortcuts.vdf is binary, and
    the start client's file name is in it when the entry was added. What cannot be read counts as "no"."""
    userdata = env.path(account.home) / '.local/share/Steam/userdata'
    try:
        folders = sorted(userdata.glob('*/config'))
    except OSError:
        return False
    for folder in folders:
        path = folder / 'shortcuts.vdf'
        try:
            if folder.is_symlink() or folder.parent.is_symlink() or not stat.S_ISREG(os.lstat(path).st_mode):
                continue
            fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            with os.fdopen(fd, 'rb') as stream:
                if STEAM_CLIENT_NAME in stream.read(STEAM_SHORTCUTS_MAX):
                    return True
        except OSError:
            continue
    return False


def add_to_steam_library(env, account, state):
    """Best effort, never fatal: ask Steam to add the entry to the main user's library. Returns (result, reason):
    'already', 'added', 'not confirmed' or 'not possible', and a short clause for the last two."""
    if steam_library_has_dosplex(env, account):
        return 'already', None
    if not env.which(STEAM_ADD_TOOL):
        return 'not possible', 'this system has no %s' % STEAM_ADD_TOOL
    if not any(comm == 'steam' for _, comm, _ in processes(env, account.uid)):
        return 'not possible', 'Steam is not running'
    try:
        if trial_status(env, state)['alive']:
            return 'not possible', 'DosPlex is running'
    except DosplexError:
        return 'not possible', 'DosPlex may be running'
    entry = env.path(account.home) / ENTRY_DESKTOP
    seconds, wait = STEAM_ADD_SECONDS, STEAM_CONFIRM_SECONDS
    if not env.real and os.environ.get('DOSPLEX_TEST_STEAM_SECONDS'):
        seconds = wait = float(os.environ['DOSPLEX_TEST_STEAM_SECONDS'])
    # The tool runs `steam steam://addnonsteamgame/...`, which needs the user's runtime folder and display.
    argv = user_command(account, 'DISPLAY=:0', STEAM_ADD_TOOL, str(entry))
    try:
        env.run(argv, timeout=seconds)
    except DosplexError as error:
        return 'not confirmed', '%s did not finish: %s' % (STEAM_ADD_TOOL, str(error).splitlines()[0][:80])
    deadline = time.monotonic() + wait
    while True:
        if steam_library_has_dosplex(env, account):
            return 'added', None
        if time.monotonic() >= deadline:
            return 'not confirmed', 'Steam did not list it in time'
        time.sleep(0.5)


def say_steam_library(result, reason, tail=''):
    if result in ('added', 'already'):
        say('DosPlex is in Steam\'s library: Library, Non-Steam, DosPlex.')
    else:
        say('DosPlex could not be added to Steam\'s library by itself (%s). In Desktop mode, add "DosPlex" to Steam '
            'once ("Add a Non-Steam Game"), or run: %s%s' % (reason, STEAM_RETRY, tail))


def try_steam_library(env, state, tail=''):
    """After the entry is set up: add it to Steam's library and say how that went. Never raises."""
    try:
        account = user_entry(env, state.get('main_user') or '')
        if account is None:
            return
        say_steam_library(*add_to_steam_library(env, account, state), tail=tail)
    except (DosplexError, OSError) as error:
        say_steam_library('not possible', str(error), tail=tail)


def entry_status_text(env, state, facts):
    """The words after "Start from Steam's library:" in `status` and `entry status`."""
    if not facts['present']:
        return 'off' if state.get('entry') is False else 'not set up'
    account = user_entry(env, state.get('main_user') or '')
    if account is not None and steam_library_has_dosplex(env, account):
        return 'ready, in Steam\'s library'
    return 'ready, not yet added to Steam\'s library (sudo dosplex entry on adds it)'


def ensure_entry(env):
    """After an install or an update: unless it was turned off, make sure the entry and its service are there and are
    this release's. A problem is said, never fatal: `dosplex start` in a terminal always works."""
    try:
        journal = Journal.open(env, lock=True)
        if journal is None:
            return
        with journal:
            journal.require_clean()
            state = read_state(env)
            if not state or state.get('entry') is False:
                return
            if not env.real and os.environ.get('DOSPLEX_TEST_ENTRY') != '1':
                return          # a test asks for the entry by name; the others keep the journals they count
            facts = entry_facts(env, state)
            if facts['foreign']:
                say('The entry for Steam\'s library was not set up: %s.' % facts['foreign'])
                return
            if not (facts['present'] and state.get('entry')):
                entry_change(env, journal, state, True, 'units')
        # Outside the journal's lock: Steam may take a while to answer.
        try_steam_library(env, state, tail='\nUntil then: sudo dosplex start')
    except DosplexError as error:
        say('The entry for Steam\'s library could not be set up: %s. DosPlex still starts with: sudo dosplex start'
            % error)


def cmd_entry(env, args):
    """`entry on|off|status`: the entry in Steam's library and the service behind it."""
    if args.mode == 'status':
        state = library_state(env)
        facts = entry_facts(env, state)
        say('Start from Steam\'s library: %s' % entry_status_text(env, state, facts))
        return 0
    env.require_root()
    wanted = args.mode == 'on'
    journal = Journal.open(env, lock=True)
    if journal is None:
        raise NotInstalled('DosPlex is not installed. Run: sudo dosplex install BUNDLE --manifest SHA256')
    with journal:
        journal.require_clean()
        state = library_state(env)
        facts = entry_facts(env, state)
        if wanted and facts['foreign']:
            raise RefusedError(facts['foreign'])
        if wanted and facts['present'] and state.get('entry'):
            say('The entry for Steam\'s library is already set up.')
        else:
            entry_change(env, journal, state, wanted, args.mode)
            if wanted:
                say('Set up.')
    if wanted:
        try_steam_library(env, state)
    else:
        say('The entry and its service were removed. If you added "DosPlex" to Steam, remove it there yourself. '
            'Start DosPlex with: sudo dosplex start')
    return 0


