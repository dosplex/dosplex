class DosplexError(Exception):
    exit_code = 1
    error_code = 'failed'           # the stable code `dosplex control` reports for this kind of failure


class UsageError(DosplexError):
    exit_code = 2
    error_code = 'bad-request'


class RefusedError(DosplexError):
    """The version gate or another preflight rule refused to continue."""
    exit_code = 3
    error_code = 'refused'


class NeedsRepair(DosplexError):
    exit_code = 4
    error_code = 'interrupted'


class PolicyError(DosplexError):
    """A rule of the install layout would be broken (ADR-005): refused before anything happens."""
    error_code = 'refused'


class BusyError(DosplexError):
    """Another dosplex operation holds the journal."""
    error_code = 'busy'


