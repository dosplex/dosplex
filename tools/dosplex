            'update': cmd_update, 'rollback': cmd_rollback, 'repair': cmd_repair, 'uninstall': cmd_uninstall, 'version': cmd_version, 'preflight': cmd_preflight,
            'library': cmd_library, 'autostart': cmd_autostart, 'entry': cmd_entry, '_worker': cmd_worker, '_control_op': cmd_control_op}


def split_control(argv):
    """(sysroot, words) when argv is `[--sysroot DIR] control WORDS...`, else None. The control interface parses
    its own words, so that every mistake is answered in JSON and not with usage text."""
    sysroot, rest = '/', list(argv)
    if rest[:1] == ['--sysroot'] and len(rest) >= 2:
        sysroot, rest = rest[1], rest[2:]
    elif rest[:1] and rest[0].startswith('--sysroot='):
        sysroot, rest = rest[0].split('=', 1)[1], rest[1:]
    return (sysroot, rest[1:]) if rest[:1] == ['control'] else None


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    controlled = split_control(argv)
    if controlled is not None:
        return run_control(*controlled)
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 2
    try:
        env = Env(args.sysroot)
        os.umask(0o022)
        installed = env.opt / 'bin' / 'dosplex'
        argv0 = sys.argv[0] if sys.argv and sys.argv[0] else 'dosplex'
        PROGRAM['name'] = str(installed) if installed.is_file() else (argv0 if os.sep in argv0 else 'python3 ' + argv0)
        return COMMANDS[args.command](env, args) or 0
    except DosplexError as error:
        print('dosplex: %s' % hint(str(error)), file=sys.stderr)
        return error.exit_code
    except KeyboardInterrupt:
        print('dosplex: interrupted', file=sys.stderr)
        return 130
    except Exception as error:
        if os.environ.get('DOSPLEX_DEBUG') == '1':
            raise
        if isinstance(error, subprocess.TimeoutExpired):
            print('dosplex: %s' % hint(plain_error(error)), file=sys.stderr)
        else:
            print('dosplex: unexpected %s: %s (set DOSPLEX_DEBUG=1 for details)' % (type(error).__name__, hint(str(error))),
                  file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
