# Releases up to 0.1.0-alpha.5 spelled the name "Dosplex". What they put on a device (units, the udev rule, the
# application entry) is still DosPlex's own: it is recognised as that, and replaced or removed like this release's.
def earlier_name(text):
    """`text` (str or bytes) as a release that spelled the name "Dosplex" wrote it."""
    return text.replace(b'DosPlex', b'Dosplex') if isinstance(text, bytes) else text.replace('DosPlex', 'Dosplex')


def written_by_dosplex(found, text):
    """Whether `found`, read from a device, is `text` as this release or an earlier one wrote it."""
    return found == text or found == earlier_name(text)


