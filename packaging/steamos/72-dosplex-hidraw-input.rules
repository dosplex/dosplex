# Dosplex owns the built-in Steam Deck controller while its compositor is active.
# If the deck user's Steam process can open Valve hidraw directly, it bypasses
# Dosplex routing and the primary Steam session can receive hover while ignoring
# routed clicks. Keep the hardware interface root-only; routed virtual devices
# below are what side sessions should consume.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1205", TAG-="uaccess", GROUP="root", MODE="0600", RUN+="/usr/bin/setfacl -b /dev/%k"

# External gamepads default to the main user. Dosplex changes ownership when
# the overlay assigns the controller to Guest, and revokes existing opens so
# only the selected side can consume it.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", TAG-="uaccess", GROUP="deck", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", RUN+="/usr/bin/setfacl -b /dev/%k"
SUBSYSTEM=="hidraw", ENV{HID_NAME}=="*Controller*", TAG-="uaccess", GROUP="deck", MODE="0660"
SUBSYSTEM=="hidraw", ENV{HID_NAME}=="*Gamepad*", TAG-="uaccess", GROUP="deck", MODE="0660"

# Re-apply after the generic Controller/Gamepad defaults above so the built-in
# Valve interface never lands back in the deck group.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1205", TAG-="uaccess", GROUP="root", MODE="0600", RUN+="/usr/bin/setfacl -b /dev/%k"

# Steam Input game-facing virtual Xbox pads are created by the selected Steam
# session through /dev/uinput. They are not physical controllers to arbitrate;
# keep them on input so deck/guest game containers can open the pad Steam made.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="28de", ATTRS{id/product}=="11ff", TAG-="uaccess", GROUP="input", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="28de", ATTRS{id/product}=="11ff", RUN+="/usr/bin/setfacl -b /dev/%k"

# Routed virtual controllers are the devices Steam should consume. Keep them
# owned by the selected Dosplex side even if generic joystick rules run later.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Dosplex routed main*", TAG-="uaccess", GROUP="deck", MODE="0660"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Dosplex routed guest*", TAG-="uaccess", GROUP="guest", MODE="0660"
