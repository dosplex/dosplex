[Unit]
Description=DosPlex External Gamepad Arbiter
Before=dosplex-compositor.service
PartOf=dosplex-compositor.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dosplex-gamepad-arbiter.py
Restart=always
RestartSec=1
Nice=-10
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20
LimitRTPRIO=50

[Install]
WantedBy=dosplex-compositor.service
