[Unit]
Description=DosPlex Audio Router
After=multi-user.target
Wants=dosplex-compositor.service

[Service]
Type=simple
# Guest's restricted audio endpoint; dosplex-side-supervisor.py points Guest here.
Environment=DOSPLEX_GUEST_AUDIO_DIR=/run/dosplex/audio/guest
ExecStart=/usr/local/bin/dosplex-audio-router.py monitor-shared
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
